	en: { attention: 'The spotlight in a real model', aufgaben: 'How many problems are in one sentence?', basis: 'The same addition in another number base', berechtigung: 'Does it run without a question?', bpe: 'Build your own tokenizer', chatsequence: 'Your chat as a token sequence', chatvorlage: 'The open head at the end of the sequence', datensieb: 'The data sieve, layer by layer', denkschritte: 'Counting thinking steps', denkvergleich: 'The numbers of the Qwen3 report', descent: 'Downhill to the smallest error', dreistellen: 'Three places for one text', embeddingtraining: 'From random numbers to profiles', folgen: 'Several texts, one fixed length', fortsetzung: 'Continue or answer?', hiddenstate: 'Fixed faders, changing meters', klausur: 'Points for guessing and abstaining', learningcurves: 'When does the validation loss start to rise?', lernratenplan: 'Constant or on a schedule?', memory: 'Does the model fit?', modelprobe: 'A model keeps writing', neighbors: 'Neighbors in the real GPT-2', neuron: 'The stair light without a lower limit', outputscore: 'Which row fits the state?', probedrehen: 'Probing or one backward pass', pruefampel: 'Which light, which check?', qkv: 'Query meets key: attention you can check by hand', rueckweg: 'The backward pass through the stair light', sampling: 'Scores, percentages, draw', satzloss: 'Which token costs the most?', schleife: 'Who writes, who runs it?', schreibtisch: 'Where does the answer come from?', shape: 'From one weather value to a stack of numbers', softmax: 'Spin the prize wheel', spamneuron: 'A neuron computes a number', strafpunkte: 'Penalty points for a segment', textloop: 'The text loop, round by round', tokenizer: 'Your sentence, three tokenizers', trainingplan: 'How many steps does the training take?', umkehr: 'Parent, child and the reversal', vocabulary: 'How big should the vocabulary be?', weights: 'The spam filter’s mixing desk', zickzack: 'Three rules in a ravine' },
};

export async function getStaticPaths() {
	// getStaticPaths runs before the rest of the frontmatter -- the demo list is restated here.
	const known = new Set(['attention', 'aufgaben', 'basis', 'berechtigung', 'bpe', 'chatsequence', 'chatvorlage', 'datensieb', 'denkschritte', 'denkvergleich', 'descent', 'dreistellen', 'embeddingtraining', 'folgen', 'fortsetzung', 'hiddenstate', 'klausur', 'learningcurves', 'lernratenplan', 'memory', 'modelprobe', 'neighbors', 'neuron', 'outputscore', 'probedrehen', 'pruefampel', 'qkv', 'rueckweg', 'sampling', 'satzloss', 'schleife', 'schreibtisch', 'shape', 'softmax', 'spamneuron', 'strafpunkte', 'textloop', 'tokenizer', 'trainingplan', 'umkehr', 'vocabulary', 'weights', 'zickzack']);
	const paths = [];
	for (const lang of ['de', 'en'] as const) {
		for (const lesson of await getShareLessons(lang)) {
			for (const demo of lesson.demos) {
				if (known.has(demo)) paths.push({ params: { demo, lang }, props: { lesson, demo, lang } });
			}
		}
	}
	return paths;
}

const { lesson, demo, lang } = Astro.props as { lesson: ShareLesson; demo: DemoKey; lang: 'de' | 'en' };
const Demo = DEMOS[demo];
---

<EmbedLayout lang={lang} title={TITLES[lang][demo]} lessonUrl={absolute(`${lesson.path}#${demoAnchor(lang, demo)}`)} lessonTitle={lesson.title}>
	<Demo lang={lang} />
</EmbedLayout>

---
// Single global 404 page: GitHub Pages serves dist/404.html for EVERY missed
// path regardless of the language prefix, so this page is bilingual itself —
// no language redirect is possible because the intended language is unknown
// at build time. The shell renders in DE (default locale); the EN block
// carries its own lang attribute. Both blocks offer the same search-less
// next steps (Themenbereiche, Glossar, Startseite). The one small script
// below only reads location.pathname: when the missed path looks like a
// Baustein URL (/de/bausteine/… or /en/lessons/…) it reveals a hint that the
// Baustein may have moved and the Themenbereiche list every current one.
// The phyllotaxis mark is the small section-mark instance (DESIGN.md §4,
// placement type 2), not the Hero bloom; no Hero glow here.
import PageShell from '../layouts/PageShell.astro';
import ErrorBloom from '../components/ErrorBloom.astro';
---

<PageShell
	lang="de"
	title="Seite nicht gefunden · Page not found — KI einfach verstehen"
	description="Diese Seite ist umgezogen oder gibt es nicht — die Themenbereiche, das Glossar und die Startseite führen weiter. This page has moved or does not exist — the topic areas, the glossary and the homepage lead on."
	otherLangHref="/en/"
	themenHref="/de/#themenbereiche"
>
	<section class="section notfound" aria-labelledby="nf-title">
		<div class="wrap">
			<div class="nf-inner">
				<ErrorBloom />
				<p class="eyebrow">404 · Seite nicht gefunden / Page not found</p>

				<div class="nf-block">
					<h1 id="nf-title">Diese Seite ist umgezogen oder gibt es nicht.</h1>
					<p class="nf-lede">
						Vielleicht ist der Link älter als die Seite, oder in der Adresse hat sich ein Tippfehler versteckt. Was du
						suchst, ist wahrscheinlich nur einen Schritt entfernt.
					</p>
					<p class="nf-hint" data-nf-hint hidden>
						Die Adresse sieht nach einem Baustein aus. Bausteine ziehen gelegentlich um — in den Themenbereichen findest
						du jeden aktuellen Baustein an seinem Platz.
					</p>
					<p class="nf-actions">
						<a class="btn btn-primary" href="/de/#themenbereiche">Zu den Themenbereichen</a>
						<a class="btn btn-secondary" href="/de/glossar/">Zum Glossar</a>
						<a class="btn btn-secondary" href="/de/">Zur Startseite</a>
					</p>
				</div>

				<hr class="nf-divider" />

				<div class="nf-block" lang="en">
					<h2>This page has moved or does not exist.</h2>
					<p class="nf-lede">
						The link may be older than the page, or a typo slipped into the address. What you are looking for is probably
						just one step away.
					</p>
					<p class="nf-hint" data-nf-hint hidden>
						The address looks like a lesson. Lessons occasionally move — the topic areas list every current lesson in its
						place.
					</p>
					<p class="nf-actions">
						<a class="btn btn-primary" href="/en/#themenbereiche">Browse the topic areas</a>
						<a class="btn btn-secondary" href="/en/glossary/">Open the glossary</a>
						<a class="btn btn-secondary" href="/en/">Go to the homepage</a>
					</p>
				</div>
			</div>
		</div>
	</section>
</PageShell>

<script>
	// A missed Baustein URL (ADR-0002 shape: /de/bausteine/<slug>/ or
	// /en/lessons/<slug>/) gets the "it may have moved" hint in both blocks.
	if (/^\/(de\/bausteine|en\/lessons)\/[a-z0-9-]+/.test(location.pathname)) {
		for (const hint of document.querySelectorAll('[data-nf-hint]')) hint.removeAttribute('hidden');
	}
</script>

<style>
	/* Roomy but calm: a single centered column on ground-page, no zone tint —
	   this is a wayfinding moment, not an overview section. */
	.notfound {
		padding: var(--sp-2xl) 0 var(--sp-3xl);
	}
	.nf-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 40rem;
		margin-inline: auto;
		text-align: center;
	}
	.nf-inner > :global(.error-bloom) {
		margin-bottom: var(--sp-md);
	}
	.nf-block {
		margin-top: var(--sp-xs);
	}
	h1,
	h2 {
		font-size: clamp(1.9rem, 1.2rem + 2.4vw, 2.75rem);
		line-height: 1.12;
		letter-spacing: -0.01em;
	}
	.nf-lede {
		margin-top: var(--sp-sm);
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--ink-muted);
		text-wrap: pretty;
	}
	.nf-hint {
		margin: var(--sp-sm) auto 0;
		max-width: 32rem;
		padding: var(--sp-xs) var(--sp-sm);
		border-left: 3px solid var(--petrol);
		background: var(--ground-zone);
		border-radius: var(--r-sm);
		text-align: left;
		font-size: 1rem;
		line-height: 1.6;
	}
	.nf-hint[hidden] {
		display: none;
	}
	.nf-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--sp-xs) var(--sp-sm);
		margin-top: var(--sp-md);
	}
	.nf-actions .btn {
		padding-inline: 24px;
	}
	.nf-divider {
		width: 100%;
		max-width: 240px;
		border: 0;
		border-top: 1px solid var(--line-deep);
		margin: var(--sp-xl) auto 0;
	}
	@media (max-width: 520px) {
		.notfound {
			padding: var(--sp-xl) 0 var(--sp-2xl);
		}
		.nf-actions {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
		}
		.nf-actions .btn {
			justify-content: center;
		}
	}
</style>

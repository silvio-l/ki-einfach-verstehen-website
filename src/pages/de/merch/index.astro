---
// Merch shop page — products are sold on amazon.de, linked by ASIN (src/data/merch.ts).
import PageShell from '../../../layouts/PageShell.astro';
import StoryArticle from '../../../components/StoryArticle.astro';
import MerchGallery from '../../../components/MerchGallery.astro';

const title = 'Merch & Unterstützen — KI einfach verstehen';
const description = 'T-Shirts, Hoodies, Thermobecher mit KI-Sprüchen – erhältlich bei Amazon. Jeder Kauf unterstützt das frei zugängliche Lernprojekt „KI einfach verstehen“.';
---

<PageShell lang="de" title={title} description={description} otherLangHref="/en/merch/" themenHref="/de/#themenbereiche">
	<StoryArticle lang="de" eyebrow="Projekt unterstützen" title="Merch">
		<p><strong>Trag KI mit Humor – und halte damit „KI einfach verstehen“ am Laufen.</strong></p>
		<p>
			Alle Erklärungen auf dieser Website sind frei zugänglich, ohne Paywall und ohne Anmeldung. Damit das so bleibt,
			braucht das Projekt Rückenwind: <strong>Von jedem Merch-Kauf fließt ein Anteil direkt zurück ins Projekt</strong>{' '}
			– in Recherche, neue Bausteine, Grafiken und Technik.
		</p>
		<p>
			Und du bekommst etwas dafür, das sich sehen lassen kann: Sprüche, die jeder kennt, der schon mal mit KI
			gearbeitet hat, und die erstaunlich präzise beschreiben, wie sich ein Montagmorgen anfühlt.{' '}
			<strong>„Mein Kontextfenster ist voll.“ „Ohne Kaffee keine Inferenz.“ „Thinking quota exceeded.“</strong>
		</p>
		<p>
			Kurz gesagt: Du trägst einen Insider-Witz, und freies KI-Wissen bekommt Unterstützung. Ein Deal ganz ohne
			Halluzination.
		</p>
		<section class="story-section">
			<h2>Alle Produkte</h2>
			<MerchGallery lang="de" />
		</section>
	</StoryArticle>
</PageShell>

---
// Merch shop page — products are sold on amazon.de, linked by ASIN (src/data/merch.ts).
import PageShell from '../../../layouts/PageShell.astro';
import StoryArticle from '../../../components/StoryArticle.astro';
import MerchGallery from '../../../components/MerchGallery.astro';

const title = 'Merch & Unterstützen — KI einfach verstehen';
const description = 'T-Shirts, Hoodies und mehr mit Sprüchen, die Alltagszustand und KI-Systemmeldung zusammenbringen – erhältlich bei Amazon. Mit jedem Kauf unterstützt du das Projekt.';
---

<PageShell lang="de" title={title} description={description} otherLangHref="/en/merch/" themenHref="/de/#themenbereiche">
	<StoryArticle lang="de" eyebrow="Projekt unterstützen" title="Merch">
		<p><strong>KI zum Anziehen.</strong></p>
		<p>
			Manchmal reicht ein Blick aufs T-Shirt, um ziemlich genau zu beschreiben, wie der Tag mit KI gerade läuft:{' '}
			<strong>Rate Limit. Kontextfenster voll. Thinking Quota exceeded.</strong>
		</p>
		<p>
			Die Motive greifen genau diese kleinen Absurditäten, Fehlermeldungen und Aha-Momente rund um KI auf – trocken,
			reduziert und mit einem Augenzwinkern. Für den eigenen Kleiderschrank, als Gesprächsstarter oder einfach für
			den Moment, in dem <strong>„Mein Gehirn hat gerade Rate Limit.“</strong> überraschend präzise die Lage
			beschreibt.
		</p>
		<p>
			<strong>Mit jedem Kauf unterstützt du „KI einfach verstehen“.</strong> Die Einnahmen aus dem Merch fließen
			zurück in das Projekt und helfen dabei, Recherche, Inhalte, Technik und neue Formate zu finanzieren. So trägst
			du dazu bei, dass Wissen rund um KI verständlich aufbereitet und frei zugänglich bleiben kann.
		</p>
		<p>
			Du bekommst also nicht nur ein T-Shirt mit einem guten Spruch –{' '}
			<strong>du hilfst gleichzeitig dabei, „KI einfach verstehen“ am Laufen zu halten und weiterzuentwickeln.</strong>
		</p>
		<section class="story-section">
			<h2>Alle Produkte</h2>
			<MerchGallery lang="de" />
		</section>
	</StoryArticle>
</PageShell>

---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Hero from '../../components/Hero.astro';
import Wegkarte from '../../components/Wegkarte.astro';
import ThemenbereichCards from '../../components/ThemenbereichCards.astro';
import Spotlight from '../../components/Spotlight.astro';
import Lernstand from '../../components/Lernstand.astro';
import Onboarding from '../../components/Onboarding.astro';
import ProgressRail from '../../components/ProgressRail.astro';
import AdSlot from '../../components/AdSlot.astro';
import { countWord, getCurriculumCounts } from '../../data/themenbereiche';

const counts = await getCurriculumCounts('en');

const railSections = [
	{ id: 'top', label: 'Top' },
	{ id: 'themenbereiche', label: 'Topics' },
	{ id: 'einstieg', label: 'Start here' },
	{ id: 'footer', label: 'Footer' },
];
---

<SiteLayout
	lang="en"
	title="KI einfach verstehen — how artificial intelligence really works"
	description="KI einfach verstehen shows you how artificial intelligence actually works — clearly explained, never just skimming the surface."
>
	<Hero lang="en" />
	<Onboarding lang="en" />
	<Lernstand lang="en" />
	<section class="section section--zone" id="themenbereiche">
		<div class="wrap">
			<div class="section-head">
				<p class="eyebrow">The path through all {counts.bausteine} lessons</p>
				<h2>{countWord(counts.themenbereiche, 'en', true)} topics, one continuous path</h2>
				<p class="section-lede">
					Every lesson is a complete, self-contained chapter — not a quick post. The topics build on each other, and the map
					always shows you where on the path you currently stand.
				</p>
			</div>
		</div>
		<Wegkarte lang="en" />
		<div class="wrap">
			<AdSlot lang="en" slot="homeWegkarte" />
			<ThemenbereichCards lang="en" />
		</div>
	</section>
	<section class="section" id="einstieg">
		<div class="wrap">
			<Spotlight lang="en" />
		</div>
	</section>
	<ProgressRail label="Page progress" sections={railSections} />
</SiteLayout>

---
// Announcement page (ADR-0007, CONTEXT.md) — merch.
import PageShell from '../../../layouts/PageShell.astro';
import StoryArticle from '../../../components/StoryArticle.astro';
import MerchGallery from '../../../components/MerchGallery.astro';

const title = 'Merch — KI einfach verstehen';
const description = 'T-shirts pairing an everyday human state with a flat AI system message. Currently in preparation, not yet available on Amazon.';
---

<PageShell lang="en" title={title} description={description} otherLangHref="/de/merch/" themenHref="/en/#themenbereiche">
	<StoryArticle lang="en" eyebrow="Announcement" title="Merch" status="In preparation">
		<p>
			A collection of slogans that state an everyday human state as a flat AI system message — no wordplay, no
			punchline, just an honest translation: "tired" becomes "rate limit", "overwhelmed" becomes "context window
			full".
		</p>
		<p>
			The designs come from a reusable template (fixed typography, three layout variants, a recurring block-cursor
			detail) and are production-ready for Amazon Merch on Demand. Sales start once the products are submitted and
			approved there — until then, this is a preview.
		</p>
		<MerchGallery lang="en" />
	</StoryArticle>
</PageShell>

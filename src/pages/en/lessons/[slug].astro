---
import { getCollection, render } from 'astro:content';
import ContentEntryLayout from '../../../layouts/ContentEntryLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('bausteine', (entry) => entry.id.startsWith('en/'));
	return entries.map((entry) => ({
		params: { slug: entry.id.slice('en/'.length) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentEntryLayout entry={entry} collection="bausteine" lang="en" headings={headings}>
	<Content />
</ContentEntryLayout>

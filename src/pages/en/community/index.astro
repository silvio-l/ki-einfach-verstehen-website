---
// Announcement page (ADR-0007, CONTEXT.md) — Community.
import PageShell from '../../../layouts/PageShell.astro';
import StoryArticle from '../../../components/StoryArticle.astro';

const title = 'Community — KI einfach verstehen';
const description = 'A place to talk about individual lessons and open questions. Launches once enough lessons are published.';
---

<PageShell lang="en" title={title} description={description} otherLangHref="/de/community/" themenHref="/en/#themenbereiche">
	<StoryArticle lang="en" eyebrow="Announcement" title="Community" status="In preparation">
		<p>A place where you can discuss individual lessons, ask open questions, and meet other learners.</p>
		<p>
			Every lesson already has a fixed, permanent URL — that's exactly where the matching discussion will link once the
			community launches.
		</p>
		<p>
			Until then, it's worth taking a look at the lessons already published:{' '}
			<a href="/en/#themenbereiche">Browse topics</a>.
		</p>
	</StoryArticle>
</PageShell>

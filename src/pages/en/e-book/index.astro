---
// Announcement page (ADR-0007, CONTEXT.md) — e-book. The book is compiled
// from the published lessons (ADR-0014), so the honest status is how far
// the lessons are, counted live from the content collections.
import PageShell from '../../../layouts/PageShell.astro';
import StoryArticle from '../../../components/StoryArticle.astro';
import FollowNotice from '../../../components/FollowNotice.astro';
import { getPublished } from '../../../data/published';
import { getThemenbereiche } from '../../../data/themenbereiche';

const published = (await getPublished('en')).length;
const planned = (await getThemenbereiche('en')).reduce((sum, tb) => sum + tb.bausteine.length, 0);

const title = 'The E-Book — KI einfach verstehen';
const description =
	'The e-book is compiled from the lessons on this website: each topic a part, each lesson a chapter. It comes out once every topic is finished.';
---

<PageShell lang="en" title={title} description={description} otherLangHref="/de/e-book/" themenHref="/en/#themenbereiche">
	<StoryArticle lang="en" eyebrow="Announcement" title="E-book" status="Compiled from the lessons">
		<p>The e-book gathers the lessons on this website into a book for a linear read: offline, without distractions, chapter by chapter.</p>
		<p>
			It isn't written from scratch but compiled from the published lessons. Each topic becomes a part of the book,
			each lesson a chapter. What only works on the website, such as interactive demos, animations and recall moments,
			stays here. The graphics get their own version for print and e-readers.
		</p>
		<p>
			The book comes out once every topic is finished. Right now
			<strong data-testid="ebook-progress">{published} of {planned} lessons</strong> are published.
		</p>
		<p>
			Until then, you can read every finished lesson here for free:{' '}
			<a href="/en/#themenbereiche" data-testid="ebook-topics-link">Browse topics</a>.
		</p>
		<FollowNotice lang="en" channel="e-book" />
	</StoryArticle>
</PageShell>

---
// The one place the homepage converts: the first actually published Baustein,
// featured with real metadata (derived reading time, real glossary links,
// real bilingual availability). This is the single amber spotlight moment
// DESIGN.md allows per view. Renders nothing while no Baustein is published.
// Once the first Baustein is read, the script swaps in the next unread one
// (spotlightTarget in src/scripts/progress.js) and hides the spotlight when
// every published Baustein is read.
import { getPublished, readingMinutes } from '../data/published';
import { getThemenbereiche } from '../data/themenbereiche';

interface Props {
	lang: 'de' | 'en';
}

const { lang } = Astro.props;
const themenbereiche = await getThemenbereiche(lang);
const published = await getPublished(lang);
const feature = published[0];
const tbIndex = feature ? themenbereiche.findIndex((tb) => tb.key === feature.themenbereichSlug) : -1;
const tbTitle = tbIndex >= 0 ? themenbereiche[tbIndex].title : '';
const minutes = feature ? readingMinutes(feature.body) : 0;
const tbTitleOf = (key: string) => themenbereiche.find((tb) => tb.key === key)?.title ?? '';
const items = published.map((p) => ({
	tk: p.tk,
	href: p.href,
	title: p.title,
	order: p.order,
	area: tbTitleOf(p.themenbereichSlug),
	description: p.description,
	minutes: readingMinutes(p.body),
}));

const copy = {
	de: {
		eyebrow: 'Fang hier an',
		badge: 'Jetzt lesbar',
		slot: `Baustein ${feature?.order ?? 1} · ${tbTitle}`,
		teaser: 'Ist ein Sprachmodell einfach ein sehr kompliziertes Programm? Der erste Baustein räumt mit genau diesem Missverständnis auf — und gibt dir die drei Begriffe an die Hand, auf denen alle weiteren aufbauen.',
		meta: [`≈ ${minutes} Minuten Lesezeit`, 'Mit Verweisen ins Glossar', 'Auch auf Englisch verfügbar'],
		cta: `Baustein ${feature?.order ?? 1} lesen`,
		next: {
			eyebrow: 'Weiter geht’s',
			badge: 'Als Nächstes',
			slot: 'Baustein {n} · {area}',
			minutes: '≈ {m} Minuten Lesezeit',
			cta: 'Baustein {n} lesen',
		},
	},
	en: {
		eyebrow: 'Start here',
		badge: 'Readable now',
		slot: `Lesson ${feature?.order ?? 1} · ${tbTitle}`,
		teaser: 'Is a language model just a very complicated program? The first lesson clears up exactly that misconception — and hands you the three terms every later lesson builds on.',
		meta: [`≈ ${minutes} minutes of reading`, 'With links into the glossary', 'Also available in German'],
		cta: `Read lesson ${feature?.order ?? 1}`,
		next: {
			eyebrow: 'Keep going',
			badge: 'Up next',
			slot: 'Lesson {n} · {area}',
			minutes: '≈ {m} minutes of reading',
			cta: 'Read lesson {n}',
		},
	},
}[lang];
---

{
	feature && (
		<div class="spot-wrap" data-spot>
			<script is:inline type="application/json" data-spot-data set:html={JSON.stringify({ items, strings: copy.next })} />
			<p class="eyebrow spot-kicker" data-spot-eyebrow>{copy.eyebrow}</p>
			<article class="spot">
				<div class="spot-main">
					<p class="spot-slot">
						<span class="badge-progress" data-spot-badge>
							{copy.badge}
						</span>
						<span class="spot-slot-text" data-spot-slot>{copy.slot}</span>
					</p>
					<h2 class="spot-title">
						<a href={feature.href} data-spot-link>{feature.title}</a>
					</h2>
					<p class="spot-teaser" data-spot-teaser>{copy.teaser}</p>
				</div>
				<div class="spot-side">
					<ul class="spot-meta" data-spot-meta>
						{copy.meta.map((m) => (
							<li>{m}</li>
						))}
					</ul>
					<a class="btn btn-primary" data-spot-cta href={feature.href}>
						{copy.cta}
					</a>
				</div>
			</article>
		</div>
	)
}

<script>
	// Returning readers are pointed onward: after the first Baustein the
	// next unread one, and no spotlight at all once everything is read.
	import { getReadSet, spotlightTarget } from '../scripts/progress.js';

	try {
		const root = document.querySelector<HTMLElement>('[data-spot]');
		const raw = root?.querySelector('[data-spot-data]')?.textContent;
		if (root && raw) {
			const { items, strings } = JSON.parse(raw);
			const target = spotlightTarget(items, getReadSet());
			if (target === null) {
				root.hidden = true;
				// Nothing left to point at: drop the whole host section too, so
				// no empty padded band and no dead ultrawide-rail stop remain.
				const section = root.closest<HTMLElement>('section[id]');
				if (section) {
					section.hidden = true;
					document.querySelector(`[data-progress-rail] a[data-target="${section.id}"]`)?.closest('li')?.setAttribute('hidden', '');
				}
			} else if (!target.first) {
				const { item } = target;
				const fill = (tpl: string) => tpl.replace('{n}', String(item.order)).replace('{area}', item.area).replace('{m}', String(item.minutes));
				const set = (sel: string, text: string) => {
					const el = root.querySelector(sel);
					if (el) el.textContent = text;
				};
				set('[data-spot-eyebrow]', strings.eyebrow);
				set('[data-spot-badge]', strings.badge);
				set('[data-spot-slot]', fill(strings.slot));
				set('[data-spot-link]', item.title);
				set('[data-spot-teaser]', item.description);
				set('[data-spot-cta]', fill(strings.cta));
				// The fixed facts are about the first Baustein; only the reading time carries over.
				const meta = root.querySelector('[data-spot-meta]');
				if (meta) {
					const li = document.createElement('li');
					li.textContent = fill(strings.minutes);
					meta.replaceChildren(li);
				}
				for (const a of root.querySelectorAll<HTMLAnchorElement>('[data-spot-link], [data-spot-cta]')) a.href = item.href;
			}
		}
	} catch {
		/* progressive enhancement only */
	}
</script>

<style>
	.spot-kicker {
		margin-bottom: var(--sp-sm);
	}
	.spot {
		display: grid;
		/* Fills the elastic container; the side column stays capped so the
		   main column carries the extra width (its copy keeps a local ch
		   measure below). */
		grid-template-columns: minmax(0, 1fr) clamp(260px, 24vw, 400px);
		gap: var(--sp-xl);
		background: var(--ground-page);
		border: 1px solid var(--line);
		border-radius: var(--r-xl);
		padding: clamp(var(--sp-md), 4vw, var(--sp-xl));
	}
	.spot-slot {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--sp-sm);
		margin-bottom: var(--sp-sm);
	}
	.spot-slot-text {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
	}
	.spot-title {
		font-size: clamp(1.6rem, 2.6vw, 2.25rem);
		line-height: 1.12;
		margin-bottom: var(--sp-sm);
	}
	.spot-title a {
		color: var(--ink);
		text-decoration: none;
	}
	.spot-title a:hover {
		color: var(--petrol-deep);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}
	.spot-teaser {
		color: var(--ink-muted);
		line-height: 1.65;
		max-width: 56ch;
	}
	.spot-side {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--sp-md);
		border-left: 1px solid var(--line);
		padding-left: var(--sp-xl);
	}
	.spot-meta {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
		font-size: 1rem;
		color: var(--ink-muted);
	}
	.spot-meta li {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	.spot-meta li::before {
		content: '';
		flex: 0 0 auto;
		width: 6px;
		height: 6px;
		border-radius: var(--r-pill);
		background: var(--petrol-deep);
		transform: translateY(-2px);
	}
	.spot-side .btn {
		align-self: flex-start;
	}

	/* One quiet entrance as the section scrolls in — final state is the base. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.spot {
				animation: spot-rise 1ms cubic-bezier(0.2, 0.6, 0.2, 1) both;
				animation-timeline: view();
				animation-range: entry 5% entry 55%;
			}
		}
		@keyframes spot-rise {
			from {
				opacity: 0;
				transform: translateY(22px);
			}
		}
	}

	@media (max-width: 820px) {
		.spot {
			grid-template-columns: 1fr;
			gap: var(--sp-md);
		}
		.spot-side {
			border-left: 0;
			border-top: 1px solid var(--line);
			padding-left: 0;
			padding-top: var(--sp-md);
		}
	}
</style>

---
// Announcement/story article frame — the third reading register beside
// Baustein and Glossar, for standalone editorial pages ("Warum es dieses
// Projekt gibt"). Same structural grammar as ContentEntryLayout: the page
// frame is the full elastic --shell (breadcrumb flush with the nav brand
// edge), only the running text sits on the shared centered 53rem reading
// measure. No rail, no progress chrome — a story is read once, top to
// bottom, and needs neither a TOC nor a position marker.
//
// Slot contract: EVERY direct child of the prose slot sits on the measure —
// paragraphs, hairlines and embedded components alike (DESIGN.md §6). A
// richer block enters through the `.story-section` wrapper documented in the
// style block below, which gives it a heading and the section rhythm.
//
// The article-end phyllotaxis mark is the sanctioned section-end placement
// (DESIGN.md §4, placement 2: "section-end/footer marker") — one small,
// low-density, static instance per view, identical parametrization to the
// Baustein article-end mark.
interface Props {
	lang: 'de' | 'en';
	/** Tracked-uppercase kicker above the title. */
	eyebrow: string;
	/** Serif H1; also the breadcrumb's current-page label. */
	title: string;
	/** Ankündigungsseite status pill (ADR-0007), e.g. "in Vorbereitung". Omit for a plain story page. */
	status?: string;
}

const { lang, eyebrow, title, status } = Astro.props;
const homeHref = `/${lang}/`;

const copy = {
	de: { crumbLabel: 'Pfadnavigation', home: 'Startseite' },
	en: { crumbLabel: 'Breadcrumb', home: 'Home' },
}[lang];
---

<div class="wrap story-scope">
	<nav class="crumbs" aria-label={copy.crumbLabel}>
		<ol>
			<li><a href={homeHref}>{copy.home}</a></li>
			<li aria-current="page">{title}</li>
		</ol>
	</nav>
	<article class="story">
		<header class="story-head">
			<p class="story-slot"><span class="eyebrow">{eyebrow}</span></p>
			<h1 class="story-title">{title}</h1>
			{status && (
				<p class="story-status">
					<span class="badge-progress">{status}</span>
				</p>
			)}
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
	<div class="story-mark" aria-hidden="true">
		<svg id="storymark" viewBox="0 0 72 72"></svg>
	</div>
</div>

<script>
	// Section-end mark: one small, low-density, static instance of the motif —
	// same parametric family and values as the Baustein article-end mark.
	import { bloom } from '../scripts/bloom.js';

	bloom(document.getElementById('storymark'), {
		n: 48,
		r: 27,
		cx: 36,
		cy: 36,
		seed: 7,
		innerColor: '#0A5148',
		outerColor: '#12907F',
		edgeW: 0.6,
		nodeMin: 0.7,
		nodeMax: 1.9,
		glow: false,
		filaments: false,
		satellites: false,
	});
</script>

<style>
	/* Page frame = the shared elastic --shell (via .wrap); only the running
	   text carries the local reading measure — same contract as the Baustein
	   and Glossar shells (ContentEntryLayout). */
	.story-scope {
		--measure: 53rem;
		padding-top: var(--sp-lg);
		padding-bottom: var(--sp-3xl);
	}

	/* ——— Breadcrumb: full shell width, flush with the nav brand edge ——— */
	.crumbs ol {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-xs);
		font-size: 1rem;
		color: var(--ink-muted);
	}
	.crumbs li {
		display: flex;
		align-items: center;
		gap: var(--sp-xs);
		min-width: 0;
	}
	.crumbs li + li::before {
		content: '/';
		color: var(--line-deep);
	}
	.crumbs a {
		text-decoration: none;
		font-weight: 500;
	}
	.crumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.crumbs [aria-current='page'] {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ——— Header: eyebrow + serif title over a hairline, on the SAME centered
	   reading column as the prose below it. ——— */
	.story {
		margin-top: var(--sp-xl);
	}
	.story-head {
		padding-bottom: var(--sp-lg);
		margin-bottom: var(--sp-lg);
		border-bottom: 1px solid var(--line);
	}
	.story-slot,
	.story-title,
	.story-status {
		width: min(100%, var(--measure));
		margin-inline: auto;
	}
	.story-slot {
		margin-bottom: var(--sp-sm);
	}
	.story-title {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
	}
	.story-status {
		margin-top: var(--sp-sm);
	}

	/* ——— Prose (slotted page content) — every block sits on the shared
	   centered measure, one left and one right edge. ——— */
	.prose {
		min-width: 0;
		font-size: 1.125rem;
		line-height: 1.75;
	}
	/* ONE reading measure for everything a Story page slots in — paragraphs,
	   hairlines, section blocks and embedded components alike. This is a
	   default on the container's direct children, deliberately not a list of
	   known tags: the earlier element list (p, hr) silently exempted the first
	   embedded component (MerchGallery), which then stretched to the full
	   --shell next to 53rem paragraphs. That is the two-right-edges layout
	   DESIGN.md §6 rejected on 2026-08-24, only wider — see §6's 2026-08-25
	   entry. Anything a future page slots in conforms without editing this
	   rule; there is no sanctioned wide band. */
	.prose > :global(*) {
		width: min(100%, var(--measure));
		max-width: var(--measure);
		margin-inline: auto;
	}
	.prose :global(p) {
		margin-bottom: 1.35em;
	}
	.prose :global(p:last-child) {
		margin-bottom: 0;
	}
	/* An illustration inside a story: narrower than the measure, centered,
	   caption in the same italic serif as Baustein figures. */
	.prose > :global(.story-section > .story-figure),
	.prose > :global(.story-figure) {
		width: min(100%, 30rem);
		margin: 2.2em auto;
	}
	.prose :global(.story-figure img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--r-lg);
	}
	.prose :global(.story-figure figcaption) {
		margin-top: 0.7em;
		text-align: center;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--ink-muted);
	}
	.prose :global(strong) {
		font-weight: 600;
	}
	/* Thematic break between the story's movements: a quiet hairline pause,
	   same treatment as the Baustein prose hr. */
	.prose :global(hr) {
		border: 0;
		border-top: 1px solid var(--line-deep);
		margin-block: 2.4em;
	}
	/* The founding sentence, pulled out as a highlighted card — same register
	   as the glossary "Kurz gesagt" card: zone fill with the mandatory
	   petrol-deep hairline (Elevation Needs A Border rule). */
	.prose :global(.key) {
		background: var(--ground-zone);
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-lg);
		padding: var(--sp-md) var(--sp-lg);
		font-size: 1.25rem;
		line-height: 1.55;
		margin-block: 2em;
	}

	/* ——— Story section: the sanctioned way to slot a richer block (a gallery,
	   a card grid) into a story page.

	       <section class="story-section">
	           <h2>…</h2>
	           <SomeComponent />
	       </section>

	   The heading owns the interval — generous space above it, tight space
	   below it — so the block opens as a designed section instead of prose
	   that stops and restarts. That means embedded components carry no top
	   margin of their own: the rhythm belongs to this frame, not to the block.
	   Width is already handled by the measure default above. ——— */
	.prose :global(.story-section) {
		margin-top: 3.2em;
	}
	/* Subsection tier (DESIGN.md scale "28"), not the H2 display tier — a
	   section head inside a story sits below the page title, never level with
	   it. Same value as the Baustein prose h2. */
	.prose :global(.story-section > h2) {
		font-size: 1.75rem;
		line-height: 1.2;
		/* em, not an sp token: the interval above the heading is em-based too,
		   so the above/below ratio has to survive the reader's text-size
		   toggle (136% root) instead of drifting against a fixed 24px. */
		margin-bottom: 0.7em;
	}

	/* ——— Section-end mark ——— */
	.story-mark {
		display: flex;
		justify-content: center;
		margin: var(--sp-xl) auto 0;
	}
	.story-mark svg {
		width: 64px;
		height: 64px;
	}

	/* ——— Entrance: header arrives in reading order (site motion language);
	   the prose itself never waits — final state is the base. ——— */
	@media (prefers-reduced-motion: no-preference) {
		.crumbs,
		.story-head {
			animation: story-rise 0.55s cubic-bezier(0.2, 0.6, 0.2, 1) both;
		}
		.story-head {
			animation-delay: 0.12s;
		}
		@keyframes story-rise {
			from {
				transform: translateY(12px);
			}
		}
	}

	@media (max-width: 720px) {
		.story-scope {
			padding-top: var(--sp-md);
			padding-bottom: var(--sp-2xl);
		}
		.story {
			margin-top: var(--sp-lg);
		}
		.prose :global(.key) {
			padding: var(--sp-sm) var(--sp-md);
		}
	}
</style>

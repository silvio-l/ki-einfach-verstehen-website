---
// Product grid for the Merch Ankündigungsseite. Same "Elevation Needs A
// Border" card treatment as ThemenbereichCards, but the image tile uses the
// actual garment ground (near-black) rather than the page ground — that's
// product photography context, not page chrome, so it deliberately breaks
// from the light theme inside the tile only.
//
// The grid carries no width and no outer margin: inside a Story page it is
// placed in a `.story-section` wrapper, which owns both the reading measure
// and the interval to the prose above it (StoryArticle.astro, DESIGN.md §6).
import { MERCH_DESIGNS } from '../data/merch';

interface Props {
	lang: 'de' | 'en';
}

const { lang } = Astro.props;

const copy = {
	de: { soon: 'Bald bei Amazon', view: 'Bei Amazon ansehen' },
	en: { soon: 'Coming soon on Amazon', view: 'View on Amazon' },
}[lang];
---

<div class="merch-grid">
	{
		MERCH_DESIGNS.map((d) => (
			<article class="merch-card">
				<div class="merch-tile">
					<img src={`/merch/${d.id}.webp`} alt={d.slogan} width="896" height="1152" loading="lazy" />
				</div>
				<p class="merch-slogan">{d.slogan}</p>
				{d.amazonUrl ? (
					<a class="merch-link" href={d.amazonUrl} target="_blank" rel="noopener">
						{copy.view} <span class="merch-arrow" aria-hidden="true">→</span>
					</a>
				) : (
					<span class="badge-progress">{copy.soon}</span>
				)}
			</article>
		))
	}
</div>

<style>
	.merch-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
		gap: var(--sp-md);
	}
	.merch-card {
		background: var(--ground-page);
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-xl);
		padding: var(--sp-sm);
		display: flex;
		flex-direction: column;
		gap: var(--sp-sm);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}
	.merch-card:hover,
	.merch-card:focus-within {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(4, 39, 35, 0.13);
	}
	.merch-tile {
		background: #0a0a0a;
		border-radius: var(--r-md);
		overflow: hidden;
		aspect-ratio: 7 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.merch-tile img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}
	.merch-slogan {
		font-size: 1.125rem;
		line-height: 1.45;
		color: var(--ink);
		font-weight: 500;
	}
	.merch-link {
		margin-top: auto;
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
	}
	.merch-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.merch-arrow {
		display: inline-block;
		transition: transform 0.18s ease;
	}
	.merch-link:hover .merch-arrow {
		transform: translateX(4px);
	}
	.merch-card .badge-progress {
		margin-top: auto;
		align-self: flex-start;
	}
</style>

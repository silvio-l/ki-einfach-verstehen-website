---
// Merch shop: a product grid with a slogan search, a product-type filter
// and, per design, a variant switch (T-Shirt / Hoodie / …) that swaps image
// and the Amazon link in place. Products without an ASIN yet are shown as
// "coming soon" variants (image, no buy link). No prices: Amazon sets them and
// changes them on its own, so the live price is only ever shown on amazon.de.
// Purchase itself happens on amazon.de — every link is built from the
// listing's ASIN (amazonProductUrl), so DE and EN pages land on exactly the
// same product.
//
// Same "Elevation Needs A Border" card treatment as ThemenbereichCards, but
// the image tile uses the product photography's own dark ground rather than
// the page ground — that's product context, not page chrome, so it
// deliberately breaks from the light theme inside the tile only.
//
// Under the "All" filter each card shows a random one of its products, so the
// grid mixes shirts, tumblers, cases …; a type filter shows that type everywhere.
//
// Clicking a product image opens it large in a <dialog> lightbox; a click on
// the large image toggles a 2x zoom centred on the click point, so small print
// (tumbler slogans) stays readable.
//
// Progressive enhancement: without JS every card shows and links its first
// live product; the search/filter bar is hidden until the script enables it.
//
// The grid carries no width and no outer margin: inside a Story page it is
// placed in a `.story-section` wrapper, which owns both the reading measure
// and the interval to the prose above it (StoryArticle.astro, DESIGN.md §6).
import { MERCH_DESIGNS, MERCH_PRODUCT_TYPES, amazonProductUrl, type MerchProductType } from '../data/merch';

interface Props {
	lang: 'de' | 'en';
}

const { lang } = Astro.props;

const copy = {
	de: {
		soon: 'Demnächst bei Amazon',
		soonShort: 'bald',
		buy: 'Bei Amazon kaufen',
		all: 'Alle',
		filter: 'Nach Produkt filtern',
		search: 'Spruch suchen',
		searchPlaceholder: 'Spruch suchen, z. B. „Kaffee“',
		variants: 'Produkt wählen',
		empty: 'Kein Motiv passt zu deiner Auswahl.',
		zoom: 'Bild vergrößern',
		close: 'Schließen',
		zoomHint: 'Zum Heranzoomen ins Bild klicken',
		reset: 'Filter zurücksetzen',
		count: (n: number) => (n === 1 ? '1 Motiv' : `${n} Motive`),
		note: 'Verkauf und Versand über Amazon. Preis, Größe und Farbe siehst und wählst du direkt dort.',
		types: {
			tshirt: 'T-Shirt',
			hoodie: 'Hoodie',
			sweatshirt: 'Sweatshirt',
			tumbler: 'Thermobecher',
			popsocket: 'PopSocket',
			phonecase: 'iPhone-Hülle',
		},
	},
	en: {
		soon: 'Coming soon on Amazon',
		soonShort: 'soon',
		buy: 'Buy on Amazon',
		all: 'All',
		filter: 'Filter by product',
		search: 'Search slogans',
		searchPlaceholder: 'Search slogans, e.g. “coffee”',
		variants: 'Choose product',
		empty: 'No design matches your selection.',
		zoom: 'Enlarge image',
		close: 'Close',
		zoomHint: 'Click the image to zoom in',
		reset: 'Reset filters',
		count: (n: number) => (n === 1 ? '1 design' : `${n} designs`),
		note: 'Sold and shipped by Amazon. You see the price and pick size and color right there.',
		types: {
			tshirt: 'T-shirt',
			hoodie: 'Hoodie',
			sweatshirt: 'Sweatshirt',
			tumbler: 'Tumbler',
			popsocket: 'PopSocket',
			phonecase: 'iPhone case',
		},
	},
}[lang];

const imageFor = (id: string, type: MerchProductType) => (type === 'tshirt' ? `/merch/${id}.webp` : `/merch/${id}-${type}.webp`);

// Filter chips for every product type in the collection, live or coming soon.
const shopTypes = MERCH_PRODUCT_TYPES.filter((t) => MERCH_DESIGNS.some((d) => d.products.some((p) => p.type === t)));

const cards = MERCH_DESIGNS.map((d) => {
	const variants = d.products.map((p) => ({
		type: p.type,
		label: copy.types[p.type],
		href: p.asin ? amazonProductUrl(p.asin, lang) : '',
		img: imageFor(d.id, p.type),
	}));
	// Default to the first product that can actually be bought.
	const first = variants.find((v) => v.href) ?? variants[0]!;
	return { ...d, variants, first };
});
---

<div class="shop" data-shop>
	{
		shopTypes.length > 1 && (
			<div class="shop-bar" data-shop-bar hidden>
				<div class="shop-search">
					<svg class="shop-search-icon" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="11" cy="11" r="7" />
						<path d="m20 20-3.5-3.5" />
					</svg>
					<label class="visually-hidden" for={`shop-search-${lang}`}>
						{copy.search}
					</label>
					<input
						id={`shop-search-${lang}`}
						type="search"
						placeholder={copy.searchPlaceholder}
						autocomplete="off"
						data-search
					/>
				</div>
				<div class="shop-filter" role="group" aria-label={copy.filter}>
					<button type="button" class="chip" aria-pressed="true" data-filter="all">
						{copy.all}
					</button>
					{shopTypes.map((t) => (
						<button type="button" class="chip" aria-pressed="false" data-filter={t}>
							{copy.types[t]}
						</button>
					))}
				</div>
				<p class="shop-count" aria-live="polite" data-count-template={copy.count(0)} data-count-one={copy.count(1)}>
					{copy.count(cards.length)}
				</p>
			</div>
		)
	}

	<div class="merch-grid">
		{
			cards.map((d) => {
				const { first } = d;
				return (
					<article class="merch-card" data-card data-types={d.variants.map((v) => v.type).join(' ')}>
						<button type="button" class="merch-tile" aria-label={`${copy.zoom}: ${d.slogan}`} data-zoom>
							<img
								src={first.img}
								alt={`${first.label}: ${d.slogan}`}
								width="896"
								height="1152"
								loading="lazy"
								data-img
							/>
							<span class="merch-zoom-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24">
									<circle cx="11" cy="11" r="7" />
									<path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
								</svg>
							</span>
						</button>
						<p class="merch-slogan">{d.slogan}</p>
						{d.variants.length > 1 && (
							<div class="merch-variants" role="group" aria-label={copy.variants}>
								{d.variants.map((v) => (
									<button
										type="button"
										class="chip chip-sm"
										aria-pressed={v === first ? 'true' : 'false'}
										data-variant={v.type}
										data-label={v.label}
										data-href={v.href}
										data-src={v.img}
									>
										{v.label}
										{!v.href && <span class="chip-soon">{copy.soonShort}</span>}
									</button>
								))}
							</div>
						)}
						<div class="merch-buy">
							<span class="merch-type" data-type-label>
								{first.label}
							</span>
							<a
								class="btn btn-primary merch-cta"
								href={first.href || undefined}
								target="_blank"
								rel="noopener"
								hidden={!first.href}
								data-cta
							>
								{copy.buy}
								<span class="merch-arrow" aria-hidden="true">
									→
								</span>
							</a>
							<span class="merch-soon" hidden={!!first.href} data-soon>
								{copy.soon}
							</span>
						</div>
					</article>
				);
			})
		}
	</div>

	<div class="shop-empty" hidden data-empty>
		<p>{copy.empty}</p>
		<button type="button" class="btn btn-secondary" data-reset>
			{copy.reset}
		</button>
	</div>

	<p class="shop-note">{copy.note}</p>

	<dialog class="lightbox" aria-label={copy.zoom} data-lightbox>
		<button type="button" class="lightbox-close" aria-label={copy.close} data-close>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
		</button>
		<div class="lightbox-stage" data-stage>
			<img alt="" width="896" height="1152" data-lightbox-img />
		</div>
		<p class="lightbox-caption"><span data-caption></span> <span class="lightbox-hint">{copy.zoomHint}</span></p>
	</dialog>
</div>

<script>
	function selectVariant(card: HTMLElement, type: string) {
		const btn = card.querySelector<HTMLButtonElement>(`[data-variant="${type}"]`);
		if (!btn) return;
		card.querySelectorAll<HTMLButtonElement>('[data-variant]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
		const { label = '', href = '', src = '' } = btn.dataset;
		const img = card.querySelector<HTMLImageElement>('[data-img]');
		const slogan = card.querySelector('.merch-slogan')?.textContent ?? '';
		if (img) {
			img.src = src;
			img.alt = `${label}: ${slogan}`;
		}
		card.querySelector('[data-type-label]')!.textContent = label;
		const cta = card.querySelector<HTMLAnchorElement>('[data-cta]')!;
		if (href) cta.href = href;
		else cta.removeAttribute('href');
		cta.hidden = !href;
		card.querySelector<HTMLElement>('[data-soon]')!.hidden = !!href;
	}

	// Case- and accent-insensitive, so "ahnung" or "kontext" find their slogans.
	const norm = (s: string) =>
		s
			.toLocaleLowerCase()
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '');

	document.querySelectorAll<HTMLElement>('[data-shop]').forEach((shop) => {
		const cards = [...shop.querySelectorAll<HTMLElement>('[data-card]')];

		cards.forEach((card) =>
			card.querySelectorAll<HTMLButtonElement>('[data-variant]').forEach((b) =>
				b.addEventListener('click', () => selectVariant(card, b.dataset.variant!)),
			),
		);

		const lightbox = shop.querySelector<HTMLDialogElement>('[data-lightbox]')!;
		const stage = lightbox.querySelector<HTMLElement>('[data-stage]')!;
		const big = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
		cards.forEach((card) =>
			card.querySelector('[data-zoom]')!.addEventListener('click', () => {
				const img = card.querySelector<HTMLImageElement>('[data-img]')!;
				big.src = img.src;
				big.alt = img.alt;
				lightbox.querySelector('[data-caption]')!.textContent = img.alt;
				stage.classList.remove('is-zoomed');
				lightbox.showModal();
			}),
		);
		stage.addEventListener('click', (e) => {
			const r = big.getBoundingClientRect();
			big.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`;
			stage.classList.toggle('is-zoomed');
		});
		lightbox.querySelector('[data-close]')!.addEventListener('click', () => lightbox.close());
		// A click on the backdrop (the dialog element itself, outside its content) closes it.
		lightbox.addEventListener('click', (e) => {
			if (e.target === lightbox) lightbox.close();
		});

		const bar = shop.querySelector<HTMLElement>('[data-shop-bar]');
		if (!bar) return;
		bar.hidden = false;
		const count = bar.querySelector<HTMLElement>('.shop-count')!;
		const search = bar.querySelector<HTMLInputElement>('[data-search]')!;
		const filters = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
		const empty = shop.querySelector<HTMLElement>('[data-empty]')!;
		let type = 'all';

		// Random product per card, never the same type as the card before it, so
		// neighbours in the grid always differ.
		function shuffleVariants() {
			let prev = '';
			cards.forEach((card) => {
				const types = [...card.querySelectorAll<HTMLButtonElement>('[data-variant]')].map((v) => v.dataset.variant!);
				const pool = types.length > 1 ? types.filter((t) => t !== prev) : types;
				const pick = pool[Math.floor(Math.random() * pool.length)];
				if (!pick) return;
				selectVariant(card, pick);
				prev = pick;
			});
		}
		shuffleVariants();

		function apply() {
			const q = norm(search.value.trim());
			let visible = 0;
			cards.forEach((card) => {
				const show =
					(type === 'all' || card.dataset.types!.split(' ').includes(type)) &&
					(!q || norm(card.querySelector('.merch-slogan')?.textContent ?? '').includes(q));
				card.hidden = !show;
				if (show) {
					visible++;
					if (type !== 'all') selectVariant(card, type);
				}
			});
			count.textContent =
				visible === 1 ? count.dataset.countOne! : count.dataset.countTemplate!.replace('0', String(visible));
			empty.hidden = visible > 0;
		}

		filters.forEach((f) =>
			f.addEventListener('click', () => {
				type = f.dataset.filter!;
				filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
				if (type === 'all') shuffleVariants();
				apply();
			}),
		);
		search.addEventListener('input', apply);
		shop.querySelector('[data-reset]')!.addEventListener('click', () => {
			search.value = '';
			filters[0]!.click();
		});
	});
</script>

<style>
	.shop-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-sm);
		margin-bottom: var(--sp-md);
	}
	.shop-bar[hidden],
	.shop-empty[hidden],
	.merch-cta[hidden],
	.merch-soon[hidden] {
		display: none;
	}
	.shop-search {
		position: relative;
		flex: 1 1 100%;
	}
	.shop-search input {
		width: 100%;
		font: inherit;
		font-size: 1rem;
		color: var(--ink);
		background: var(--ground-page);
		border: 1.5px solid var(--line-deep);
		border-radius: var(--r-pill);
		padding: 12px 20px 12px 48px;
		transition: border-color 0.18s ease;
	}
	.shop-search input::placeholder {
		color: var(--ink-muted);
	}
	.shop-search input:hover {
		border-color: var(--petrol-deep);
	}
	.shop-search input:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
		border-color: var(--petrol-deep);
	}
	.shop-search-icon {
		position: absolute;
		left: 18px;
		top: 50%;
		width: 20px;
		height: 20px;
		transform: translateY(-50%);
		fill: none;
		stroke: var(--ink-muted);
		stroke-width: 2;
		stroke-linecap: round;
		pointer-events: none;
	}
	.shop-filter,
	.merch-variants {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-xs);
	}
	.shop-count {
		font-size: 1rem;
		color: var(--ink-muted);
	}
	.chip {
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.3;
		padding: 8px 18px;
		border-radius: var(--r-pill);
		border: 1.5px solid var(--petrol-deep);
		background: var(--ground-page);
		color: var(--petrol-deep);
		cursor: pointer;
		transition:
			background-color 0.18s ease,
			color 0.18s ease;
	}
	.chip:hover {
		background: var(--ground-zone);
	}
	.chip[aria-pressed='true'] {
		background: var(--petrol-deep);
		color: var(--ground-page);
	}
	.chip:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	.chip-sm {
		font-size: 0.875rem;
		padding: 5px 12px;
	}
	.chip-soon {
		margin-left: 6px;
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.75;
	}

	.merch-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
		gap: var(--sp-md);
	}
	.merch-card {
		background: var(--ground-page);
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-xl);
		padding: var(--sp-sm);
		display: flex;
		flex-direction: column;
		gap: var(--sp-sm);
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease;
	}
	.merch-card[hidden] {
		display: none;
	}
	.merch-card:hover,
	.merch-card:focus-within {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(4, 39, 35, 0.13);
	}
	.merch-tile {
		position: relative;
		background: #0a0a0a;
		border: 0;
		padding: 0;
		border-radius: var(--r-md);
		overflow: hidden;
		aspect-ratio: 7 / 9;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: zoom-in;
	}
	.merch-tile:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	.merch-zoom-icon {
		position: absolute;
		right: 10px;
		bottom: 10px;
		width: 36px;
		height: 36px;
		display: grid;
		place-items: center;
		border-radius: var(--r-pill);
		/* Fixed brand colours: these sit on the dark product photo in both site themes. */
		background: rgba(242, 237, 224, 0.94);
		color: #042723;
		opacity: 0.85;
		transition: opacity 0.18s ease;
	}
	.merch-tile:hover .merch-zoom-icon,
	.merch-tile:focus-visible .merch-zoom-icon {
		opacity: 1;
	}
	.merch-zoom-icon svg,
	.lightbox-close svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}
	.merch-tile img {
		transition: transform 0.3s ease;
	}
	.merch-tile:hover img {
		transform: scale(1.03);
	}

	.lightbox {
		margin: auto;
		padding: 0;
		border: 0;
		border-radius: var(--r-lg);
		background: #0a0a0a;
		color: #f2ede0;
		max-width: min(92vw, 720px);
		max-height: 94vh;
		overflow: hidden;
	}
	.lightbox::backdrop {
		background: rgba(2, 22, 19, 0.82);
	}
	.lightbox-stage {
		overflow: hidden;
		cursor: zoom-in;
	}
	.lightbox-stage img {
		display: block;
		width: 100%;
		height: auto;
		max-height: calc(94vh - 64px);
		object-fit: contain;
		transition: transform 0.3s ease;
	}
	.lightbox-stage.is-zoomed {
		cursor: zoom-out;
	}
	.lightbox-stage.is-zoomed img {
		transform: scale(2.2);
	}
	.lightbox-caption {
		padding: 12px 20px 16px;
		font-size: 0.875rem;
		line-height: 1.4;
	}
	.lightbox-hint {
		opacity: 0.7;
	}
	.lightbox-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 1;
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: var(--r-pill);
		/* Fixed brand colours: these sit on the dark product photo in both site themes. */
		background: rgba(242, 237, 224, 0.94);
		color: #042723;
		cursor: pointer;
	}
	.lightbox-close:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	.merch-tile img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		display: block;
	}
	.merch-slogan {
		font-size: 1.125rem;
		line-height: 1.45;
		color: var(--ink);
		font-weight: 500;
	}
	.merch-buy {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: var(--sp-xs);
	}
	.merch-type {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--ink-muted);
	}
	.merch-cta {
		justify-content: center;
		padding: 10px 20px;
		font-size: 1rem;
	}
	.merch-arrow {
		display: inline-block;
		transition: transform 0.18s ease;
	}
	.merch-cta:hover .merch-arrow {
		transform: translateX(4px);
	}
	.merch-soon {
		display: flex;
		justify-content: center;
		padding: 10px 20px;
		border-radius: var(--r-pill);
		border: 1.5px dashed var(--line-deep);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--ink-muted);
	}
	.shop-empty {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--sp-sm);
		padding: var(--sp-lg) 0;
		color: var(--ink-muted);
	}
	.shop-note {
		margin-top: var(--sp-md);
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}
</style>

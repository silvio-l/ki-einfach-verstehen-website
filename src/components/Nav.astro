---
// Sticky chrome: the ground-zone bar bleeds full width, while the nav row
// itself sits on the shared 1200px content edge — brand left, actions right,
// flush with every section below.
// Bildmarke: the ONE decided Wortbildmarke — Kandidat A, weight-corrected —
// at every size, nav included. See DESIGN.md "Wortbildmarke" for why: no
// separate small-size cut exists or should be invented; do not reintroduce
// mark-small-*.svg here.
import markLight from '../assets/brand/mark-light.svg?raw';
// Official GitHub mark, inlined like the brand mark — no external icon request.
import githubMark from '../assets/icons/github-mark.svg?raw';
import { getThemenbereiche, getThemenbereichHref } from '../data/themenbereiche';

interface Props {
	lang: 'de' | 'en';
	otherLangHref: string;
	homeHref: string;
	/** "Themenbereiche" target — local anchor on the homepage, absolute elsewhere. */
	themenHref?: string;
	/** Omit to render no CTA button (content pages keep the chrome calm). */
	ctaHref?: string;
	/** Build-time star count of the public website mirror; null = fetch failed,
	    the link still renders, just without a number. */
	githubStars: number | null;
	githubRepoUrl: string;
}

const { lang, otherLangHref, homeHref, themenHref = '#themenbereiche', ctaHref, githubStars, githubRepoUrl } = Astro.props;

const themenbereiche = await getThemenbereiche(lang);
const searchIndexHref = lang === 'de' ? '/de/suche-index.json' : '/en/search-index.json';
const menuCopy = {
	de: {
		menu: 'Menü',
		close: 'Menü schließen',
		search: 'Suchen',
		searchPlaceholder: 'Begriff suchen …',
		path: 'Dein Lernpfad',
		more: 'Mehr entdecken',
		display: 'Darstellung',
		themes: [['system', 'System'], ['light', 'Hell'], ['dark', 'Dunkel']],
		themeToggle: 'Dunkles Design umschalten',
		bausteine: (n: number) => `${n} Bausteine`,
		kind: { b: 'Baustein', g: 'Glossar' },
		none: 'Nichts gefunden. Probier einen kürzeren Begriff.',
		links: [
			['Glossar', '/de/glossar/'],
			['Wissenstest', '/de/wissenstest/'],
			['YouTube', '/de/youtube/'],
			['E-Book', '/de/e-book/'],
			['Community', '/de/community/'],
			['Warum wir das machen', '/de/warum/'],
		],
	},
	en: {
		menu: 'Menu',
		close: 'Close menu',
		search: 'Search',
		searchPlaceholder: 'Search a term …',
		path: 'Your learning path',
		more: 'Explore more',
		display: 'Appearance',
		themes: [['system', 'System'], ['light', 'Light'], ['dark', 'Dark']],
		themeToggle: 'Toggle dark theme',
		bausteine: (n: number) => `${n} lessons`,
		kind: { b: 'Lesson', g: 'Glossary' },
		none: 'Nothing found. Try a shorter term.',
		links: [
			['Glossary', '/en/glossary/'],
			['Knowledge check', '/en/knowledge-check/'],
			['YouTube', '/en/youtube/'],
			['E-book', '/en/e-book/'],
			['Community', '/en/community/'],
			['Why we do this', '/en/why/'],
		],
	},
}[lang];

const copy = {
	de: { themen: 'Themenbereiche', cta: 'Loslegen', switchTo: 'EN', switchLabel: 'Read in English', navLabel: 'Hauptnavigation', textSize: 'Größere Schrift', starLabel: 'Open Source — gib dem Projekt einen Stern auf GitHub' },
	en: { themen: 'Topics', cta: 'Start reading', switchTo: 'DE', switchLabel: 'Auf Deutsch lesen', navLabel: 'Main navigation', textSize: 'Larger text', starLabel: 'Open source — star this project on GitHub' },
}[lang];

// Zero is treated like a failed fetch: a "0" badge reads as a broken or
// unloved state, not an invitation — the mark-only pill carries the link.
const starCount = githubStars
	? new Intl.NumberFormat(lang === 'de' ? 'de-DE' : 'en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(githubStars)
	: null;
---

<nav class="site-nav" aria-label={copy.navLabel}>
	<div class="nav-inner">
		{/* The wordmark is display:none at phone width, so the link needs an
		    explicit accessible name (Lighthouse/axe link-name). */}
		<a class="brand" href={homeHref} aria-label="KI einfach verstehen">
			<span class="brand-mark" aria-hidden="true"><Fragment set:html={markLight} /></span>
			<span class="brand-word"><b>KI</b> einfach verstehen</span>
		</a>
		<div class="nav-links">
			<a class="nav-anchor" href={themenHref}>{copy.themen}</a>
			<button class="menu-toggle" type="button" data-menu-open aria-haspopup="dialog" aria-controls="site-menu" aria-label={menuCopy.menu}>
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
				<span class="menu-label">{menuCopy.menu}</span>
			</button>
			<a class="gh-star" href={githubRepoUrl} target="_blank" rel="noopener" aria-label={copy.starLabel} title={copy.starLabel}>
				<span class="gh-mark" aria-hidden="true"><Fragment set:html={githubMark} /></span>
				{starCount !== null && <span class="gh-count">{starCount}</span>}
			</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={menuCopy.themeToggle} title={menuCopy.themeToggle}>
				<svg class="ti-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
				<svg class="ti-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
			</button>
			<button class="text-toggle" type="button" data-text-toggle aria-pressed="false" aria-label={copy.textSize} title={copy.textSize}>
				<span class="tt-a1" aria-hidden="true">A</span><span class="tt-a2" aria-hidden="true">A</span>
			</button>
			<a href={otherLangHref} class="lang-switch" hreflang={lang === 'de' ? 'en' : 'de'} aria-label={copy.switchLabel}>{copy.switchTo}</a>
			{ctaHref && <a class="btn btn-primary btn-nav" href={ctaHref}>{copy.cta}</a>}
		</div>
	</div>
</nav>

<dialog class="site-menu" id="site-menu" aria-label={menuCopy.menu} data-search-index={searchIndexHref} data-none={menuCopy.none} data-kind-b={menuCopy.kind.b} data-kind-g={menuCopy.kind.g}>
	<div class="menu-inner">
		<div class="menu-top">
			<form class="menu-search" role="search" onsubmit="return false">
				<label class="visually-hidden" for="menu-q">{menuCopy.search}</label>
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
				<input id="menu-q" type="search" autocomplete="off" spellcheck="false" placeholder={menuCopy.searchPlaceholder} data-menu-q />
			</form>
			<button class="menu-close" type="button" data-menu-close aria-label={menuCopy.close}>
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
			</button>
		</div>
		<div class="menu-results" data-menu-results hidden>
			<ul data-menu-list></ul>
			<p class="menu-none" data-menu-none hidden>{menuCopy.none}</p>
		</div>
		<div class="menu-cols" data-menu-browse>
			<section aria-labelledby="menu-path">
				<h2 class="menu-h" id="menu-path">{menuCopy.path}</h2>
				<ol class="menu-path">
					{themenbereiche.map((tb, i) => (
						<li>
							<a href={getThemenbereichHref(tb, lang)}>
								<span class="menu-num" aria-hidden="true">{i + 1}</span>
								<span class="menu-path-text">
									<strong>{tb.title}</strong>
									<small>{menuCopy.bausteine(tb.bausteine.length)}</small>
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>
			<section aria-labelledby="menu-display">
				<h2 class="menu-h" id="menu-display">{menuCopy.display}</h2>
				<div class="menu-theme" role="group" aria-labelledby="menu-display">
					{menuCopy.themes.map(([key, label]) => (
						<button type="button" data-theme-choice={key} aria-pressed="false">{label}</button>
					))}
				</div>
			</section>
			<section aria-labelledby="menu-more">
				<h2 class="menu-h" id="menu-more">{menuCopy.more}</h2>
				<ul class="menu-more">
					{menuCopy.links.map(([label, href]) => (
						<li><a href={href}>{label}</a></li>
					))}
					<li><a href={githubRepoUrl} target="_blank" rel="noopener">GitHub{starCount !== null ? ` · ${starCount}` : ''}</a></li>
				</ul>
			</section>
		</div>
	</div>
</dialog>

<script>
	// Menu dialog: native <dialog> gives focus trap + Esc. The search index is
	// fetched once, on first open, and filtered in memory (diacritic-insensitive,
	// every query word must match; title hits rank first).
	const dlg = document.getElementById('site-menu') as HTMLDialogElement | null;
	const opener = document.querySelector('[data-menu-open]') as HTMLButtonElement | null;
	if (dlg && opener) {
		const input = dlg.querySelector('[data-menu-q]') as HTMLInputElement;
		const results = dlg.querySelector('[data-menu-results]') as HTMLElement;
		const list = dlg.querySelector('[data-menu-list]') as HTMLElement;
		const none = dlg.querySelector('[data-menu-none]') as HTMLElement;
		const browse = dlg.querySelector('[data-menu-browse]') as HTMLElement;
		type Entry = { t: string; d: string; h: string; k: 'b' | 'g'; n?: string; nt?: string };
		let index: Entry[] | null = null;
		const norm = (v: string) => v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/ß/g, 'ss');

		const load = async () => {
			if (index) return;
			try {
				const res = await fetch(dlg.dataset.searchIndex ?? '');
				const raw: Entry[] = await res.json();
				index = raw.map((e) => ({ ...e, n: norm(e.t + ' ' + e.d), nt: norm(e.t) }));
			} catch {
				index = [];
			}
		};
		const render = () => {
			const words = norm(input.value).split(/\s+/).filter(Boolean);
			const active = words.length > 0;
			results.hidden = !active;
			browse.hidden = active;
			if (!active || !index) return;
			const hits = index
				.filter((e) => words.every((w) => (e.n as string).includes(w)))
				.sort((a, b) => Number(words.every((w) => (b.nt as string).includes(w))) - Number(words.every((w) => (a.nt as string).includes(w))))
				.slice(0, 8);
			list.replaceChildren(
				...hits.map((e) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = e.h;
					const kind = document.createElement('small');
					kind.textContent = e.k === 'b' ? dlg.dataset.kindB ?? '' : dlg.dataset.kindG ?? '';
					const t = document.createElement('strong');
					t.textContent = e.t;
					const d = document.createElement('span');
					d.textContent = e.d.length > 110 ? e.d.slice(0, 107).trimEnd() + '…' : e.d;
					a.append(kind, t, d);
					li.append(a);
					return li;
				}),
			);
			none.hidden = hits.length > 0;
		};
		const open = async () => {
			if (!dlg.open) dlg.showModal();
			opener.setAttribute('aria-expanded', 'true');
			input.focus();
			await load();
			render();
		};
		const close = () => dlg.open && dlg.close();
		opener.addEventListener('click', open);
		dlg.querySelector('[data-menu-close]')?.addEventListener('click', close);
		dlg.addEventListener('close', () => {
			opener.setAttribute('aria-expanded', 'false');
			opener.focus();
		});
		// Click on the backdrop (the dialog element itself) closes.
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) close();
		});
		dlg.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				e.preventDefault();
				close();
			}
		});
		input.addEventListener('input', render);
		// "/" opens search from anywhere, unless the user is typing in a field.
		document.addEventListener('keydown', (e) => {
			const el = e.target as HTMLElement;
			if (e.key === '/' && !e.metaKey && !e.ctrlKey && !/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) && !el.isContentEditable) {
				e.preventDefault();
				open();
			}
		});
	}
</script>

<script>
	// Theme: the head script (PageShell) applies the stored/system choice before
	// first paint. `kev:theme` = light | dark; absent = follow the system.
	const THEME_KEY = 'kev:theme';
	const themeRoot = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');
	const stored = () => {
		try {
			const v = localStorage.getItem(THEME_KEY);
			return v === 'light' || v === 'dark' ? v : 'system';
		} catch {
			return 'system';
		}
	};
	const applyTheme = (choice: string) => {
		const t = choice === 'system' ? (media.matches ? 'dark' : 'light') : choice;
		themeRoot.setAttribute('data-theme', t);
		document.querySelectorAll('[data-theme-choice]').forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-choice') === choice)));
		document.querySelector('[data-theme-toggle]')?.setAttribute('aria-pressed', String(t === 'dark'));
	};
	const choose = (choice: string) => {
		try {
			if (choice === 'system') localStorage.removeItem(THEME_KEY);
			else localStorage.setItem(THEME_KEY, choice);
		} catch {
			/* not persisted — applies for this page only */
		}
		applyTheme(choice);
	};
	applyTheme(stored());
	media.addEventListener('change', () => stored() === 'system' && applyTheme('system'));
	document.querySelectorAll<HTMLElement>('[data-theme-choice]').forEach((b) => b.addEventListener('click', () => choose(b.dataset.themeChoice ?? 'system')));
	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => choose(themeRoot.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'));
</script>

<script>
	// Reader-selectable text size — the head inline script (PageShell) applies
	// the stored choice before first paint; this only wires the toggle and
	// keeps the button state in sync. localStorage-only, per ADR-0001.
	const KEY = 'kev:text-size';
	const root = document.documentElement;
	const btn = document.querySelector('[data-text-toggle]');
	const sync = () => btn?.setAttribute('aria-pressed', String(root.getAttribute('data-text-size') === 'large'));
	sync();
	btn?.addEventListener('click', () => {
		const large = root.getAttribute('data-text-size') !== 'large';
		if (large) root.setAttribute('data-text-size', 'large');
		else root.removeAttribute('data-text-size');
		try {
			localStorage.setItem(KEY, large ? 'large' : 'normal');
		} catch {
			/* not persisted — the choice still applies for this page */
		}
		sync();
	});
</script>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--ground-zone);
		border-bottom: 1px solid var(--petrol-deep);
	}
	@media print {
		.site-nav {
			display: none;
		}
	}
	/* Sits on the shared elastic content edge (--shell, tokens.css) — the
	   nav row, hero copy, section heads, and cards all share one line. */
	.nav-inner {
		display: flex;
		align-items: center;
		gap: var(--sp-md);
		height: var(--nav-h);
		width: var(--shell);
		margin-inline: auto;
	}
	/* Kandidat A lockup — the ONE documented mark/wordmark size, gap and
	   color relationship (packages/content/design/wortbildmarke-forschung.html,
	   "24 px — Navigationsleiste" tier: cap-ratio 0.701, overshoot 1.32,
	   gap-ratio 0.3). See DESIGN.md "Wortbildmarke". Do not restyle the mark
	   height or wordmark font independently of this ratio system. */
	.brand {
		--cap-ratio: 0.701;
		--overshoot: 1.32;
		--gap-ratio: 0.3;
		--fs: 1.5rem;
		--cap: calc(var(--fs) * var(--cap-ratio));
		--mark-h: calc(var(--cap) * var(--overshoot));
		--gap: calc(var(--cap) * var(--gap-ratio));
		--shift: calc(var(--cap) * (var(--overshoot) - 1) / 2);
		display: flex;
		align-items: baseline;
		gap: var(--gap);
		text-decoration: none;
		color: var(--ink);
		margin-right: auto;
	}
	.brand-mark {
		display: block;
		height: var(--mark-h);
		/* mark-light viewBox is 66 × 93.66 — preserve that ratio. */
		width: calc(var(--mark-h) * 0.7046);
		transform: translateY(var(--shift));
	}
	.brand-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.brand-word {
		font-family: var(--font-serif);
		font-size: var(--fs);
		font-weight: 500;
		line-height: 1;
		white-space: nowrap;
	}
	.brand-word b {
		font-weight: 700;
		color: var(--petrol-deep);
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: var(--sp-md);
	}
	.nav-anchor {
		text-decoration: none;
		color: var(--petrol-deep);
		font-weight: 500;
		font-size: 1rem;
	}
	.nav-anchor:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1.5px;
	}
	.lang-switch {
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 4px 11px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--petrol-deep);
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.lang-switch:hover {
		background: var(--glass);
	}
	/* GitHub star invitation — same quiet pill language as the language
	   switch; the invitation itself lives in the tooltip/aria label. */
	.gh-star {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 4px 11px;
		font-size: 0.875rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--petrol-deep);
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.gh-star:hover {
		background: var(--glass);
	}
	.gh-mark {
		display: block;
		width: 17px;
		height: 17px;
	}
	.gh-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* Two-step text-size toggle — same pill language as the language switch.
	   The two "A" glyphs are iconography, not reading text. */
	.text-toggle {
		display: inline-flex;
		align-items: baseline;
		gap: 2px;
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 4px 11px;
		background: transparent;
		color: var(--petrol-deep);
		font-family: var(--font-sans);
		font-weight: 600;
		line-height: 1.2;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.text-toggle .tt-a1 {
		font-size: 0.8125rem;
	}
	.text-toggle .tt-a2 {
		font-size: 1rem;
	}
	.text-toggle:hover {
		background: var(--glass);
	}
	.text-toggle[aria-pressed='true'] {
		background: var(--petrol-deep);
		color: var(--ground-page);
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 5px 9px;
		background: transparent;
		color: var(--petrol-deep);
		cursor: pointer;
	}
	.theme-toggle:hover {
		background: var(--glass);
	}
	.theme-toggle .ti-sun,
	:global(:root[data-theme='dark']) .theme-toggle .ti-moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .theme-toggle .ti-sun {
		display: block;
	}
	.menu-theme {
		display: inline-flex;
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		overflow: hidden;
	}
	.menu-theme button {
		font: inherit;
		font-weight: 600;
		font-size: 1rem;
		padding: 8px 18px;
		border: 0;
		background: transparent;
		color: var(--petrol-deep);
		cursor: pointer;
	}
	.menu-theme button + button {
		border-left: 1px solid var(--petrol-deep);
	}
	.menu-theme button[aria-pressed='true'] {
		background: var(--petrol-deep);
		color: var(--ground-page);
	}
	.btn-nav {
		white-space: nowrap;
		padding: 9px 22px;
		font-size: 1rem;
	}
	/* ——— Menu toggle: same pill language as the other nav controls ——— */
	.menu-toggle {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 4px 12px;
		background: transparent;
		color: var(--petrol-deep);
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}
	.menu-toggle:hover {
		background: var(--glass);
	}

	/* ——— Menu sheet: a top sheet under the nav bar ——— */
	.site-menu {
		position: fixed;
		inset: var(--nav-h) 0 auto 0;
		margin: 0;
		width: 100%;
		max-width: none;
		max-height: calc(100dvh - var(--nav-h));
		overflow: auto;
		border: 0;
		border-bottom: 1px solid var(--petrol-deep);
		padding: 0;

---
// Sticky chrome: the ground-zone bar bleeds full width, while the nav row
// itself sits on the shared 1200px content edge — brand left, actions right,
// flush with every section below.
// Bildmarke: the real small-size cut (mark-small-light — calibrated 4-mass
// geometry for < 64px rendering on light grounds), inlined unmodified.
import markSmallLight from '../assets/brand/mark-small-light.svg?raw';

interface Props {
	lang: 'de' | 'en';
	otherLangHref: string;
	homeHref: string;
	/** "Themenbereiche" target — local anchor on the homepage, absolute elsewhere. */
	themenHref?: string;
	/** Omit to render no CTA button (content pages keep the chrome calm). */
	ctaHref?: string;
}

const { lang, otherLangHref, homeHref, themenHref = '#themenbereiche', ctaHref } = Astro.props;

const copy = {
	de: { themen: 'Themenbereiche', cta: 'Loslegen', switchTo: 'EN', switchLabel: 'Read in English', navLabel: 'Hauptnavigation', textSize: 'Größere Schrift' },
	en: { themen: 'Topics', cta: 'Start reading', switchTo: 'DE', switchLabel: 'Auf Deutsch lesen', navLabel: 'Main navigation', textSize: 'Larger text' },
}[lang];
---

<nav class="site-nav" aria-label={copy.navLabel}>
	<div class="nav-inner">
		<a class="brand" href={homeHref}>
			<span class="brand-mark" aria-hidden="true"><Fragment set:html={markSmallLight} /></span>
			<span class="brand-word">KI einfach verstehen</span>
		</a>
		<div class="nav-links">
			<a class="nav-anchor" href={themenHref}>{copy.themen}</a>
			<button class="text-toggle" type="button" data-text-toggle aria-pressed="false" aria-label={copy.textSize} title={copy.textSize}>
				<span class="tt-a1" aria-hidden="true">A</span><span class="tt-a2" aria-hidden="true">A</span>
			</button>
			<a href={otherLangHref} class="lang-switch" hreflang={lang === 'de' ? 'en' : 'de'} aria-label={copy.switchLabel}>{copy.switchTo}</a>
			{ctaHref && <a class="btn btn-primary btn-nav" href={ctaHref}>{copy.cta}</a>}
		</div>
	</div>
</nav>

<script>
	// Reader-selectable text size — the head inline script (PageShell) applies
	// the stored choice before first paint; this only wires the toggle and
	// keeps the button state in sync. localStorage-only, per ADR-0001.
	const KEY = 'kev:text-size';
	const root = document.documentElement;
	const btn = document.querySelector('[data-text-toggle]');
	const sync = () => btn?.setAttribute('aria-pressed', String(root.getAttribute('data-text-size') === 'large'));
	sync();
	btn?.addEventListener('click', () => {
		const large = root.getAttribute('data-text-size') !== 'large';
		if (large) root.setAttribute('data-text-size', 'large');
		else root.removeAttribute('data-text-size');
		try {
			localStorage.setItem(KEY, large ? 'large' : 'normal');
		} catch {
			/* not persisted — the choice still applies for this page */
		}
		sync();
	});
</script>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--ground-zone);
		border-bottom: 1px solid var(--petrol-deep);
	}
	/* Sits on the shared elastic content edge (--shell, tokens.css) — the
	   nav row, hero copy, section heads, and cards all share one line. */
	.nav-inner {
		display: flex;
		align-items: center;
		gap: var(--sp-md);
		height: 64px;
		width: var(--shell);
		margin-inline: auto;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: var(--ink);
		margin-right: auto;
	}
	.brand-mark {
		display: block;
		height: 34px;
		/* mark-small viewBox is 71.58 × 97.77 — preserve that ratio. */
		width: calc(34px * 0.7322);
	}
	.brand-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.brand-word {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 1.02rem;
		letter-spacing: -0.01em;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: var(--sp-md);
	}
	.nav-anchor {
		text-decoration: none;
		color: var(--petrol-deep);
		font-weight: 500;
		font-size: 1rem;
	}
	.nav-anchor:hover {
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1.5px;
	}
	.lang-switch {
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 4px 11px;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--petrol-deep);
		text-decoration: none;
		transition: background-color 0.15s ease;
	}
	.lang-switch:hover {
		background: rgba(255, 255, 255, 0.55);
	}
	/* Two-step text-size toggle — same pill language as the language switch.
	   The two "A" glyphs are iconography, not reading text. */
	.text-toggle {
		display: inline-flex;
		align-items: baseline;
		gap: 2px;
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-pill);
		padding: 4px 11px;
		background: transparent;
		color: var(--petrol-deep);
		font-family: var(--font-sans);
		font-weight: 600;
		line-height: 1.2;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.text-toggle .tt-a1 {
		font-size: 0.8125rem;
	}
	.text-toggle .tt-a2 {
		font-size: 1rem;
	}
	.text-toggle:hover {
		background: rgba(255, 255, 255, 0.55);
	}
	.text-toggle[aria-pressed='true'] {
		background: var(--petrol-deep);
		color: var(--ground-page);
	}
	.btn-nav {
		padding: 9px 22px;
		font-size: 1rem;
	}
	@media (max-width: 720px) {
		.nav-anchor {
			display: none;
		}
	}
	@media (max-width: 460px) {
		.nav-inner {
			gap: var(--sp-sm);
		}
		.brand-word {
			display: none;
		}
		.btn-nav {
			padding: 9px 16px;
			font-size: 0.85rem;
		}
	}
</style>

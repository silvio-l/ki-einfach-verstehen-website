---
// The resolution of an <Uebung>: folded on the website until the reader opens
// it. Its content is plain Markdown and explains the "why", not only the
// answer (informative feedback, vom-modell-zum-assistenten.md B7).
interface Props {
	lang: 'de' | 'en';
}

const { lang } = Astro.props;
const label = { de: 'Auflösung anzeigen', en: 'Show the solution' }[lang];
---

<details class="kev-uebung-solution">
	<summary>{label}</summary>
	<slot />
</details>

---
// Foot-of-Baustein feedback prompt: one low-friction question ("was this
// helpful?"), not a graded rating -- deliberately no star/numeric scale,
// which would read as testing/grading the reader rather than the content
// (see CONTEXT.md's "Abrufmoment" tone note, and the community-strategy
// research's preference for prosocial signals like "Hilfreiche Erklärung"
// over gamified metrics). A vote fires a Matomo custom event once (site 9,
// see ~/Documents/Projekte/matomo/docs/sites.md): category "Baustein-Feedback"
// (stable, so the Goal matches regardless of Baustein/vote), action = the
// translationKey, name = the vote. This maps onto Matomo's native
// Category > Action > Name report hierarchy, so browsing Verhalten > Events
// in the Matomo UI reads as "Baustein-Feedback" > <Baustein> > <vote> instead
// of an opaque encoded string -- and the build-time aggregate query (see
// src/lib/matomo-feedback.ts) can walk that same hierarchy directly.
// The vote is then remembered locally (kev:feedback-bausteine, same
// Set-of-translationKey pattern as scripts/progress.js) so a returning
// reader sees a thank-you state instead of being asked again.
// A "Not really" vote additionally reveals concrete help right below the
// thank-you line: the per-paragraph "explain it simpler" control
// (ExplainSimpler.astro, offered only if its buttons are actually on the
// page) and, while the forum is live, a question about this Baustein in the
// community (same ask link as CommunityAsk.astro). Which offers show is
// decided in src/scripts/feedback-help.js.
import { COMMUNITY_LIVE, COMMUNITY_ORIGIN } from '../lib/community';
import { askUrl } from '../scripts/community-widget.js';

interface Props {
	lang: 'de' | 'en';
	translationKey: string;
}

const { lang, translationKey } = Astro.props;

const copy = {
	de: {
		eyebrow: 'Dein Eindruck',
		question: 'War dieser Baustein hilfreich?',
		yes: 'Ja, hilfreich',
		no: 'Eher nicht',
		thanks: 'Danke für dein Feedback.',
		helpLead: 'Vielleicht hilft dir das weiter:',
		explainText:
			'Lass dir unklare Stellen einfacher erklären: Tippe auf das Glühbirnen-Symbol neben einem Absatz oder markiere die Stelle im Text. Dann öffnet sich „Einfacher erklären lassen“.',
		explainCta: 'Zur ersten Erklärhilfe springen',
		communityText: 'Stell deine Frage zu diesem Baustein in der Community. Dort antworten andere Lernende und das Projekt.',
		communityCta: 'Frage in der Community stellen',
	},
	en: {
		eyebrow: 'Your take',
		question: 'Was this lesson helpful?',
		yes: 'Yes, helpful',
		no: 'Not really',
		thanks: 'Thanks for the feedback.',
		helpLead: 'Maybe this helps:',
		explainText:
			'Get unclear passages explained more simply: tap the lightbulb icon next to a paragraph, or select the passage in the text. That opens “Explain it more simply”.',
		explainCta: 'Jump to the first lightbulb',
		communityText: 'Ask your question about this lesson in the community. Other learners and the project answer there.',
		communityCta: 'Ask the community',
	},
}[lang];

const askHref = COMMUNITY_LIVE ? askUrl({ origin: COMMUNITY_ORIGIN, key: translationKey, lang }) : undefined;
---

<aside class="feedback" id="baustein-feedback" aria-label={copy.eyebrow} data-baustein-feedback data-tk={translationKey}>
	<p class="eyebrow">{copy.eyebrow}</p>
	<div data-feedback-ask>
		<p class="feedback-question">{copy.question}</p>
		<div class="feedback-actions">
			<button type="button" class="btn btn-secondary" data-feedback-vote="hilfreich">{copy.yes}</button>
			<button type="button" class="btn btn-secondary" data-feedback-vote="nicht hilfreich">{copy.no}</button>
		</div>
	</div>
	<p class="feedback-thanks" data-feedback-thanks tabindex="-1" hidden>{copy.thanks}</p>
	<div class="feedback-help" data-feedback-help hidden>
		<p class="feedback-help-lead">{copy.helpLead}</p>
		<ul class="feedback-help-list">
			<li data-feedback-help-explain hidden>
				<p>{copy.explainText}</p>
				<button type="button" class="btn btn-secondary" data-feedback-explain>{copy.explainCta}</button>
			</li>
			{
				askHref && (
					<li data-feedback-help-community hidden>
						<p>{copy.communityText}</p>
						<a class="btn btn-secondary" href={askHref} target="_blank" rel="noopener" data-feedback-community>
							{copy.communityCta}
						</a>
					</li>
				)
			}
		</ul>
	</div>
</aside>

<style>
	/* Same centered coda treatment as GithubStarCta, on the same measure. */
	.feedback {
		width: min(100%, var(--measure));
		margin: var(--sp-xl) auto 0;
		text-align: center;
	}
	@media print {
		.feedback {
			display: none;
		}
	}
	.feedback-question {
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--ink-muted);
		margin: var(--sp-xs) auto var(--sp-md);
	}
	.feedback-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--sp-sm);
	}
	.feedback-thanks {
		font-size: 1.125rem;
		color: var(--ink-muted);
	}
	/* Focus target after a vote (the clicked button disappears). */
	.feedback-thanks:focus {
		outline: none;
	}
	.feedback-thanks:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 4px;
	}
	.feedback-help {
		margin-top: var(--sp-md);
		text-align: left;
	}
	.feedback-help[hidden],
	.feedback-help-list li[hidden] {
		display: none;
	}
	.feedback-help-lead {
		font-weight: 600;
		color: var(--petrol-deep);
		margin: 0 0 var(--sp-sm);
		text-align: center;
	}
	.feedback-help-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--sp-sm);
	}
	.feedback-help-list li {
		display: grid;
		gap: var(--sp-sm);
		justify-items: start;
		padding: var(--sp-md);
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--ground-page);
	}
	.feedback-help-list p {
		margin: 0;
		line-height: 1.6;
		color: var(--ink);
	}
	/* The shared .btn padding is sized for hero CTAs; at 360px a long label
	   must wrap inside the card instead of overflowing it. */
	.feedback-help-list .btn {
		max-width: 100%;
		padding: 10px 22px;
		font-size: 1rem;
		text-align: left;
	}
	.feedback-help-list .btn:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
</style>

<script>
	import { helpOffers } from '../scripts/feedback-help.js';
	import { trackEvent } from '../lib/matomo';

	// localStorage-only, per ADR-0001; the vote itself goes to Matomo as a
	// custom event (best-effort, never blocks the local thank-you state).
	const STORAGE_KEY = 'kev:feedback-bausteine';

	function getVotedSet() {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			return new Set(raw ? JSON.parse(raw) : []);
		} catch {
			return new Set();
		}
	}

	function markVoted(tk: string) {
		try {
			const set = getVotedSet();
			set.add(tk);
			localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
		} catch {
			/* not persisted -- the thank-you state still shows for this page */
		}
	}

	const root = document.querySelector('[data-baustein-feedback]');
	const tk = root?.getAttribute('data-tk');
	const ask = root?.querySelector('[data-feedback-ask]');
	const thanks = root?.querySelector('[data-feedback-thanks]');

	if (root && tk && ask && thanks) {
		const showThanks = () => {
			ask.setAttribute('hidden', '');
			thanks.removeAttribute('hidden');
		};

		const help = root.querySelector<HTMLElement>('[data-feedback-help]');
		const explainItem = root.querySelector<HTMLElement>('[data-feedback-help-explain]');
		const communityItem = root.querySelector<HTMLElement>('[data-feedback-help-community]');
		// Injected by ExplainSimpler.astro's script; looked up at click time.
		const firstExplainButton = () => document.querySelector<HTMLButtonElement>('.prose .explain-btn');

		const showHelp = (vote: string | null) => {
			const offers = helpOffers({ vote, hasExplain: Boolean(firstExplainButton()), hasCommunity: Boolean(communityItem) });
			if (!help || !offers.show) return;
			explainItem?.toggleAttribute('hidden', !offers.explain);
			communityItem?.toggleAttribute('hidden', !offers.community);
			help.hidden = false;
		};

		root.querySelector('[data-feedback-explain]')?.addEventListener('click', () => {
			const btn = firstExplainButton();
			if (!btn) return;
			const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			btn.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
			btn.focus({ preventScroll: true });
		});
		root.querySelector('[data-feedback-community]')?.addEventListener('click', () => trackEvent('Community', 'Frage stellen', tk));

		try {
			if (getVotedSet().has(tk)) showThanks();
		} catch {
			/* progressive enhancement only */
		}

		root.querySelectorAll('[data-feedback-vote]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const vote = btn.getAttribute('data-feedback-vote');
				try {
					(window as any)._paq?.push(['trackEvent', 'Baustein-Feedback', tk, vote]);
				} catch {
					/* tracking best-effort */
				}
				markVoted(tk);
				showThanks();
				showHelp(vote);
				// The clicked button is gone now; keep keyboard and screen-reader
				// users at the result instead of dropping focus to <body>.
				(thanks as HTMLElement).focus();
			});
		});
	}
</script>

---
// Live demo for Baustein aus-text-werden-uebungsaufgaben: two short texts,
// each followed by an end token, are joined and cut into sequences of a
// window length the reader chooses. Each sequence shows its token count and
// the number of practice problems it yields. Logic: src/scripts/demos/aufgaben.js.
import Demo from './Demo.astro';

interface Props {
	lang: 'de' | 'en';
}
const { lang } = Astro.props;
const copy = {
	de: {
		title: 'Mehrere Texte, eine feste Länge',
		intro: 'Zwei ausgedachte Texte, jeweils mit einem Ende-Token dahinter, werden aneinandergehängt und in Folgen geschnitten. Stell die Fensterlänge ein und sieh, wo der Schnitt die Texte trennt.',
		note: 'Jedes Wort und jeder Punkt zählt hier als ein Token, zur Übersicht vereinfacht. Die kleinen Fensterlängen dienen nur der Übersicht, GPT-3 schnitt Folgen zu 2048 Tokens.',
		solution: 'Die beiden Texte haben mit ihren Ende-Tokens zusammen 13 Tokens. Bei Fensterlänge 8 enthält die erste Folge den Wettersatz, sein Ende-Token und „Der Kuchen“, die zweite beginnt mitten im Kuchensatz. Jede Folge liefert eine Aufgabe weniger, als sie Tokens hat, bei 8 Tokens also 7.',
		windowLabel: 'Fensterlänge',
	},
	en: {
		title: 'Several texts, one fixed length',
		intro: 'Two invented texts, each followed by an end token, are joined and cut into sequences. Set the window length and see where the cut separates the texts.',
		note: 'Every word and every full stop counts as one token here, simplified for the overview. The small window lengths are only for the overview; GPT-3 cut sequences of 2048 tokens.',
		solution: 'With their end tokens, the two texts have 13 tokens together. With window length 8, the first sequence holds the weather sentence, its end token and “The cake”, and the second starts in the middle of the cake sentence. Every sequence yields one problem fewer than it has tokens, so 7 for 8 tokens.',
		windowLabel: 'Window length',
	},
}[lang];
const uid = `folg-${lang}`;
---

<Demo lang={lang} id={`folgen-${lang}`} title={copy.title} intro={copy.intro} note={copy.note} origin="simulation" solution={copy.solution}>
	<div class="folg" data-folgen-demo data-lang={lang} data-testid="demo-folgen">
		<div class="kev-demo-range">
			<label class="kev-demo-label" for={`${uid}-window`}>{copy.windowLabel}</label>
			<output for={`${uid}-window`} data-window-value data-testid="demo-folgen-window-value">8</output>
			<input id={`${uid}-window`} type="range" min="3" max="13" step="1" value="8" data-window data-testid="demo-folgen-window" />
		</div>
		<div class="folg-seqs" data-seqs aria-live="polite" data-testid="demo-folgen-seqs"></div>
	</div>
</Demo>

<script>
	import { END, EXAMPLES, packSequences, wordTokens } from '../../scripts/demos/aufgaben.js';

	const TEXT = {
		de: {
			end: 'Ende',
			endLabel: 'Ende-Token',
			seq: (i: number, n: number) => `Folge ${i}: ${n} Tokens, also ${Math.max(0, n - 1)} Aufgaben`,
		},
		en: {
			end: 'End',
			endLabel: 'end token',
			seq: (i: number, n: number) => `Sequence ${i}: ${n} tokens, so ${Math.max(0, n - 1)} problems`,
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-folgen-demo]')) {
		const lang = root.dataset.lang === 'en' ? 'en' : 'de';
		const t = TEXT[lang];
		const windowInput = root.querySelector<HTMLInputElement>('[data-window]')!;
		const windowValue = root.querySelector<HTMLElement>('[data-window-value]')!;
		const seqs = root.querySelector<HTMLElement>('[data-seqs]')!;
		const packed = EXAMPLES[lang].pack.map(wordTokens);

		const chip = (text: string, cls: string, testid: string) => {
			const el = document.createElement('span');
			el.className = `folg-chip ${cls}`;
			el.dataset.testid = testid;
			el.textContent = text;
			return el;
		};

		const render = () => {
			const size = Number(windowInput.value);
			windowValue.textContent = String(size);
			seqs.replaceChildren(
				...packSequences(packed, size).map((seq, s) => {
					const row = document.createElement('div');
					row.dataset.testid = `demo-folgen-seq-${s}`;
					const head = document.createElement('p');
					head.className = 'kev-demo-label folg-head';
					head.textContent = t.seq(s + 1, seq.length);
					const chips = document.createElement('div');
					chips.className = 'folg-stream';
					chips.append(
						...seq.map((p, i) => {
							const isEnd = p.token === END;
							const el = chip(isEnd ? t.end : p.token, isEnd ? 'is-end' : `is-text-${p.text % 2}`, `demo-folgen-seq-${s}-${i}`);
							if (isEnd) el.setAttribute('aria-label', t.endLabel);
							return el;
						}),
					);
					row.append(head, chips);
					return row;
				}),
			);
		};
		windowInput.addEventListener('input', render);
		render();
	}
</script>

<style is:global>
	.folg,
	.folg-seqs {
		display: grid;
		gap: var(--sp-sm);
	}
	.folg-stream {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.folg-head {
		margin: 0 0 4px;
	}
	.folg-chip {
		display: inline-block;
		padding: 4px 9px;
		border: 2px solid var(--line-deep);
		border-radius: var(--r-md);
		background: var(--ground-page);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		white-space: pre;
	}
	.folg-chip.is-end {
		border-color: var(--amber-viv);
		background: var(--demo-c2);
		font-weight: 700;
		font-family: inherit;
		font-size: 0.9rem;
	}
	.folg-chip.is-text-0 {
		border-color: var(--petrol-viv);
	}
	.folg-chip.is-text-1 {
		border-style: dashed;
	}
</style>

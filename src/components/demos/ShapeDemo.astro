---
// Live demo for Baustein 4: the weather example of the text in four steps.
// Today's temperature is one number, the week a row, four cities a table,
// wind and rain on top a stack. Every step names the block (scalar …
// tensor) in plain words; tapping a number shows its address, one entry
// per axis. No free parameters on purpose: the demo retells the text, it
// does not open a new playground. Arithmetic: src/scripts/demos/shape.js.
import Demo from './Demo.astro';

interface Props {
	lang: 'de' | 'en';
}
const { lang } = Astro.props;
const copy = {
	de: {
		title: 'Vom Wetterwert zum Zahlenstapel',
		intro: 'Die vier Schritte aus dem Text zum Anklicken: Jeder Schritt ordnet dieselben Wetterdaten neu an. Tippe danach auf eine Zahl und sieh, welche Angaben nötig sind, um sie zu finden.',
		note: 'Alle Wetterwerte sind ausgedacht. Dein Chat folgt demselben Muster: Jedes Token bringt eine Reihe aus 768 Zahlen mit, fünf Tokens untereinander sind eine Tabelle, und viele Sätze auf einmal ein Stapel.',
		stepsLabel: 'Schritt',
		steps: [
			{ label: 'Heute Mittag', sub: '1 Zahl' },
			{ label: 'Die ganze Woche', sub: '7 Zahlen' },
			{ label: 'Vier Städte', sub: '28 Zahlen' },
			{ label: 'Auch Wind und Regen', sub: '84 Zahlen' },
		],
		measures: ['Temperatur', 'Wind', 'Regen'],
		units: ['°C', 'km/h', 'mm'],
		cities: ['Berlin', 'Hamburg', 'Köln', 'München'],
		days: ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'],
		dayNames: ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'],
	},
	en: {
		title: 'From one weather value to a stack of numbers',
		intro: 'The four steps of the text, clickable: each step arranges the same weather data in a new way. Then tap a number and see which details you need to find it.',
		note: 'All weather values are invented. Your chat follows the same pattern: every token brings a row of 768 numbers, five tokens one below the other form a table, and many sentences at once a stack.',
		stepsLabel: 'Step',
		steps: [
			{ label: 'Today at noon', sub: '1 number' },
			{ label: 'The whole week', sub: '7 numbers' },
			{ label: 'Four cities', sub: '28 numbers' },
			{ label: 'Wind and rain too', sub: '84 numbers' },
		],
		measures: ['Temperature', 'Wind', 'Rain'],
		units: ['°C', 'km/h', 'mm'],
		cities: ['Berlin', 'Hamburg', 'Cologne', 'Munich'],
		days: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
		dayNames: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
	},
}[lang];
const uid = `shp-${lang}`;
const data = {
	measures: copy.measures,
	units: copy.units,
	cities: copy.cities,
	days: copy.days,
	dayNames: copy.dayNames,
};
---

<Demo lang={lang} id={`shape-${lang}`} title={copy.title} intro={copy.intro} note={copy.note}>
	<div class="shp" data-shape-demo data-lang={lang} data-config={JSON.stringify(data)} data-testid="demo-shape">
		<fieldset class="shp-steps" data-testid="demo-shape-steps">
			<legend class="kev-demo-label">{copy.stepsLabel}</legend>
			{copy.steps.map((step, i) => (
				<label class="shp-step">
					<input type="radio" name={`${uid}-step`} value={i} checked={i === 0} data-step data-testid={`demo-shape-step-${i}`} />
					<span class="shp-step-num" aria-hidden="true">{i + 1}</span>
					<span class="shp-step-text">
						<span class="shp-step-label">{step.label}</span>
						<span class="shp-step-sub">{step.sub}</span>
					</span>
				</label>
			))}
		</fieldset>

		<div class="shp-readout" aria-live="polite" aria-atomic="true" data-testid="demo-shape-readout">
			<p class="shp-name" data-name data-testid="demo-shape-name"></p>
			<p class="shp-plain" data-plain data-testid="demo-shape-plain"></p>
			<p class="shp-shape" data-shape data-testid="demo-shape-form"></p>
		</div>

		<div class="shp-stage-wrap">
			<div class="shp-stage" data-stage data-testid="demo-shape-stage"></div>
		</div>
		<p class="kev-demo-hint shp-flip" data-flip hidden data-testid="demo-shape-flip-hint"></p>

		<p class="shp-address" data-address aria-live="polite" data-testid="demo-shape-address"></p>
	</div>
</Demo>

<script>
	import { STEPS, formatNumber, formatShape, nameOf, shapeOf, weatherValue } from '../../scripts/demos/shape.js';

	type Config = { measures: string[]; units: string[]; cities: string[]; days: string[]; dayNames: string[] };
	const TEXT = {
		de: {
			plain: [
				'Eine einzelne Zahl. Um sie zu finden, brauchst du keine Angabe.',
				'Eine Reihe von Zahlen. Um eine zu finden, brauchst du eine Angabe: den Tag.',
				'Eine Tabelle. Um eine Zahl zu finden, brauchst du zwei Angaben: Stadt und Tag.',
				'Ein Stapel aus drei Tabellen. Um eine Zahl zu finden, brauchst du drei Angaben: Messgröße, Stadt und Tag.',
			],
			form: (shape: string, count: string) => `Form ${shape} · ${count}`,
			numbers: (n: string) => `${n} Zahlen`,
			one: '1 Zahl',
			axisNames: ['Messgröße', 'Stadt', 'Tag'],
			hover: 'Tippe auf eine Zahl, um ihre Adresse zu sehen.',
			flip: 'Tippe auf Wind oder Regen, um die Tabelle nach vorn zu holen.',
			needs: (n: number) => (n === 0 ? 'keine Angabe nötig' : n === 1 ? '1 Angabe nötig' : `${n} Angaben nötig`),
		},
		en: {
			plain: [
				'A single number. To find it, you need no details at all.',
				'A row of numbers. To find one, you need one detail: the day.',
				'A table. To find a number, you need two details: city and day.',
				'A stack of three tables. To find a number, you need three details: measure, city and day.',
			],
			form: (shape: string, count: string) => `Shape ${shape} · ${count}`,
			numbers: (n: string) => `${n} numbers`,
			one: '1 number',
			axisNames: ['measure', 'city', 'day'],
			hover: 'Tap a number to see its address.',
			flip: 'Tap Wind or Rain to bring that table to the front.',
			needs: (n: number) => (n === 0 ? 'no detail needed' : n === 1 ? '1 detail needed' : `${n} details needed`),
		},
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-shape-demo]')) {
		const lang = root.dataset.lang === 'en' ? 'en' : 'de';
		const t = TEXT[lang];
		const cfg = JSON.parse(root.dataset.config ?? '{}') as Config;
		const stage = root.querySelector<HTMLElement>('[data-stage]')!;
		const nameOut = root.querySelector<HTMLElement>('[data-name]')!;
		const plainOut = root.querySelector<HTMLElement>('[data-plain]')!;
		const shapeOut = root.querySelector<HTMLElement>('[data-shape]')!;
		const address = root.querySelector<HTMLElement>('[data-address]')!;
		const flipHint = root.querySelector<HTMLElement>('[data-flip]')!;
		flipHint.textContent = t.flip;

		let step = 0;
		let picked: number[] | null = null;
		let front = 0; // the sheet on top of the stack

		const dims = () => STEPS[step];
		const labels = () => [cfg.measures, cfg.cities, cfg.dayNames];

		const describe = (coords: number[]) => {
			const [layer, row, col] = coords;
			const parts = dims()
				.map((n, axis) => (n > 1 ? `${t.axisNames[axis]} ${labels()[axis][coords[axis]]}` : null))
				.filter(Boolean);
			const value = `${weatherValue(layer, row, col)} ${cfg.units[layer]}`;
			const needs = t.needs(parts.length);
			return parts.length ? `${parts.join(' · ')} → ${value} (${needs})` : `${value} (${needs})`;
		};

		const highlight = (coords: number[] | null) => {
			for (const cell of stage.querySelectorAll<HTMLElement>('[data-cell]')) {
				const c = cell.dataset.cell!.split(',').map(Number);
				const hit = !!coords && c[0] === coords[0] && c[1] === coords[1] && c[2] === coords[2];
				cell.classList.toggle('is-hit', hit);
				cell.classList.toggle('is-row', !!coords && c[0] === coords[0] && c[1] === coords[1] && !hit);
				cell.classList.toggle('is-col', !!coords && c[0] === coords[0] && c[2] === coords[2] && !hit);
			}
			address.textContent = coords ? describe(coords) : t.hover;
			address.classList.toggle('is-set', !!coords);
		};

		const renderStage = () => {
			const [L, R, C] = dims();
			stage.style.setProperty('--layers', String(L));
			flipHint.hidden = L === 1;
			// Display order: the chosen sheet in front, the others behind it.
			const order = [front, ...Array.from({ length: L }, (_, i) => i).filter((i) => i !== front)];
			stage.replaceChildren(
				...Array.from({ length: L }, (_, layer) => {
					const sheet = document.createElement('div');
					sheet.className = 'shp-sheet';
					sheet.dataset.testid = `demo-shape-sheet-${layer}`;
					sheet.style.setProperty('--z', String(order.indexOf(layer)));
					if (L > 1) {
						const tag = document.createElement('button');
						tag.type = 'button';
						tag.className = 'shp-sheet-tag';
						tag.dataset.testid = `demo-shape-sheet-${layer}-tag`;
						tag.textContent = cfg.measures[layer];
						tag.setAttribute('aria-pressed', String(layer === front));
						tag.addEventListener('click', () => {
							if (front === layer) return;
							front = layer;
							renderStage();
						});
						sheet.append(tag);
					}
					const grid = document.createElement('div');
					grid.className = 'shp-grid';
					grid.style.setProperty('--cols', String(C + 1));
					grid.append(document.createElement('span'));
					for (let col = 0; col < C; col += 1) {
						const h = document.createElement('span');
						h.className = 'shp-head';
						h.textContent = C > 1 ? cfg.days[col] : '';
						grid.append(h);
					}
					for (let row = 0; row < R; row += 1) {
						const rh = document.createElement('span');
						rh.className = 'shp-head shp-head--row';
						rh.textContent = R > 1 ? cfg.cities[row] : '';
						grid.append(rh);
						for (let col = 0; col < C; col += 1) {
							const cell = document.createElement('button');
							cell.type = 'button';
							cell.className = 'shp-cell';
							cell.style.setProperty('--i', String(row * C + col));
							cell.dataset.cell = `${layer},${row},${col}`;
							cell.dataset.testid = `demo-shape-cell-${layer}-${row}-${col}`;
							cell.textContent = String(weatherValue(layer, row, col));
							cell.setAttribute('aria-label', describe([layer, row, col]));
							cell.addEventListener('pointerenter', () => highlight([layer, row, col]));
							cell.addEventListener('pointerleave', () => highlight(picked));
							cell.addEventListener('click', () => {
								picked = [layer, row, col];
								highlight(picked);
							});
							grid.append(cell);
						}
					}
					sheet.append(grid);
					return sheet;
				}),
			);
			highlight(picked);
		};

		const renderReadout = () => {
			const { dims: shown, axes, count } = shapeOf(dims());
			nameOut.textContent = nameOf(axes, lang);
			nameOut.classList.remove('kev-demo-flash');
			void nameOut.offsetWidth;
			nameOut.classList.add('kev-demo-flash');
			plainOut.textContent = t.plain[step];
			shapeOut.textContent = t.form(formatShape(shown, lang), count === 1 ? t.one : t.numbers(formatNumber(count, lang)));
		};

		root.querySelectorAll<HTMLInputElement>('[data-step]').forEach((r) =>
			r.addEventListener('change', () => {
				if (!r.checked) return;
				step = Number(r.value);
				picked = null;
				front = 0;
				renderStage();
				renderReadout();
			}),
		);

		renderStage();
		renderReadout();
	}
</script>

<style is:global>
	.shp {
		display: grid;
		gap: var(--sp-md);
	}
	.shp-steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		border: 0;
	}
	.shp-steps legend {
		grid-column: 1 / -1;
		padding: 0;
		margin-bottom: 2px;
	}
	.shp-step {
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		border: 1.5px solid var(--line-deep);
		border-radius: var(--r-md);
		background: var(--ground-page);
		cursor: pointer;
		transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
	}
	.shp-step:hover {
		border-color: var(--petrol-viv);
	}
	.shp-step input {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}
	.shp-step:has(input:checked) {
		background: var(--demo-c1);
		border-color: var(--petrol-deep);
	}
	.shp-step:has(input:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
	.shp-step-num {
		display: grid;
		place-items: center;
		flex: none;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 50%;
		background: var(--line-deep);
		color: var(--ink);
		font-size: 0.85rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.shp-step:has(input:checked) .shp-step-num {
		background: var(--petrol-deep);
		color: var(--ground-page);
	}
	.shp-step-text {
		display: grid;
		gap: 1px;
		min-width: 0;
	}
	.shp-step-label {
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.25;
	}
	.shp-step-sub {
		font-size: 0.78rem;
		color: var(--ink-muted);
		font-variant-numeric: tabular-nums;
	}
	.shp-readout {
		display: grid;
		gap: 4px;
		padding: 12px 14px;
		border-left: 3px solid var(--petrol-viv);
		background: var(--demo-c1);
		border-radius: 0 var(--r-md) var(--r-md) 0;
	}
	.shp-name {
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1.1;
		color: var(--petrol-deep);
		display: inline-block;
		transform-origin: left center;
	}
	.shp-plain {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.45;
	}
	.shp-shape {
		font-size: 0.9rem;
		color: var(--ink-muted);
		font-variant-numeric: tabular-nums;
	}
	.shp-stage-wrap {
		min-width: 0;
		overflow-x: auto;
		padding: 4px 4px 12px;
	}
	.shp-stage {
		position: relative;
		display: grid;
		padding: calc((var(--layers) - 1) * 22px) 0 0 calc((var(--layers) - 1) * 16px);
	}
	.shp-sheet {
		grid-area: 1 / 1;
		position: relative;
		/* `translate`, not `transform`: the pop animation owns `transform`. */
		translate: calc(var(--z) * -16px) calc(var(--z) * -22px);
		z-index: calc(10 - var(--z));
		background: var(--ground-page);
		border: 1px solid var(--line-deep);
		border-radius: var(--r-md);
		padding: 10px;
		box-shadow: 0 10px 24px rgba(3, 39, 35, 0.1);
		animation: kev-demo-pop 0.35s ease both;
		animation-delay: calc(var(--z) * 60ms);
		width: max-content;
		max-width: 100%;
	}
	.shp-sheet-tag {
		position: absolute;
		top: -12px;
		left: 10px;
		padding: 3px 12px;
		border: 0;
		border-radius: var(--r-pill);
		background: var(--amber-soft);
		color: var(--amber-deep);
		font: inherit;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(3, 39, 35, 0.15);
	}
	.shp-sheet-tag[aria-pressed='true'] {
		background: var(--amber-viv);
		color: var(--ink);
	}
	.shp-sheet-tag:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
	.shp-flip {
		margin-top: -6px;
	}
	.shp-flip[hidden] {
		display: none;
	}
	.shp-grid {
		display: grid;
		grid-template-columns: auto repeat(calc(var(--cols) - 1), minmax(2.2rem, auto));
		gap: 4px;
		align-items: center;
	}
	.shp-head {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-muted);
		text-align: center;
		white-space: nowrap;
	}
	.shp-head--row {
		text-align: right;
		padding-right: 6px;
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.8rem;
	}
	.shp-cell {
		display: grid;
		place-items: center;
		min-height: 2.2rem;
		padding: 0 6px;
		border: 0;
		border-radius: 6px;
		background: var(--demo-c1);
		font: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--ink);
		cursor: pointer;
		transition: background-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}
	.shp-cell:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
	.shp-cell.is-row,
	.shp-cell.is-col {
		background: var(--demo-c2);
	}
	.shp-cell.is-hit {
		background: var(--petrol-deep);
		color: var(--ground-page);
		transform: scale(1.12);
		box-shadow: 0 6px 16px rgba(3, 39, 35, 0.25);
		z-index: 1;
	}
	.shp-address {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.4;
		min-height: 1.6em;
		padding: 10px 14px;
		background: var(--ground-page);
		border-left: 3px solid var(--line-deep);
		border-radius: 0 var(--r-md) var(--r-md) 0;
		color: var(--ink-muted);
	}
	.shp-address.is-set {
		border-left-color: var(--amber-viv);
		color: var(--ink);
	}
	@media (max-width: 640px) {
		.shp-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>

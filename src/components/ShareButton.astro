---
// "Share this page" as a plain pill button for the support placements
// (end-of-Baustein support block, the Warum page). Same behaviour as the
// share action in the Baustein toolbar (BausteinActions.astro): the native
// share sheet where it exists, else the URL goes to the clipboard and the
// label confirms it for a moment. Binds per `[data-share-page]`, so several
// instances on one page work side by side.
interface Props {
	lang: 'de' | 'en';
	/** Matomo event name (what was shared from where), e.g. the Baustein key. */
	track?: string;
	class?: string;
}

const { lang, track = 'Seite', class: className = 'btn btn-secondary' } = Astro.props;

const copy = {
	de: { label: 'Seite teilen', copied: 'Link kopiert' },
	en: { label: 'Share this page', copied: 'Link copied' },
}[lang];
---

<button type="button" class={className} data-share-page data-track={track} data-copied={copy.copied}>
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="18" cy="5" r="3"></circle>
		<circle cx="6" cy="12" r="3"></circle>
		<circle cx="18" cy="19" r="3"></circle>
		<path d="m8.59 13.51 6.83 3.98"></path>
		<path d="m15.41 6.51-6.82 3.98"></path>
	</svg>
	<span data-share-label>{copy.label}</span>
</button>

<script>
	import { trackEvent } from '../lib/matomo';

	document.querySelectorAll<HTMLButtonElement>('[data-share-page]').forEach((btn) => {
		const label = btn.querySelector<HTMLElement>('[data-share-label]');
		btn.addEventListener('click', async () => {
			trackEvent('Unterstützen', 'Geteilt', btn.dataset.track);
			if (navigator.share) {
				try {
					await navigator.share({ title: document.title, url: location.href });
				} catch {
					/* the reader closed the share sheet */
				}
				return;
			}
			if (!navigator.clipboard || !label) return;
			try {
				await navigator.clipboard.writeText(location.href);
				const original = label.textContent;
				label.textContent = btn.dataset.copied ?? original;
				window.setTimeout(() => {
					label.textContent = original;
				}, 1600);
			} catch {
				/* clipboard unavailable -- the link stays in the address bar */
			}
		});
	});
</script>

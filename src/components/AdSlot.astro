---
// One discreet, labelled ad placement. Renders nothing at all when ads are
// off (staging) or the slot has no unit id yet, so the layout never carries
// an empty box. The frame reserves a minimum height so a late-loading ad
// does not push the text around while someone is reading.
import { ADSENSE_CLIENT, ADS_ENABLED, AD_SLOTS } from '../lib/ads';

interface Props {
	lang: 'de' | 'en';
	slot: keyof typeof AD_SLOTS;
}

const { lang, slot } = Astro.props;
const unit = AD_SLOTS[slot];
const label = lang === 'de' ? 'Anzeige' : 'Advertisement';
---

{
	ADS_ENABLED && unit && (
		<aside class="ad" aria-label={label}>
			<span class="ad-label">{label}</span>
			<ins
				class="adsbygoogle"
				style="display:block"
				data-ad-client={ADSENSE_CLIENT}
				data-ad-slot={unit}
				data-ad-format="auto"
				data-full-width-responsive="true"
			/>
			<script is:inline>
				(window.adsbygoogle = window.adsbygoogle || []).push({});
			</script>
		</aside>
	)
}

<style>
	/* Same book column as the running text (ContentEntryLayout's --measure;
	   the fallback covers pages without it, e.g. the homepage). justify-self
	   centres it inside the article grid's content track exactly like .prose. */
	.ad {
		box-sizing: border-box;
		width: min(100%, var(--measure, 40rem));
		margin: var(--sp-xl) auto;
		justify-self: center;
		padding: var(--sp-sm) 0 var(--sp-md);
		border-top: 1px solid transparent;
		border-bottom: 1px solid transparent;
	}
	/* The slot must keep its width while the request is pending (AdSense
	   refuses zero-width slots), so the frame stays in flow but silent: the
	   label and hairlines only appear once an ad is actually filled, and a
	   slot AdSense could not fill (review pending, blocked, no demand)
	   collapses so the page never shows an empty, labelled band. */
	.ad-label {
		display: none;
	}
	.ad:has(ins[data-ad-status='filled']) {
		border-color: var(--line);
	}
	.ad:has(ins[data-ad-status='filled']) .ad-label {
		display: block;
	}
	.ad:has(ins[data-ad-status='unfilled']) {
		display: none;
	}
	.ad-label {
		margin-bottom: var(--sp-xs);
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	@media print {
		.ad {
			display: none;
		}
	}
</style>

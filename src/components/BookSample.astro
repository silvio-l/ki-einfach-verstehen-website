---
// "Blick ins Buch": a reading sample made of real typeset pages of the
// paperback behind the front cover (title page, contents with the sample's
// entries marked, preface, part I and the opening of chapter 1), like
// Amazon's "Look inside". Pages and manifest are generated
// by packages/ebook/scripts/build-sample.mjs from the print PDF; rerun it
// after the typesetting changes.
//
// The page images carry the text only as pixels, so the dialog links the same
// chapter on the website, where it is real, accessible text. The zoom (button
// or double click/tap on the page) swaps in the page at twice the resolution,
// loaded only then, and lets the reader pan it inside the page frame.
//
// Progressive enhancement: without JS the open button stays hidden and the
// teaser card (first chapter page) is just a picture.
import sampleDe from '../data/book-sample.de.json';
import sampleEn from '../data/book-sample.en.json';
import { getPublished } from '../data/published';

interface Props {
	lang: 'de' | 'en';
}

const { lang } = Astro.props;
const sample = { de: sampleDe, en: sampleEn }[lang];
// Chapter 1 of the book is the first Baustein of Themenbereich 1.
const firstChapter = (await getPublished(lang)).find((b) => b.key === 'grundlagen:1');
const teaser = sample.pages.find((page) => page.section === 'chapter') ?? sample.pages[0];

const copy = {
	de: {
		title: 'Blick ins Buch',
		lead: 'Blättere durch die ersten Seiten, so wie sie im Buch stehen: Cover, Titelei, das vollständige Inhaltsverzeichnis, Vorwort und der Anfang von Kapitel 1.',
		open: 'Leseprobe öffnen',
		pages: (n: number) => `${n} Seiten`,
		dialog: 'Leseprobe',
		close: 'Schließen',
		prev: 'Vorherige Seite',
		next: 'Nächste Seite',
		zoomIn: 'Seite vergrößern',
		zoomOut: 'Vergrößerung beenden',
		counter: 'Seite {i} von {n}',
		alt: (label: string, i: number) => `Buchseite ${i} der Leseprobe: ${label}`,
		online: 'Kapitel 1 komplett und kostenlos online lesen',
	},
	en: {
		title: 'Look inside',
		lead: 'Leaf through the first pages exactly as they appear in the book: cover, front matter, the full contents, preface and the opening of Chapter 1.',
		open: 'Open the sample',
		pages: (n: number) => `${n} pages`,
		dialog: 'Reading sample',
		close: 'Close',
		prev: 'Previous page',
		next: 'Next page',
		zoomIn: 'Zoom in on the page',
		zoomOut: 'Zoom out',
		counter: 'Page {i} of {n}',
		alt: (label: string, i: number) => `Book page ${i} of the sample: ${label}`,
		online: 'Read all of Chapter 1 online for free',
	},
}[lang];

const pages = sample.pages.map((page, index) => ({ ...page, alt: copy.alt(page.label, index + 1) }));
---

<section class="story-section book-sample" data-book-sample data-testid="book-sample">
	<h2>{copy.title}</h2>
	<div class="book-sample-teaser">
		<img
			class="book-sample-thumb"
			src={teaser.src}
			alt=""
			width={sample.width}
			height={sample.height}
			loading="lazy"
			decoding="async"
		/>
		<div class="book-sample-text">
			<p>{copy.lead}</p>
			<button type="button" class="btn btn-primary" data-sample-open data-testid="book-sample-open" hidden>
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z"></path>
					<path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"></path>
				</svg>
				<span>{copy.open}</span>
				<span class="book-sample-count">({copy.pages(pages.length)})</span>
			</button>
		</div>
	</div>

	<dialog class="book-sample-dialog" aria-label={copy.dialog} data-sample-dialog data-testid="book-sample-dialog">
		<div class="book-sample-page" data-sample-stage>
			<img alt="" width={sample.width} height={sample.height} data-sample-img data-testid="book-sample-page" />
		</div>
		<div class="book-sample-bar">
			<button type="button" class="book-sample-nav" aria-label={copy.prev} data-sample-prev data-testid="book-sample-prev">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
			</button>
			<p class="book-sample-counter" aria-live="polite" data-sample-counter data-template={copy.counter}></p>
			<button type="button" class="book-sample-nav" aria-label={copy.next} data-sample-next data-testid="book-sample-next">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
			</button>
			<button
				type="button"
				class="book-sample-nav"
				aria-label={copy.zoomIn}
				aria-pressed="false"
				data-sample-zoom
				data-label-in={copy.zoomIn}
				data-label-out={copy.zoomOut}
				data-testid="book-sample-zoom"
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="11" cy="11" r="6"></circle>
					<path d="M20 20l-4.5-4.5M8.5 11h5"></path>
					<path d="M11 8.5v5" data-zoom-plus></path>
				</svg>
			</button>
			<button type="button" class="book-sample-close" aria-label={copy.close} data-sample-close data-testid="book-sample-close">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
			</button>
		</div>
		{
			firstChapter && (
				<p class="book-sample-online">
					<a href={firstChapter.href} data-testid="book-sample-online">
						{copy.online}
					</a>
				</p>
			)
		}
	</dialog>
	<script type="application/json" data-sample-pages set:html={JSON.stringify(pages.map(({ src, zoom, alt, label }) => ({ src, zoom, alt, label })))} />
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-book-sample]').forEach((root) => {
		const open = root.querySelector<HTMLButtonElement>('[data-sample-open]');
		const dialog = root.querySelector<HTMLDialogElement>('[data-sample-dialog]');
		const img = root.querySelector<HTMLImageElement>('[data-sample-img]');
		const stage = root.querySelector<HTMLElement>('[data-sample-stage]');
		const counter = root.querySelector<HTMLElement>('[data-sample-counter]');
		const prev = root.querySelector<HTMLButtonElement>('[data-sample-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-sample-next]');
		const zoom = root.querySelector<HTMLButtonElement>('[data-sample-zoom]');
		const data = root.querySelector('[data-sample-pages]');
		if (!open || !dialog || !img || !stage || !counter || !prev || !next || !zoom || !data) return;
		const pages: { src: string; zoom: string; alt: string; label: string }[] = JSON.parse(data.textContent ?? '[]');
		let index = 0;
		let zoomed = false;

		// Zoomed, the frame keeps the page's normal height and the image
		// inside it is twice as wide; the frame scrolls (pans) in both axes.
		function setZoom(on: boolean, at?: { x: number; y: number }) {
			if (on && !zoomed) stage!.style.height = `${stage!.clientHeight}px`;
			zoomed = on;
			stage!.classList.toggle('is-zoomed', on);
			if (!on) stage!.style.height = '';
			img!.src = on ? pages[index].zoom : pages[index].src;
			zoom!.setAttribute('aria-pressed', String(on));
			zoom!.setAttribute('aria-label', (on ? zoom!.dataset.labelOut : zoom!.dataset.labelIn) ?? '');
			// Keep the spot under the pointer (or the top centre) in view.
			const fx = at ? at.x : 0.5;
			const fy = at ? at.y : 0;
			if (on) stage!.scrollTo(fx * stage!.scrollWidth - stage!.clientWidth / 2, fy * stage!.scrollHeight - stage!.clientHeight / 2);
		}

		function show(i: number) {
			index = Math.max(0, Math.min(pages.length - 1, i));
			img!.src = zoomed ? pages[index].zoom : pages[index].src;
			if (zoomed) stage!.scrollTo(stage!.scrollLeft, 0);
			img!.alt = pages[index].alt;
			counter!.textContent = `${(counter!.dataset.template ?? '').replace('{i}', String(index + 1)).replace('{n}', String(pages.length))} · ${pages[index].label}`;
			prev!.disabled = index === 0;
			next!.disabled = index === pages.length - 1;
			// Warm the cache for the next page so turning feels instant.
			if (pages[index + 1]) new Image().src = pages[index + 1].src;
		}

		open.addEventListener('click', () => {
			show(index);
			dialog.showModal();
		});
		prev.addEventListener('click', () => show(index - 1));
		next.addEventListener('click', () => show(index + 1));
		zoom.addEventListener('click', () => setZoom(!zoomed));
		stage.addEventListener('dblclick', (e) => {
			const box = img.getBoundingClientRect();
			setZoom(!zoomed, { x: (e.clientX - box.left) / box.width, y: (e.clientY - box.top) / box.height });
		});
		dialog.addEventListener('close', () => setZoom(false));
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(index - 1);
			else if (e.key === 'ArrowRight') show(index + 1);
			else return;
			e.preventDefault();
		});
		// Swipe left/right on touch screens turns the page; zoomed, the same
		// gesture pans the page instead.
		let startX: number | null = null;
		stage.addEventListener('pointerdown', (e) => (startX = e.clientX));
		stage.addEventListener('pointerup', (e) => {
			if (startX === null || zoomed) return;
			const dx = e.clientX - startX;
			startX = null;
			if (Math.abs(dx) > 40) show(index + (dx < 0 ? 1 : -1));
		});
		root.querySelector('[data-sample-close]')?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
		open.hidden = false;
	});
</script>

<style>
	.book-sample-teaser {
		display: flex;
		align-items: center;
		gap: var(--sp-lg);
	}
	.book-sample-thumb {
		flex: none;
		width: 9rem;
		height: auto;
		border-radius: 3px;
		/* A page is paper in both site themes. */
		background: #fff;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.18),
			0 8px 24px rgba(0, 0, 0, 0.18);
		transform: rotate(-2deg);
	}
	.book-sample-text p {
		margin-bottom: var(--sp-sm);
	}
	.book-sample-text .btn[hidden] {
		display: none;
	}
	.book-sample-text .btn {
		min-height: var(--hit-min);
		padding: 10px 24px;
	}
	.book-sample-count {
		font-weight: 400;
		opacity: 0.8;
	}
	@media (max-width: 560px) {
		.book-sample-teaser {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--sp-md);
		}
		.book-sample-thumb {
			width: 7rem;
		}
	}

	/* ——— Viewer (same dialog look as the cover magnifier) ——— */
	.book-sample-dialog {
		margin: auto;
		padding: 0;
		border: 0;
		border-radius: var(--r-lg);
		background: #0a0a0a;
		color: #f2ede0;
		/* As wide as a 2:3 page at the height left for it. */
		width: min(92vw, 640px, calc((94vh - 110px) * 2 / 3));
		max-width: none;
		max-height: 94vh;
		overflow: hidden;
	}
	.book-sample-dialog::backdrop {
		background: rgba(2, 22, 19, 0.82);
	}
	.book-sample-page {
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}
	.book-sample-page img {
		display: block;
		width: 100%;
		height: auto;
		background: #fff;
	}
	.book-sample-page.is-zoomed {
		overflow: auto;
		touch-action: pan-x pan-y;
		overscroll-behavior: contain;
		background: #fff;
	}
	.book-sample-page.is-zoomed img {
		width: 200%;
		max-width: none;
	}
	.book-sample-page:not(.is-zoomed) {
		cursor: zoom-in;
	}
	.book-sample-page.is-zoomed {
		cursor: zoom-out;
	}
	.book-sample-nav[aria-pressed='true'] [data-zoom-plus] {
		display: none;
	}
	.book-sample-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-sm);
		padding: 10px 12px 4px;
	}
	.book-sample-counter {
		margin: 0;
		font-size: 0.9rem;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}
	.book-sample-nav,
	.book-sample-close {
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: var(--r-pill);
		/* Fixed brand colours: these sit on the dark dialog in both site themes. */
		background: rgba(242, 237, 224, 0.94);
		color: #042723;
		cursor: pointer;
	}
	.book-sample-nav:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.book-sample-counter {
		flex: 1;
	}
	.book-sample-nav svg,
	.book-sample-close svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.book-sample-nav:focus-visible,
	.book-sample-close:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	.book-sample-online {
		margin: 0;
		padding: 4px 16px 12px;
		font-size: 0.875rem;
		line-height: 1.4;
		text-align: center;
		opacity: 0.85;
	}
	.book-sample-online a {
		color: inherit;
	}
</style>

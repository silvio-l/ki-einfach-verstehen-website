---
interface QuizQuestion {
	id: string;
	frage: string;
	optionen: string[];
	richtig: number;
	erklaerung?: string;
}

interface Props {
	lang: 'de' | 'en';
	translationKey: string;
	questions: QuizQuestion[];
}

const { lang, translationKey, questions } = Astro.props;
const copy = {
	de: {
		eyebrow: 'Abrufmoment',
		title: 'Was ist hängen geblieben?',
		intro: 'Beantworte die Fragen ohne zurückzuscrollen. Es geht nicht um eine Note, sondern darum, das Gelernte einmal aus dem Gedächtnis abzurufen. Sobald du eine Antwort anklickst, siehst du, ob sie stimmt.',
		loading: 'Fragen werden vorbereitet …',
		noJs: 'Für das interaktive Quiz muss JavaScript aktiviert sein.',
		next: 'Nächste Frage',
		finish: 'Auswertung anzeigen',
	},
	en: {
		eyebrow: 'Recall moment',
		title: 'What stayed with you?',
		intro: 'Answer without scrolling back. This is not a grade; the point is to retrieve what you learned from memory once. As soon as you pick an answer, you see whether it is right.',
		loading: 'Preparing questions …',
		noJs: 'JavaScript needs to be enabled for the interactive quiz.',
		next: 'Next question',
		finish: 'Show results',
	},
}[lang];
---

<section
	class="retrieval-quiz"
	data-retrieval-quiz
	data-lang={lang}
	data-translation-key={translationKey}
	data-questions={JSON.stringify(questions)}
	aria-labelledby={`quiz-${translationKey}`}
>
	<header class="quiz-head">
		<p class="quiz-eyebrow">{copy.eyebrow}</p>
		<h2 id={`quiz-${translationKey}`}>{copy.title}</h2>
		<p>{copy.intro}</p>
	</header>

	<p class="quiz-status" data-quiz-status aria-live="polite">{copy.loading}</p>

	<form class="quiz-form" data-quiz-form hidden>
		<fieldset>
			<legend>
				<span class="quiz-counter" data-quiz-counter></span>
				<span class="quiz-question" data-quiz-question></span>
			</legend>
			<div class="quiz-options" data-quiz-options></div>
		</fieldset>
		<p class="quiz-feedback" data-quiz-feedback aria-live="polite" hidden></p>
		<div class="quiz-actions">
			<button class="btn btn-primary" type="button" data-quiz-next data-next={copy.next} data-finish={copy.finish} hidden>{copy.next}</button>
		</div>
	</form>

	<div class="quiz-summary" data-quiz-summary hidden>
		<p class="quiz-score" data-quiz-score aria-live="polite"></p>
		<ol class="quiz-review" data-quiz-review></ol>
		<p class="quiz-status" data-quiz-schedule></p>
		<div class="quiz-actions" data-quiz-restart-actions></div>
	</div>

	<noscript><p class="quiz-status">{copy.noJs}</p></noscript>
</section>

<script>
	import {
		isQuestionDue,
		nextDueAt,
		optionOrder,
		readQuizProgress,
		recordAnswer,
		writeQuizProgress,
	} from '../scripts/quiz-progress.js';

	type Question = { id: string; frage: string; optionen: string[]; richtig: number; erklaerung?: string };
	type Answer = { question: Question; selected: number; correct: boolean };

	const roots = document.querySelectorAll<HTMLElement>('[data-retrieval-quiz]');

	for (const root of roots) {
		const lang = root.dataset.lang === 'en' ? 'en' : 'de';
		const translationKey = root.dataset.translationKey ?? '';
		const questions = JSON.parse(root.dataset.questions ?? '[]') as Question[];
		const ui = lang === 'de'
			? {
				question: (current: number, total: number) => `Frage ${current} von ${total}`,
				correct: 'Richtig.',
				incorrect: 'Leider falsch.',
				correctAnswer: (answer: string) => `Richtig wäre: „${answer}“${/[.!?]$/.test(answer) ? '' : '.'}`,
				yourAnswer: 'Deine Antwort',
				rightAnswer: 'Richtige Antwort',
				score: (right: number, total: number) => `${right} von ${total} ${total === 1 ? 'Frage' : 'Fragen'} richtig.`,
				allRight: 'Alles sitzt.',
				someWrong: 'Schau dir die falsch beantworteten Fragen unten noch einmal an.',
				nothingDue: 'Alle Fragen dieses Bausteins hast du kürzlich richtig beantwortet.',
				nextReview: (date: string) => `Die nächste kurze Wiederholung wird am ${date} fällig.`,
				retryWrong: 'Falsche wiederholen',
				retryAll: 'Alle Fragen noch einmal',
				storageError: 'Hinweis: Der Fortschritt konnte in diesem Browser nicht gespeichert werden.',
			}
			: {
				question: (current: number, total: number) => `Question ${current} of ${total}`,
				correct: 'Correct.',
				incorrect: 'Not quite.',
				correctAnswer: (answer: string) => `The right answer is “${answer}”${/[.!?]$/.test(answer) ? '' : '.'}`,
				yourAnswer: 'Your answer',
				rightAnswer: 'Right answer',
				score: (right: number, total: number) => `${right} of ${total} ${total === 1 ? 'question' : 'questions'} right.`,
				allRight: 'Everything stuck.',
				someWrong: 'Have another look at the questions you missed below.',
				nothingDue: 'You recently answered every question in this lesson correctly.',
				nextReview: (date: string) => `The next short review is due on ${date}.`,
				retryWrong: 'Retry the missed ones',
				retryAll: 'All questions again',
				storageError: 'Note: progress could not be saved in this browser.',
			};

		const form = root.querySelector<HTMLFormElement>('[data-quiz-form]');
		const status = root.querySelector<HTMLElement>('[data-quiz-status]');
		const counter = root.querySelector<HTMLElement>('[data-quiz-counter]');
		const questionText = root.querySelector<HTMLElement>('[data-quiz-question]');
		const options = root.querySelector<HTMLElement>('[data-quiz-options]');
		const feedback = root.querySelector<HTMLElement>('[data-quiz-feedback]');
		const next = root.querySelector<HTMLButtonElement>('[data-quiz-next]');
		const summary = root.querySelector<HTMLElement>('[data-quiz-summary]');
		const score = root.querySelector<HTMLElement>('[data-quiz-score]');
		const review = root.querySelector<HTMLOListElement>('[data-quiz-review]');
		const schedule = root.querySelector<HTMLElement>('[data-quiz-schedule]');
		const restartActions = root.querySelector<HTMLElement>('[data-quiz-restart-actions]');
		if (!form || !status || !counter || !questionText || !options || !feedback || !next || !summary || !score || !review || !schedule || !restartActions) continue;

		let progress = readQuizProgress();
		let round: Question[] = [];
		let answers: Answer[] = [];
		let current = 0;
		let storageFailed = false;

		const formatDate = (date: Date) =>
			new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { dateStyle: 'long' }).format(date);

		const scheduleText = () => {
			const due = nextDueAt(progress, translationKey, questions);
			const parts = [due ? ui.nextReview(formatDate(due)) : '', storageFailed ? ui.storageError : ''];
			return parts.filter(Boolean).join(' ');
		};

		const button = (label: string, primary: boolean, onClick: () => void) => {
			const el = document.createElement('button');
			el.type = 'button';
			el.className = `btn ${primary ? 'btn-primary' : 'btn-secondary'}`;
			el.textContent = label;
			el.addEventListener('click', onClick);
			return el;
		};

		const start = (set: Question[]) => {
			round = set;
			answers = [];
			current = 0;
			summary.hidden = true;
			status.hidden = true;
			renderQuestion();
		};

		const showSummary = () => {
			form.hidden = true;
			status.hidden = true;
			summary.hidden = false;
			const right = answers.filter((a) => a.correct).length;
			try {
				// One event per finished round; value = correct answers.
				(window as any)._paq?.push(['trackEvent', 'Quiz', 'Runde beendet', translationKey, right]);
			} catch {
				/* tracking best-effort */
			}
			score.textContent = `${ui.score(right, answers.length)} ${right === answers.length ? ui.allRight : ui.someWrong}`;
			score.dataset.result = right === answers.length ? 'correct' : 'incorrect';
			review.replaceChildren(...answers.map(({ question, selected, correct }) => {
				const item = document.createElement('li');
				item.dataset.result = correct ? 'correct' : 'incorrect';
				const head = document.createElement('p');
				head.className = 'quiz-review-question';
				head.textContent = `${correct ? '✓' : '✗'} ${question.frage}`;
				item.append(head);
				const line = (label: string, text: string) => {
					const p = document.createElement('p');
					const strong = document.createElement('strong');
					strong.textContent = `${label}: `;
					p.append(strong, text);
					return p;
				};
				item.append(line(ui.yourAnswer, question.optionen[selected] ?? ''));
				if (!correct) item.append(line(ui.rightAnswer, question.optionen[question.richtig] ?? ''));
				if (question.erklaerung) {
					const p = document.createElement('p');
					p.className = 'quiz-review-note';
					p.textContent = question.erklaerung;
					item.append(p);
				}
				return item;
			}));
			schedule.textContent = scheduleText();
			schedule.hidden = !schedule.textContent;
			const wrong = answers.filter((a) => !a.correct).map((a) => a.question);
			restartActions.replaceChildren(
				...(wrong.length ? [button(ui.retryWrong, true, () => start(wrong))] : []),
				button(ui.retryAll, !wrong.length, () => start(questions)),
			);
		};

		const showNothingDue = () => {
			form.hidden = true;
			status.hidden = true;
			summary.hidden = false;
			score.textContent = ui.nothingDue;
			score.dataset.result = 'correct';
			review.replaceChildren();
			schedule.textContent = scheduleText();
			schedule.hidden = !schedule.textContent;
			restartActions.replaceChildren(button(ui.retryAll, true, () => start(questions)));
		};

		const answer = (selectedIndex: number) => {
			const question = round[current];
			if (!question) return;
			const correct = selectedIndex === question.richtig;
			answers.push({ question, selected: selectedIndex, correct });
			progress = recordAnswer(progress, translationKey, question.id, correct);
			try {
				writeQuizProgress(progress);
			} catch {
				// Feedback must not depend on storage (private mode, blocked site data).
				storageFailed = true;
			}

			options.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((option) => {
				const index = Number(option.dataset.index);
				option.disabled = true;
				if (index === question.richtig) option.dataset.correct = 'true';
				if (index === selectedIndex) option.setAttribute('aria-pressed', 'true');
				if (!correct && index === selectedIndex) option.dataset.incorrect = 'true';
			});
			const parts = [correct ? ui.correct : ui.incorrect];
			if (!correct) parts.push(ui.correctAnswer(question.optionen[question.richtig] ?? ''));
			if (question.erklaerung) parts.push(question.erklaerung);
			feedback.textContent = parts.join(' ');
			feedback.dataset.result = correct ? 'correct' : 'incorrect';
			feedback.hidden = false;
			next.textContent = current >= round.length - 1 ? (next.dataset.finish ?? '') : (next.dataset.next ?? '');
			next.hidden = false;
			next.focus({ preventScroll: true });
		};

		const renderQuestion = () => {
			const question = round[current];
			if (!question) {
				showSummary();
				return;
			}
			form.hidden = false;
			feedback.hidden = true;
			feedback.textContent = '';
			next.hidden = true;
			counter.textContent = ui.question(current + 1, round.length);
			questionText.textContent = question.frage;
			options.replaceChildren();

			for (const index of optionOrder(question.optionen.length)) {
				// A button per option: one click (or Enter/Space) answers, and arrow
				// keys can't answer by accident the way they do in a radio group.
				const option = document.createElement('button');
				option.type = 'button';
				option.className = 'quiz-option';
				option.dataset.index = String(index);
				option.textContent = question.optionen[index] ?? '';
				option.addEventListener('click', () => answer(index));
				options.append(option);
			}
		};

		form.addEventListener('submit', (event) => event.preventDefault());
		next.addEventListener('click', () => {
			current += 1;
			renderQuestion();
			options.querySelector('button')?.focus({ preventScroll: true });
		});

		const due = questions.filter((question) => isQuestionDue(progress, translationKey, question.id));
		if (due.length) start(due);
		else showNothingDue();
	}
</script>

<style>
	.retrieval-quiz {
		grid-column: 1;
		justify-self: center;
		width: min(100%, var(--measure));
		margin-top: var(--sp-2xl);
		max-width: var(--measure);
		background: var(--ground-page);
		border: 1px solid var(--line-deep);
		border-radius: var(--r-xl);
		padding: clamp(var(--sp-md), 4vw, var(--sp-xl));
	}
	@media print {
		.retrieval-quiz {
			display: none;
		}
	}
	.quiz-head {
		max-width: var(--measure);
	}
	.quiz-eyebrow,
	.quiz-counter {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--amber-deep);
	}
	.quiz-head h2 {
		font-size: 1.75rem;
		line-height: 1.2;
		margin: var(--sp-xs) 0 var(--sp-sm);
	}
	.quiz-head > p:last-child,
	.quiz-status {
		font-size: 1.125rem;
		line-height: 1.65;
		color: var(--ink-muted);
	}
	.quiz-status {
		margin-top: var(--sp-lg);
	}
	.quiz-form {
		margin-top: var(--sp-lg);
	}
	.quiz-form fieldset {
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
	}
	.quiz-form legend {
		display: flex;
		flex-direction: column;
		gap: var(--sp-xs);
		width: 100%;
	}
	.quiz-question {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 650;
		line-height: 1.45;
	}
	.quiz-options {
		display: grid;
		gap: var(--sp-xs);
		margin-top: var(--sp-md);
	}
	.quiz-options :global(.quiz-option) {
		display: block;
		width: 100%;
		text-align: left;
		font: inherit;
		color: inherit;
		background: none;
		padding: 12px var(--sp-sm);
		border: 1px solid var(--line);
		border-radius: var(--r-md);
		font-size: 1.125rem;
		line-height: 1.5;
		cursor: pointer;
	}
	.quiz-options :global(.quiz-option:hover:not(:disabled)) {
		border-color: var(--petrol-deep);
		background: var(--ground-zone);
	}
	.quiz-options :global(.quiz-option:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
	.quiz-options :global(.quiz-option:disabled) {
		cursor: default;
		color: inherit;
		opacity: 1;
	}
	.quiz-options :global(.quiz-option[data-correct='true']) {
		border: 2px solid var(--success);
		background: var(--ground-zone);
	}
	.quiz-options :global(.quiz-option[data-incorrect='true']) {
		border: 2px solid var(--error);
	}
	.quiz-options :global(.quiz-option[data-correct='true']::after) {
		content: ' ✓';
		color: var(--success);
		font-weight: 700;
	}
	.quiz-options :global(.quiz-option[data-incorrect='true']::after) {
		content: ' ✗';
		color: var(--error);
		font-weight: 700;
	}
	.quiz-summary {
		margin-top: var(--sp-lg);
	}
	.quiz-score {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 650;
		line-height: 1.45;
		padding: var(--sp-sm);
		border-left: 3px solid var(--line-deep);
	}
	.quiz-score[data-result='correct'] {
		border-left-color: var(--success);
	}
	.quiz-score[data-result='incorrect'] {
		border-left-color: var(--error);
	}
	.quiz-review {
		list-style: none;
		padding: 0;
		margin: var(--sp-md) 0 0;
		display: grid;
		gap: var(--sp-sm);
	}
	.quiz-review :global(li) {
		padding: var(--sp-sm);
		border: 1px solid var(--line);
		border-left: 3px solid var(--success);
		border-radius: var(--r-md);
		font-size: 1.0625rem;
		line-height: 1.5;
	}
	.quiz-review :global(li[data-result='incorrect']) {
		border-left-color: var(--error);
	}
	.quiz-review :global(p) {
		margin: 0;
	}
	.quiz-review :global(p + p) {
		margin-top: var(--sp-xs);
	}
	.quiz-review :global(.quiz-review-question) {
		font-weight: 650;
	}
	.quiz-review :global(.quiz-review-note) {
		color: var(--ink-muted);
	}
	.quiz-feedback {
		margin-top: var(--sp-md);
		padding: var(--sp-sm);
		border-left: 3px solid var(--line-deep);
		font-size: 1.125rem;
		line-height: 1.55;
	}
	.quiz-feedback[data-result='correct'] {
		border-left-color: var(--success);
	}
	.quiz-feedback[data-result='incorrect'] {
		border-left-color: var(--error);
	}
	.quiz-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-sm);
		margin-top: var(--sp-md);
	}
	@media (min-width: 1100px) {
		.retrieval-quiz {
			grid-column: 2;
		}
	}
	@media (max-width: 720px) {
		.retrieval-quiz {
			padding: var(--sp-md);
		}
	}
</style>

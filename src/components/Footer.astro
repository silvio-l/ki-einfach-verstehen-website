---
// Brand echo on the dark radial ground: the ONE decided Wortbildmarke —
// Kandidat A, weight-corrected, dark-ground variant — at every size, footer
// included (see DESIGN.md "Wortbildmarke": no separate small-size cut). This
// is the mark+wordmark ratio lockup, not the Hero's mark-less three-weight
// logotype (DESIGN.md §3 "Cover Lockup"/§8 "Wortbildmarke") — the two are
// deliberately different compositions. The phyllotaxis motif does NOT
// repeat here — its two allowed placements are the hero bloom and the
// Wegkarte's goal mark (DESIGN.md §4).
import markDark from '../assets/brand/mark-dark.svg?raw';
import { X_URL } from '../lib/social-links.ts';
import { ADS_ENABLED } from '../lib/ads.ts';
import { COMMUNITY_BOARD_HREF, COMMUNITY_LIVE } from '../lib/community.ts';
import { NEWSLETTER_LIVE, NEWSLETTER_PAGE_HREF } from '../lib/newsletter.ts';
import { GITHUB_REPO_URL } from '../lib/github-stars.ts';
import { CONTENT_LICENSE } from '../lib/structured-data.ts';

interface Props {
	lang: 'de' | 'en';
	otherLangHref: string;
	/** "Themenbereiche" target — local anchor on the homepage, absolute elsewhere. */
	themenHref?: string;
}

const { lang, otherLangHref, themenHref = '#themenbereiche' } = Astro.props;
const year = new Date().getFullYear();
// Community: once the forum is live the footer links straight into the
// board, not the announcement page. Same rule as Nav.astro.
const communityHref = COMMUNITY_LIVE ? COMMUNITY_BOARD_HREF[lang] : `/${lang}/community/`;
const communityTarget = COMMUNITY_LIVE ? '_blank' : undefined;
const communityRel = COMMUNITY_LIVE ? 'noopener' : undefined;

const copy = {
	de: {
		tagline: 'KI verständlich erklärt — ohne an der Oberfläche stehen zu bleiben.',
		themen: 'Themenbereiche',
		glossar: 'Glossar',
		glossarHref: '/de/glossar/',
		wissenstest: 'Wissenstest-Hub',
		wissenstestHref: '/de/wissenstest/',
		entdecken: 'Zum Ausprobieren',
		entdeckenHref: '/de/entdecken/',
		community: 'Community',
		youtube: 'YouTube',
		youtubeHref: '/de/youtube/',
		ebook: 'E-Book',
		ebookHref: '/de/e-book/',
		merch: 'Merch & Unterstützen',
		merchHref: '/de/merch/',
		howto: 'So funktioniert’s',
		howtoHref: '/de/so-funktionierts/',
		warum: 'Warum wir das machen',
		warumHref: '/de/warum/',
		lehrende: 'Für Lehrende',
		lehrendeHref: '/de/fuer-lehrende/',
		switchTo: 'EN',
		switchLabel: 'Read in English',
		rights: `© ${year} KI einfach verstehen`,
		impressum: 'Impressum',
		impressumHref: '/de/impressum/',
		datenschutz: 'Datenschutz',
		datenschutzHref: '/de/datenschutz/',
		consent: 'Datenschutz-Einstellungen',
		licensePre: 'Inhalte unter',
		licenseMid: ', Code unter',
		licenseHref: CONTENT_LICENSE.deed.de,
	},
	en: {
		tagline: 'AI, explained clearly — without stopping at the surface.',
		themen: 'Topics',
		glossar: 'Glossary',
		glossarHref: '/en/glossary/',
		wissenstest: 'Knowledge check hub',
		wissenstestHref: '/en/knowledge-check/',
		entdecken: 'Try it yourself',
		entdeckenHref: '/en/explore/',
		community: 'Community',
		youtube: 'YouTube',
		youtubeHref: '/en/youtube/',
		ebook: 'E-book',
		ebookHref: '/en/e-book/',
		merch: 'Merch & Support',
		merchHref: '/en/merch/',
		howto: 'How it works',
		howtoHref: '/en/how-it-works/',
		warum: 'Why we do this',
		warumHref: '/en/why/',
		lehrende: 'For educators',
		lehrendeHref: '/en/for-educators/',
		switchTo: 'DE',
		switchLabel: 'Auf Deutsch lesen',
		rights: `© ${year} KI einfach verstehen`,
		impressum: 'Legal Notice',
		impressumHref: '/en/legal-notice/',
		datenschutz: 'Privacy',
		datenschutzHref: '/en/privacy/',
		consent: 'Privacy settings',
		licensePre: 'Content licensed',
		licenseMid: ', code',
		licenseHref: CONTENT_LICENSE.deed.en,
	},
}[lang];
---

<footer class="site-footer" id="footer">
	<div class="foot-inner">
		<p class="foot-lockup">
			<span class="foot-mark" aria-hidden="true"><Fragment set:html={markDark} /></span>
			<span class="foot-word"><b>KI</b> einfach verstehen</span>
		</p>
		<p class="foot-tagline">{copy.tagline}</p>
		{/* Two proximity tiers, one flow — the site's own learning path first
		    (Themenbereiche → Glossar → Wissenstest-Hub → So funktioniert's), the surrounding
		    formats and project pages second. Link order, hrefs and labels are
		    unchanged from the single-row version; only the register differs. */}
		<nav class="foot-nav" aria-label={lang === 'de' ? 'Fußnavigation' : 'Footer navigation'}>
			<div class="foot-primary">
				<a href={themenHref}>{copy.themen}</a>
				<a href={copy.glossarHref}>{copy.glossar}</a>
				<a href={copy.wissenstestHref}>{copy.wissenstest}</a>
				<a href={copy.entdeckenHref} data-testid="footer-entdecken">{copy.entdecken}</a>
				<a href={copy.howtoHref}>{copy.howto}</a>
			</div>
			<div class="foot-secondary">
				<a href={communityHref} target={communityTarget} rel={communityRel}>{copy.community}</a>
				{NEWSLETTER_LIVE && (
					<a href={NEWSLETTER_PAGE_HREF[lang]} data-testid="footer-newsletter">
						Newsletter
					</a>
				)}
				<a href={copy.youtubeHref}>{copy.youtube}</a>
				<a href={copy.ebookHref}>{copy.ebook}</a>
				<a href={copy.merchHref}>{copy.merch}</a>
				<a href={copy.warumHref}>{copy.warum}</a>
				<a href={copy.lehrendeHref} data-testid="footer-lehrende">{copy.lehrende}</a>
			</div>
		</nav>
		<div class="foot-base">
			<nav class="foot-legal" aria-label={lang === 'de' ? 'Rechtliches' : 'Legal'}>
				<a class="foot-lang" href={otherLangHref} hreflang={lang === 'de' ? 'en' : 'de'} aria-label={copy.switchLabel} title={copy.switchLabel}>{copy.switchTo}</a>
				<a href={X_URL} target="_blank" rel="noopener noreferrer">X (Twitter)</a>
				<a href={copy.impressumHref}>{copy.impressum}</a>
				<a href={copy.datenschutzHref}>{copy.datenschutz}</a>
				{ADS_ENABLED && (
					<button type="button" class="foot-consent" data-consent-revoke hidden>
						{copy.consent}
					</button>
				)}
			</nav>
			{/* Content CC BY 4.0, code MIT (ADR-0024, LICENSE-CONTENT.md). */}
			<p class="foot-rights">
				{copy.rights}
				<span class="foot-license" data-testid="footer-license">
					{' · '}{copy.licensePre}{' '}<a href={copy.licenseHref} rel="license noopener" target="_blank" data-testid="footer-license-content">{CONTENT_LICENSE.name}</a>{copy.licenseMid}{' '}<a href={`${GITHUB_REPO_URL}/blob/main/LICENSE`} rel="noopener" target="_blank" data-testid="footer-license-code">MIT</a>
				</span>
			</p>
		</div>
	</div>
</footer>

{/* Google's certified CMP (configured in AdSense under "Datenschutz und
    Mitteilungen") exposes googlefc; the revocation link only appears once
    the CMP reports that a consent message applies to this visitor (EEA/UK),
    so readers outside that scope never see a dead control. */}
{ADS_ENABLED && (
	<script is:inline>
		(function () {
			var btn = document.querySelector('[data-consent-revoke]');
			if (!btn) return;
			window.googlefc = window.googlefc || {};
			window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
			window.googlefc.callbackQueue.push({
				CONSENT_DATA_READY: function () {
					try {
						if (window.googlefc.getConsentStatus && window.googlefc.getConsentStatus() === 0) return;
					} catch (e) {
						/* status unavailable: still offer the control */
					}
					btn.hidden = false;
					btn.addEventListener('click', function () {
						window.googlefc.showRevocationMessage();
					});
				},
			});
		})();
	</script>
)}

<style>
	.site-footer {
		/* Secondary text on this colored ground is tinted from the ground's own
		   family (petrol-soft at reduced alpha), never a neutral gray — a warm
		   gray over petrol reads muddy. Alphas are picked so every tier still
		   clears 4.5:1 against the darkest and lightest stop it sits over.
		   The tiers are the --on-dark-* constants in tokens.css (shared with
		   the community board's footer). */
		background: radial-gradient(115% 115% at 50% 27%, var(--hero-0) 0%, var(--hero-34) 34%, var(--hero-62) 62%, var(--hero-100) 100%);
		color: var(--on-dark-soft);
		padding: var(--sp-2xl) var(--sp-md) var(--sp-xl);
		text-align: center;
	}
	@media print {
		.site-footer {
			display: none;
		}
	}
	/* The radial ground is centered, so the composition stays centered too —
	   but on a wide `--shell` the footer would otherwise sprawl to 1880px and
	   read as scattered fragments. A fixed measure keeps it one block.
	   Vertical rhythm is deliberate rather than one repeated gap: the lockup
	   and its tagline sit tight together, the navigation gets real air, and
	   the legal band is pushed off further still. */
	.foot-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: min(100%, 62rem);
		margin-inline: auto;
	}
	/* Kandidat A lockup, dark-stage (footer ground) — the same documented
	   mark/wordmark size, gap and color relationship as Nav.astro's .brand,
	   "40 px — Header" tier (packages/content/design/wortbildmarke-forschung.html:
	   cap-ratio 0.701, overshoot 1.32, gap-ratio 0.3). See DESIGN.md
	   "Wortbildmarke". Do not restyle the mark height or wordmark font
	   independently of this ratio system, and do not reintroduce the old
	   three-weight stacked treatment here — that's reserved for the Hero's
	   standalone logotype, which carries no mark. */
	.foot-lockup {
		--cap-ratio: 0.701;
		--overshoot: 1.32;
		--gap-ratio: 0.3;
		--fs: clamp(1.2rem, 6.5vw, 2.5rem);
		--cap: calc(var(--fs) * var(--cap-ratio));
		--mark-h: calc(var(--cap) * var(--overshoot));
		--gap: calc(var(--cap) * var(--gap-ratio));
		--shift: calc(var(--cap) * (var(--overshoot) - 1) / 2);
		display: flex;
		align-items: baseline;
		gap: var(--gap);
	}
	.foot-mark {
		display: block;
		height: var(--mark-h);
		/* mark-dark viewBox is 66 × 93.66 — preserve that ratio. */
		width: calc(var(--mark-h) * 0.7046);
		transform: translateY(var(--shift));
	}
	.foot-mark :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.foot-word {
		font-family: var(--font-serif);
		font-size: var(--fs);
		font-weight: 500;
		line-height: 1;
		color: var(--on-dark-fill);
		white-space: nowrap;
	}
	.foot-word b {
		font-weight: 700;
		color: var(--petrol-viv);
	}
	.foot-tagline {
		max-width: 32rem;
		margin-top: var(--sp-xs);
		color: var(--on-dark-mint);
		font-size: 1rem;
		line-height: 1.6;
	}
	/* Three registers, no pill chrome: eight identically-shaped outlined pills
	   read as an undifferentiated wall with no primary/secondary distinction
	   (and stacked into five ragged rows on a phone). Hierarchy now comes from
	   size, weight, color and proximity instead — the cheapest, quietest tools
	   — so nothing here needs a border to be findable. The two-letter language
	   pill below keeps its chrome deliberately: it is the one control in the
	   footer, not a navigation link. */
	.foot-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--sp-sm);
		margin-top: var(--sp-lg);
	}
	.foot-primary,
	.foot-secondary {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}
	.foot-primary {
		gap: 2px var(--sp-lg);
	}
	.foot-secondary {
		gap: 2px var(--sp-md);
	}
	.foot-nav a {
		/* Generous block padding keeps the touch target usable now that the
		   pill's own padding is gone. */
		padding: var(--sp-xs) 0;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.foot-primary a {
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--on-dark-soft);
	}
	.foot-secondary a {
		font-size: 1rem;
		font-weight: 400;
		color: var(--on-dark-quiet);
	}
	.foot-nav a:hover {
		color: var(--on-dark-fill);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	/* The global :focus-visible ring is petrol-viv, which only reaches ~2.4:1
	   against this footer's brightest gradient stop — under the 3:1 floor for
	   non-text UI, and these links no longer carry a border of their own to
	   fall back on. On the dark ground the ring is drawn in on-dark-soft
	   instead (~7.5:1), keeping the same 2px/3px geometry as the global rule. */
	.site-footer a:focus-visible {
		outline: 2px solid var(--on-dark-soft);
		outline-offset: 3px;
	}
	/* Utility band: language switch, social, legal smallprint and copyright —
	   one quiet register set off by a hairline, so the navigation above ends
	   somewhere instead of trailing into two more rows of links. */
	.foot-base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--sp-sm) var(--sp-md);
		width: 100%;
		margin-top: var(--sp-xl);
		padding-top: var(--sp-md);
		border-top: 1px solid var(--on-dark-hairline);
	}
	.foot-legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-sm);
	}
	.foot-legal a {
		font-size: 0.875rem;
		color: var(--on-dark-quiet);
		text-decoration: none;
	}
	.foot-legal a:hover {
		color: var(--on-dark-soft);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* Consent revocation (Google CMP): styled as a sibling of the legal links,
	   hidden until the CMP confirms a consent message exists for this visitor. */
	.foot-consent {
		appearance: none;
		background: none;
		border: 0;
		padding: 0;
		font: inherit;
		font-size: 0.875rem;
		color: var(--on-dark-quiet);
		cursor: pointer;
	}
	.foot-consent:hover {
		color: var(--on-dark-soft);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.foot-consent[hidden] {
		display: none;
	}
	/* Compact two-letter pill, same chrome language as Nav.astro's
	   .lang-switch, adapted to the footer's dark ground colors. Its border is
	   dimmed to sit inside the quiet band rather than become the loudest mark
	   in it now that the navigation pills are gone. */
	.foot-lang {
		border: 1px solid var(--on-dark-line);
		border-radius: var(--r-pill);
		padding: 3px 10px;
		font-weight: 600;
		color: var(--on-dark-soft) !important;
		text-decoration: none !important;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}
	/* Visual pill stays compact; the hit area reaches --hit-min. */
	.foot-lang {
		position: relative;
	}
	.foot-lang::after {
		content: '';
		position: absolute;
		inset: min(0px, calc(50% - var(--hit-min) / 2));
	}
	.foot-lang:hover {
		background: var(--on-dark-hover);
		border-color: var(--on-dark-soft);
		text-decoration: none !important;
	}
	.foot-rights {
		font-size: 0.875rem;
		color: var(--on-dark-quietest);
	}
	.foot-rights a {
		color: var(--on-dark-quiet);
		text-underline-offset: 3px;
	}
	.foot-rights a:hover {
		color: var(--on-dark-soft);
	}
	/* Below the site's shared 720px breakpoint the utility band has no room
	   for two poles, so it stacks and re-centers with the rest of the
	   composition; the copyright line stays last in both orders. */
	@media (max-width: 720px) {
		.foot-base {
			flex-direction: column;
			justify-content: center;
			gap: var(--sp-sm);
		}
	}
	@media (max-width: 520px) {
		.site-footer {
			padding: var(--sp-xl) var(--sp-md) var(--sp-lg);
		}
		.foot-primary {
			gap: 2px var(--sp-md);
		}
		.foot-secondary {
			gap: 2px var(--sp-sm);
		}
	}
</style>

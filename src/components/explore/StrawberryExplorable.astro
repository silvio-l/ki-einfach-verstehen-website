				<ol class="xp-row" data-xp-live-row aria-label={c.s4.rowLabel(EXAMPLES.strawberry.tokens.length)} data-label-template={c.s4.rowLabel(999)} data-testid={`${P}-live-row`}>
					{EXAMPLES.strawberry.tokens.map((t, i) => (
						<li class="xp-chip" style={`--chip: var(--xp-c${(i % 5) + 1})`}><span class="xp-chip-text">{t.text}</span><span class="xp-chip-id">{t.id}</span></li>
					))}
				</ol>
				<div class="xp-live-foot">
					<p class="xp-summary" data-xp-summary aria-live="polite" data-template={c.s4.summary(111, 222)} data-testid={`${P}-live-summary`}>{c.s4.summary(10, 3)}</p>
					<button type="button" class="btn btn-secondary xp-toggle" data-xp-ids-toggle aria-pressed="false" data-on={c.s4.toggleOn} data-off={c.s4.toggleOff} data-testid={`${P}-live-ids-toggle`}>{c.s4.toggleOn}</button>
				</div>
				<p class="xp-bytes-note" data-xp-bytes-note hidden>{c.s4.bytesNote}</p>
			</div>
		</section>

		<section class="xp-step" id="step-5" data-xp-step="5" aria-labelledby="step-5-h">
			<h2 id="step-5-h"><span class="xp-step-no" aria-hidden="true">5</span>{c.s5.h}</h2>
			<div class="xp-cards">
				<article class="xp-card">
					<h3>{c.s5.numbersH}</h3>
					<TokenRow tokens={EXAMPLES.number.tokens} label={`1234567: ${EXAMPLES.number.tokens.length}`} compact />
					<p set:html={c.s5.numbersP} />
					<button type="button" class="xp-try" data-xp-try={lang === 'de' ? '12345678 und 12.345.678' : '12345678 and 12,345,678'} data-testid={`${P}-try-numbers`}>{c.s5.tryIt}</button>
				</article>
				<article class="xp-card">
					<h3>{c.s5.emojiH}</h3>
					<TokenRow tokens={EXAMPLES.emoji.tokens} label={`🍓: ${EXAMPLES.emoji.tokens.length}`} compact />
					<p set:html={c.s5.emojiP} />
					<button type="button" class="xp-try" data-xp-try="🍓 👩‍💻 🇩🇪" data-testid={`${P}-try-emoji`}>{c.s5.tryIt}</button>
				</article>
				<article class="xp-card xp-card--wide">
					<h3>{c.s5.langH}</h3>
					<div class="xp-table-wrap">
						<table class="xp-table" data-testid={`${P}-languages`}>
							<thead>
								<tr>{c.s5.langCols.map((col) => <th scope="col">{col}</th>)}</tr>
							</thead>
							<tbody>
								{LANGUAGES.map((row) => (
									<tr>
										<th scope="row">{LANG_NAMES[row.lang as keyof typeof LANG_NAMES]}</th>
										<td lang={row.lang} class="xp-table-text">{row.text}</td>
										<td class="xp-num">{row.chars}</td>
										<td class="xp-num"><strong>{row.o200k}</strong></td>
										<td class="xp-num">{row.cl100k}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
					<p set:html={c.s5.langP} />
					<button type="button" class="xp-try" data-xp-try={LANGUAGES[2].text} data-testid={`${P}-try-languages`}>{c.s5.tryIt}</button>
				</article>
			</div>
		</section>

		<section class="xp-step" id="step-6" data-xp-step="6" aria-labelledby="step-6-h">
			<h2 id="step-6-h"><span class="xp-step-no" aria-hidden="true">6</span>{c.s6.h}</h2>
			<p>{c.s6.p1}</p>
			<ul class="xp-findings">
				<li set:html={c.s6.li1} />
				<li set:html={c.s6.li2} />
			</ul>
			<p>{c.s6.p2}</p>
			<div class="xp-compare">
				<p class="xp-variant-label">{c.s6.rowA}</p>
				<TokenRow tokens={EXAMPLES.strawberry.tokens} label={c.s6.rowA} compact />
				<p class="xp-variant-label">{c.s6.rowB}</p>
				<TokenRow tokens={EXAMPLES.spelled.tokens} label={c.s6.rowB} highlight={[428]} testid={`${P}-spelled-row`} compact />
			</div>
			<p>{c.s6.p3}</p>
			<aside class="xp-takeaway">
				<p class="xp-takeaway-h">{c.s6.takeawayH}</p>
				<p>{c.s6.takeaway}</p>
			</aside>
		</section>

		<section class="xp-deeper" id="deeper" aria-labelledby="deeper-h" data-xp-step="7">
			<h2 id="deeper-h">{c.deeper.h}</h2>
			<p set:html={c.deeper.p} />
			<h3>{c.deeper.lessonsH}</h3>
			<ul class="xp-lessons">
				{lessons.map((l) => (
					<li>
						<a href={l.href} data-xp-lesson={l.slug} data-testid={`${P}-lesson-${l.slug}`}>
							<span class="xp-lesson-title">{l.title}</span>
							<span class="xp-lesson-text">{l.text}</span>
						</a>
					</li>
				))}
			</ul>
			<div class="xp-open">
				<div class="xp-open-block">
					<h3>{c.deeper.repoH}</h3>
					<p>{c.deeper.repoP}</p>
					<p class="xp-open-actions">
						<a class="btn btn-primary" href={GITHUB_REPO_URL} target="_blank" rel="noopener" data-xp-repo data-testid={`${P}-repo`}>
							<span class="xp-gh" aria-hidden="true"><Fragment set:html={githubMark} /></span>
							{c.deeper.repoCta}
						</a>
						<span data-testid={`${P}-share`}><ShareButton lang={lang} track={`Explorable ${slug}`} /></span>
					</p>
				</div>
				<div class="xp-open-block">
					<h3>{c.deeper.communityH}</h3>
					<p>{c.deeper.communityP}</p>

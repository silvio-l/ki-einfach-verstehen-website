		},
	},
	{
		url: 'https://github.com/openai/tiktoken',
		title: 'OpenAI tiktoken: README',
		claim: {
			en: 'BPE as used in tiktoken is reversible and lossless and works on arbitrary text, even text not in the tokenizer’s training data.',
			de: 'BPE, wie tiktoken es nutzt, ist umkehrbar und verlustfrei und funktioniert mit beliebigem Text, auch mit Text, der nicht in den Trainingsdaten des Tokenizers vorkam.',
		},

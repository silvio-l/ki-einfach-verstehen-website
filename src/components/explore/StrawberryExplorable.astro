		<section class="xp-sources" id="sources" aria-labelledby="sources-h">
			<h2 id="sources-h">{c.sourcesH}</h2>
			<p>{c.sourcesP}</p>
			<ol>
				{sources.map((s, i) => (
					<li id={`xp-src-${i + 1}`}>
						<a href={s.url} rel="noopener" data-testid={`${P}-source-${i + 1}`}>{s.title}</a>
						<span class="xp-src-claim">{s.claim[lang]}</span>
					</li>
				))}
			</ol>
		</section>
	</div>
</div>

<script>
	import { trackEvent } from '../../lib/matomo';
	import { countChars, displayToken, loadTokenizer } from '../../scripts/demos/real-tokens.js';

	type RealToken = { id: number; text: string | null; bytes: number[] | null };

	for (const root of document.querySelectorAll<HTMLElement>('[data-explorable]')) {
		const slug = root.dataset.slug ?? 'strawberry';
		const once = new Set<string>();
		const track = (action: string, name = slug, key = `${action}:${name}`) => {
			if (once.has(key)) return;
			once.add(key);
			trackEvent('Explorable', action, name);
		};

		// --- Start + step reached ------------------------------------------
		root.querySelector('[data-xp-start]')?.addEventListener('click', () => track('Start'));
		const steps = root.querySelectorAll<HTMLElement>('[data-xp-step]');
		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						const el = entry.target as HTMLElement;
						track('Schritt erreicht', `${slug}:${el.dataset.xpStep}`);
						io.unobserve(el);
					}
				},
				{ rootMargin: '0px 0px -40% 0px' },
			);
			steps.forEach((s) => io.observe(s));
		}

		// --- Step 1: guess ---------------------------------------------------
		const result = root.querySelector<HTMLElement>('[data-xp-guess-result]');
		const wordEl = root.querySelector<HTMLElement>('[data-xp-word]');
		root.querySelectorAll<HTMLButtonElement>('[data-xp-guess]').forEach((btn) =>
			btn.addEventListener('click', () => {
				const n = Number(btn.dataset.xpGuess);
				root.querySelectorAll('[data-xp-guess]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				if (result) {
					result.textContent = n === 3 ? (result.dataset.right ?? '') : (result.dataset.wrong ?? '').replace('{n}', String(n));
					result.dataset.correct = String(n === 3);
				}
				wordEl?.classList.add('is-revealed');
				track('Start');
				track('Interaktion', `${slug}:guess`);
			}),
		);

		// --- "What the model receives" toggles (steps 2 and 4) ---------------
		root.querySelectorAll<HTMLButtonElement>('[data-xp-ids-toggle]').forEach((btn) =>
			btn.addEventListener('click', () => {
				const scope = btn.closest<HTMLElement>('[data-xp-ids-scope]');
				const on = btn.getAttribute('aria-pressed') !== 'true';
				btn.setAttribute('aria-pressed', String(on));
				btn.textContent = (on ? btn.dataset.off : btn.dataset.on) ?? '';
				scope?.classList.toggle('is-ids', on);
				track('Interaktion', `${slug}:ids-toggle`);
			}),
		);

		// --- Step 4: live tokenizer -------------------------------------------
		const live = root.querySelector<HTMLElement>('[data-xp-live]');
		const input = root.querySelector<HTMLInputElement>('[data-xp-input]');
		const row = root.querySelector<HTMLElement>('[data-xp-live-row]');
		const status = root.querySelector<HTMLElement>('[data-xp-status]');
		const summary = root.querySelector<HTMLElement>('[data-xp-summary]');
		const bytesNote = root.querySelector<HTMLElement>('[data-xp-bytes-note]');
		if (!live || !input || !row || !status || !summary) continue;

		let engine: { encode: (text: string) => RealToken[] } | null = null;
		let loading: Promise<void> | null = null;
		let typed = false;

		const render = () => {
			if (!engine) return;
			const text = input.value;
			const tokens = text ? engine.encode(text) : [];
			row.replaceChildren(
				...tokens.map((token, i) => {
					const li = document.createElement('li');
					li.className = token.text === null ? 'xp-chip xp-chip--bytes' : 'xp-chip';
					li.style.setProperty('--chip', `var(--xp-c${(i % 5) + 1})`);
					const t = document.createElement('span');
					t.className = 'xp-chip-text';
					t.textContent = displayToken(token);
					const id = document.createElement('span');
					id.className = 'xp-chip-id';
					id.textContent = String(token.id);
					li.append(t, id);
					return li;
				}),
			);
			row.setAttribute('aria-label', (row.dataset.labelTemplate ?? '').replace('999', String(tokens.length)));
			summary.textContent = (summary.dataset.template ?? '').replace('111', String(countChars(text))).replace('222', String(tokens.length));
			if (bytesNote) bytesNote.hidden = !tokens.some((t) => t.text === null);
		};

		const ensureEngine = () => {
			if (!loading) {
				status.textContent = live.dataset.loading ?? '';
				status.dataset.state = 'loading';
				loading = loadTokenizer('o200k_base')
					.then((e) => {
						engine = e;
						status.textContent = live.dataset.ready ?? '';
						status.dataset.state = 'ready';
						render();
					})
					.catch(() => {
						status.textContent = live.dataset.failed ?? '';
						status.dataset.state = 'failed';
					});
			}
			return loading;
		};

		const markTyped = () => {
			if (typed) return;
			typed = true;
			track('Eigene Eingabe');
		};

		let frame = 0;
		input.addEventListener('focus', () => void ensureEngine());
		input.addEventListener('input', () => {
			markTyped();
			void ensureEngine();
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(render);
		});
		const fill = (text: string, from: string) => {
			input.value = text;
			track('Interaktion', `${slug}:${from}`);
			void ensureEngine().then(render);
		};
		root.querySelectorAll<HTMLButtonElement>('[data-xp-preset]').forEach((b) =>
			b.addEventListener('click', () => fill(b.dataset.xpPreset ?? '', 'preset')),
		);
		root.querySelectorAll<HTMLButtonElement>('[data-xp-try]').forEach((b) =>
			b.addEventListener('click', () => {
				fill(b.dataset.xpTry ?? '', 'try');
				live.closest('section')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
				input.focus({ preventScroll: true });
			}),
		);
		// Start loading a little before the reader reaches the box.
		if ('IntersectionObserver' in window) {
			const pre = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						void ensureEngine();
						pre.disconnect();
					}
				},
				{ rootMargin: '300px 0px' },
			);
			pre.observe(live);
		}

		// --- Outbound / onward clicks ----------------------------------------
		root.querySelector('[data-xp-repo]')?.addEventListener('click', () => trackEvent('Explorable', 'Klick Repo', slug));
		root.querySelector('[data-xp-community]')?.addEventListener('click', () => trackEvent('Explorable', 'Klick Community', slug));
		root.querySelectorAll<HTMLAnchorElement>('[data-xp-lesson]').forEach((a) =>
			a.addEventListener('click', () => trackEvent('Explorable', 'Klick Baustein', `${slug}:${a.dataset.xpLesson}`)),
		);
	}
</script>

<style is:global>
	.xp {
		--xp-c1: #d7ece7;
		--xp-c2: #fbf2e0;
		--xp-c3: #e4e1f6;
		--xp-c4: #fbe3dc;
		--xp-c5: #e6f0d2;
		--measure: 53rem;
	}
	:root[data-theme='dark'] .xp {
		--xp-c1: rgba(79, 184, 168, 0.22);
		--xp-c2: rgba(217, 162, 63, 0.22);

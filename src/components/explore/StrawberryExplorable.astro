						</div>
					);
				})}
			</div>
			<p set:html={c.s3.p2} />
		</section>

		<section class="xp-step" id="step-4" data-xp-step="4" aria-labelledby="step-4-h">
			<h2 id="step-4-h"><span class="xp-step-no" aria-hidden="true">4</span>{c.s4.h}</h2>
			<p set:html={c.s4.p} />
			<div class="xp-live" data-xp-live data-xp-ids-scope data-loading={c.s4.loading} data-ready={c.s4.ready} data-failed={c.s4.failed}>
				<label class="xp-label" for={`xp-input-${lang}`}>{c.s4.inputLabel}</label>
				<input
					id={`xp-input-${lang}`}

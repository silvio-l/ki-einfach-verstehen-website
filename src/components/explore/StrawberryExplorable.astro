		</section>

		<section class="xp-step" id="step-3" data-xp-step="3" aria-labelledby="step-3-h">
			<h2 id="step-3-h"><span class="xp-step-no" aria-hidden="true">3</span>{c.s3.h}</h2>
			<p>{c.s3.p1}</p>
			<div class="xp-variants" data-testid={`${P}-variants`}>
				{c.s3.rows.map((row) => {
					const ex = EXAMPLES[row.key as keyof typeof EXAMPLES];
					return (
						<div class="xp-variant">
							<p class="xp-variant-label">{row.label}</p>

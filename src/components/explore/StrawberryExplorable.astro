			))}
		</ol>
	</header>

	<div class="xp-body">
		<nav class="xp-steps" aria-label={c.stepsLabel}>
			<ol>
				{c.steps.map((s, i) => (
					<li><a href={`#step-${i + 1}`} data-testid={`${P}-step-nav-${i + 1}`}><span class="xp-step-no">{i + 1}</span>{s}</a></li>
				))}
			</ol>
		</nav>

		<section class="xp-step" id="step-1" data-xp-step="1" aria-labelledby="step-1-h">
			<h2 id="step-1-h"><span class="xp-step-no" aria-hidden="true">1</span>{c.s1.h}</h2>
			<p>{c.s1.p}</p>
			<p class="xp-word" data-xp-word>
				<span class="visually-hidden">strawberry</span>
				{word.map((ch, i) => <span class:list={['xp-letter', { 'is-r': ch === 'r' }]} data-pos={i + 1} aria-hidden="true">{ch}</span>)}

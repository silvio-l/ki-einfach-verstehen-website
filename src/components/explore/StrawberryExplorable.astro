// Flagship explorable "How many r's are in strawberry?" (E3 in
// docs/research/social-growth-loops.md of the private monorepo): a guided,
// six-step walk from a counting question to what a language model actually
// receives, built on the real o200k_base tokenizer. The guided steps are
// server-rendered from precomputed, test-verified data
// (src/scripts/demos/real-tokens.js), so they read and work without JS;
// only the free input lazy-loads the ~1 MB tokenizer engine. Every factual
// claim carries a numbered source at the end of the page.
import TokenRow from './TokenRow.astro';
import ShareButton from '../ShareButton.astro';
import githubMark from '../../assets/icons/github-mark.svg?raw';
import { GITHUB_REPO_URL } from '../../lib/github-stars';

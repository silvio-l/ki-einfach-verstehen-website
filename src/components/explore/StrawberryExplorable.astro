			<p class="xp-lede">{c.lede}</p>
			<p class="xp-hero-actions">
				<a class="btn btn-on-dark-primary" href="#step-1" data-xp-start data-testid={`${P}-start`}>{c.start}</a>
			</p>
			<p class="xp-hero-meta">{c.meta}</p>
		</div>
		<ol class="xp-hero-row" aria-hidden="true">
			{EXAMPLES.strawberry.tokens.map((t) => (

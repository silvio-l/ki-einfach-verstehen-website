			<p set:html={c.s2.p1} />
			<div class="xp-stage" data-xp-ids-scope>
				<TokenRow tokens={question.tokens} label={c.s2.rowLabel} highlight={[101830]} testid={`${P}-question-row`} />
				<button type="button" class="btn btn-primary xp-toggle" data-xp-ids-toggle aria-pressed="false" data-on={c.s2.toggleOn} data-off={c.s2.toggleOff} data-testid={`${P}-ids-toggle`}>{c.s2.toggleOn}</button>

const P = 'explore-strawberry';

// Numbered sources; prose refers to them as [n] via ref(n).
const sources = [
	{
		url: 'https://arxiv.org/abs/2412.18626',
		title: 'Fu, Ferrando, Conde, Arriaga, Reviriego (2024): Why Do Large Language Models (LLMs) Struggle to Count Letters? arXiv:2412.18626',
		claim: {
			en: 'Counting letters such as the r’s in “strawberry” is hard for LLMs. In tests of eight models including GPT-4o, the models recognised which letters a word contains but miscounted them, most of all letters that occur more than twice; word and token frequency had no significant effect, and the authors conclude that tokenization is not the fundamental issue. GPT-4o’s tokenizer splits “strawberry” into “st”, “raw”, “berry”.',
			de: 'Buchstaben zählen, etwa die r in „strawberry“, fällt Sprachmodellen schwer. In Tests mit acht Modellen, darunter GPT-4o, erkannten die Modelle, welche Buchstaben in einem Wort vorkommen, zählten sie aber falsch, vor allem Buchstaben, die mehr als zweimal vorkommen; die Häufigkeit von Wort und Tokens hatte keinen nennenswerten Einfluss, und die Autoren folgern, dass die Tokenisierung nicht die grundlegende Ursache ist. GPT-4os Tokenizer zerlegt „strawberry“ in „st“, „raw“, „berry“.',
		},
	},
	{
		url: 'https://github.com/openai/tiktoken/blob/main/tiktoken/model.py',
		title: 'OpenAI tiktoken: tiktoken/model.py (model-to-encoding mapping)',
		claim: {
			en: 'tiktoken assigns the o200k_base encoding to GPT-4o, GPT-4.1, o1, o3 and GPT-5, and cl100k_base to GPT-4.',
			de: 'tiktoken ordnet GPT-4o, GPT-4.1, o1, o3 und GPT-5 die Kodierung o200k_base zu, GPT-4 die Kodierung cl100k_base.',
		},
	},
	{
		url: 'https://github.com/openai/tiktoken/blob/main/tiktoken_ext/openai_public.py',
		title: 'OpenAI tiktoken: tiktoken_ext/openai_public.py (split patterns)',
		claim: {
			en: 'Before merging, cl100k_base and o200k_base cut runs of digits into groups of one to three digits (pattern \\p{N}{1,3}).',
			de: 'Vor dem Zusammenfügen schneiden cl100k_base und o200k_base Ziffernfolgen in Gruppen aus ein bis drei Ziffern (Muster \\p{N}{1,3}).',
		},
	},
	{
		url: 'https://arxiv.org/abs/2402.14903',
		title: 'Singh, Strouse (2024): Tokenization counts: the impact of tokenization on arithmetic in frontier LLMs. arXiv:2402.14903',
		claim: {
			en: 'GPT-3.5 and GPT-4 use separate tokens for 1-, 2- and 3-digit numbers; enforcing right-to-left grouping with comma separators improved their arithmetic substantially.',

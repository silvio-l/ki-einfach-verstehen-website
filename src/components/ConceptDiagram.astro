---
type Variant =
	| 'training-transfer'
	| 'model-update'
	| 'training-samples'
	| 'score-loop'
	| 'fixed-pair'
	| 'split-jobs';

interface Props {
	variant: Variant;
	lang: 'de' | 'en';
	'data-lesson-visual'?: boolean;
}

const { variant, lang } = Astro.props;
const arrowId = `arrow-${variant}-${lang}`;
const titleId = `title-${variant}-${lang}`;
const text = {
	de: {
		'training-transfer': ['Beispiele', 'Training', 'Modell', 'gelernt statt aufgeschrieben'],
		'model-update': ['Prompt ändern', 'dieses Gespräch', 'neu trainieren', 'neue Modellversion'],
		'training-samples': ['Textausschnitt', 'nächstes Textstück', 'Übungsbeispiel', 'Input', 'Label'],
		'score-loop': ['bisheriger Text', 'Score-Liste', 'Auswahl', 'neues Textstück'],
		'fixed-pair': ['Tokenizer', '417 = „Die"', 'Modell', '417 = gelernter Vektor', 'gemeinsames Vokabular'],
		'split-jobs': ['Tokenizer', 'Text ↔ IDs', 'zerlegt und nummeriert', 'Modell', 'sagt nächste ID voraus', 'lernt Muster'],
	},
	en: {
		'training-transfer': ['Examples', 'Training', 'Model', 'learned instead of written'],
		'model-update': ['Change prompt', 'this conversation', 'retrain', 'new model version'],
		'training-samples': ['Text excerpt', 'next text piece', 'Practice sample', 'Input', 'Label'],
		'score-loop': ['text so far', 'Score list', 'Selection', 'new text piece'],
		'fixed-pair': ['Tokenizer', '417 = “The”', 'Model', '417 = learned vector', 'shared vocabulary'],
		'split-jobs': ['Tokenizer', 'Text ↔ IDs', 'splits and numbers', 'Model', 'predicts the next ID', 'learns patterns'],
	},
}[lang][variant];
---

<svg viewBox="0 0 720 260" role="img" aria-labelledby={titleId} data-lesson-visual>
	<title id={titleId}>{text.join(' — ')}</title>
	<defs>
		<marker id={arrowId} viewBox="0 0 12 12" refX="10" refY="6" markerWidth="14" markerHeight="14" markerUnits="userSpaceOnUse" orient="auto">
			<path d="M1 1 11 6 1 11Z" fill="#0E7469" />
		</marker>
	</defs>

	{variant === 'training-transfer' && (
		<>
			<g transform="translate(24 54)">
				<rect x="0" y="0" width="180" height="132" rx="16" fill="#FBF2E0" stroke="#986816" stroke-width="2" />
				<text x="90" y="30" text-anchor="middle" class="label amber">{text[0]}</text>
				<rect x="28" y="48" width="124" height="16" rx="8" fill="#E6C67A" />
				<rect x="28" y="76" width="96" height="16" rx="8" fill="#E6C67A" />
				<rect x="28" y="104" width="138" height="16" rx="8" fill="#E6C67A" />
			</g>
			<path d="M220 120H284" class="arrow" marker-end={`url(#${arrowId})`} />
			<rect x="298" y="76" width="128" height="88" rx="44" fill="#D7ECE7" stroke="#0E7469" stroke-width="2" />
			<text x="362" y="127" text-anchor="middle" class="label petrol">{text[1]}</text>
			<path d="M442 120H506" class="arrow" marker-end={`url(#${arrowId})`} />
			<g transform="translate(520 54)">
				<rect width="176" height="132" rx="16" fill="#E8E5F4" stroke="#5E4B8B" stroke-width="2" />
				<text x="88" y="30" text-anchor="middle" class="label violet">{text[2]}</text>
				<path d="M30 66H146M30 96H146" stroke="#B9AED6" stroke-width="6" stroke-linecap="round" />
				<circle cx="66" cy="66" r="10" fill="#5E4B8B" /><circle cx="120" cy="96" r="10" fill="#5E4B8B" />
			</g>
			<text x="360" y="226" text-anchor="middle" class="caption">{text[3]}</text>
		</>
	)}

	{variant === 'model-update' && (
		<>
			<rect x="34" y="34" width="206" height="72" rx="16" fill="#FBF2E0" stroke="#986816" stroke-width="2" />
			<text x="137" y="77" text-anchor="middle" class="label amber">{text[0]}</text>
			<path d="M256 70H346" class="arrow" marker-end={`url(#${arrowId})`} />
			<rect x="362" y="34" width="324" height="72" rx="16" fill="#F7F5EF" stroke="#B8B3A5" stroke-width="2" />
			<text x="524" y="77" text-anchor="middle" class="label ink">{text[1]}</text>
			<rect x="34" y="154" width="206" height="72" rx="16" fill="#D7ECE7" stroke="#0E7469" stroke-width="2" />
			<text x="137" y="197" text-anchor="middle" class="label petrol">{text[2]}</text>
			<path d="M256 190H346" class="arrow" marker-end={`url(#${arrowId})`} />
			<rect x="362" y="154" width="324" height="72" rx="16" fill="#E8E5F4" stroke="#5E4B8B" stroke-width="2" />
			<text x="524" y="197" text-anchor="middle" class="label violet">{text[3]}</text>
		</>
	)}

	{variant === 'training-samples' && (
		<>
			<rect x="34" y="42" width="250" height="176" rx="18" fill="#F7F5EF" stroke="#0A5148" stroke-width="2" />
			<text x="159" y="72" text-anchor="middle" class="label petrol">{text[0]}</text>
			<rect x="60" y="94" width="198" height="32" rx="9" fill="#D7ECE7" />
			<rect x="60" y="140" width="154" height="32" rx="9" fill="#D7ECE7" />
			<rect x="218" y="140" width="40" height="32" rx="9" fill="#FBF2E0" stroke="#986816" />
			<path d="M302 130H370" class="arrow" marker-end={`url(#${arrowId})`} />
			<rect x="386" y="64" width="300" height="132" rx="18" fill="#FFFFFF" stroke="#0E7469" stroke-width="2" />
			<text x="536" y="94" text-anchor="middle" class="label petrol">{text[2]}</text>
			<text x="420" y="134" class="small">{text[3]}</text><rect x="490" y="114" width="166" height="28" rx="8" fill="#D7ECE7" />
			<text x="420" y="176" class="small">{text[4]}</text><rect x="490" y="156" width="88" height="28" rx="8" fill="#FBF2E0" />
			<text x="190" y="197" text-anchor="middle" class="tiny-note amber">{text[1]}</text>
		</>
	)}

	{variant === 'score-loop' && (
		<>
			{[36, 210, 384, 558].map((x, index) => <rect x={x} y="82" width="126" height="96" rx="16" fill={index % 2 ? '#D7ECE7' : '#F7F5EF'} stroke={index === 1 ? '#0E7469' : '#B8B3A5'} stroke-width="2" />)}
			{text.map((label, index) => <text x={99 + index * 174} y="136" text-anchor="middle" class="small">{label}</text>)}
			{[174, 348, 522].map((x) => <path d={`M${x} 130H${x + 24}`} class="arrow" marker-end={`url(#${arrowId})`} />)}
			{/* pathLength is a multiple of the 7+8 dash period so the dash pattern
			    always ends exactly on a dash boundary at the marker -- without it,
			    the curve's true length lands mid-dash/mid-gap depending on layout,
			    leaving a stray partial dash next to the arrowhead that reads as a
			    second, malformed tip. */}
			<path d="M621 194C621 238 99 238 99 194" pathLength="525" fill="none" stroke="#986816" stroke-width="2" stroke-dasharray="7 8" marker-end={`url(#${arrowId})`} />
		</>
	)}

	{variant === 'fixed-pair' && (
		<>
			<rect x="34" y="48" width="254" height="164" rx="18" fill="#D7ECE7" stroke="#0E7469" stroke-width="2" />
			<text x="161" y="84" text-anchor="middle" class="label petrol">{text[0]}</text>
			<rect x="68" y="112" width="186" height="56" rx="12" fill="#FFFFFF" /><text x="161" y="146" text-anchor="middle" class="small">{text[1]}</text>
			<path d="M304 130H400" class="arrow" marker-end={`url(#${arrowId})`} />
			<rect x="416" y="48" width="270" height="164" rx="18" fill="#E8E5F4" stroke="#5E4B8B" stroke-width="2" />
			<text x="551" y="84" text-anchor="middle" class="label violet">{text[2]}</text>
			<rect x="450" y="112" width="202" height="56" rx="12" fill="#FFFFFF" /><text x="551" y="146" text-anchor="middle" class="small">{text[3]}</text>
			<rect x="244" y="20" width="232" height="38" rx="19" fill="#0A5148" /><text x="360" y="45" text-anchor="middle" class="tiny light">{text[4]}</text>
		</>
	)}

	{variant === 'split-jobs' && (
		<>
			<rect x="34" y="38" width="652" height="82" rx="18" fill="#D7ECE7" stroke="#0E7469" stroke-width="2" />
			<text x="70" y="72" class="label petrol">{text[0]}</text><text x="360" y="72" text-anchor="middle" class="label petrol">{text[1]}</text><text x="650" y="72" text-anchor="end" class="small">{text[2]}</text>
			<path d="M70 92H650" stroke="#7DC6B6" stroke-width="5" stroke-linecap="round" />
			<rect x="34" y="140" width="652" height="82" rx="18" fill="#E8E5F4" stroke="#5E4B8B" stroke-width="2" />
			<text x="70" y="174" class="label violet">{text[3]}</text><text x="360" y="174" text-anchor="middle" class="label violet">{text[4]}</text><text x="650" y="174" text-anchor="end" class="small">{text[5]}</text>
			<path d="M70 194H650" stroke="#B9AED6" stroke-width="5" stroke-linecap="round" />
		</>
	)}
</svg>

<style>
	.label { font: 600 18px 'IBM Plex Sans', sans-serif; }
	.small { font: 500 16px 'IBM Plex Sans', sans-serif; fill: #1b1a17; }
	.tiny { font: 600 14px 'IBM Plex Sans', sans-serif; }
	/* Smaller than .tiny -- this annotation sits inside a fixed-width box
	   (training-samples), so it must fit the narrowest translated string
	   without overflowing the container edge. */
	.tiny-note { font: 600 12px 'IBM Plex Sans', sans-serif; }
	.caption { font: 500 15px 'IBM Plex Sans', sans-serif; fill: #5f5b52; }
	.petrol { fill: #0a5148; }
	.amber { fill: #62430e; }
	.violet { fill: #49386f; }
	.ink { fill: #1b1a17; }
	.light { fill: #fff; }
	.arrow { fill: none; stroke: #0e7469; stroke-width: 3; stroke-linecap: round; }
</style>

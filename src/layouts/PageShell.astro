---
// The one brand shell every page wraps: fonts, tokens, meta, skip link, Nav
// and Footer. SiteLayout (homepage) and ContentEntryLayout (Bausteine,
// glossary) both build on this so the chrome can never drift apart between
// page types.
import '@fontsource/literata/700.css';
import '@fontsource/literata/800.css';
import '@fontsource/literata/600-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { MATOMO_URL, MATOMO_SITE_ID } from '../lib/matomo.ts';

interface Props {
	lang: 'de' | 'en';
	title: string;
	description: string;
	/** Counterpart URL in the other language — nav pill and hreflang alternate. */
	otherLangHref: string;
	/** Where the "Themenbereiche" nav/footer links point (homepage: local anchor). */
	themenHref?: string;
	/** Nav CTA target; omit to render no CTA (reading pages keep the chrome calm). */
	ctaHref?: string;
	ogType?: 'website' | 'article';
	/** Stub/preview pages that shouldn't compete with the real thing in search results. */
	noindex?: boolean;
}

const { lang, title, description, otherLangHref, themenHref = '#themenbereiche', ctaHref, ogType = 'website', noindex = false } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const homeHref = `/${lang}/`;
const skipLabel = lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content';
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		{/* Stored text-size preference, applied before first paint so the page
		    never flashes at the wrong size (see Nav toggle + tokens.css). */}
		<script is:inline>
			try {
				if (localStorage.getItem('kev:text-size') === 'large') document.documentElement.setAttribute('data-text-size', 'large');
			} catch (e) {
				/* localStorage unavailable — default size stands */
			}
		</script>
		{/* Real Bildmarke (small cut) — SVG plus the official raster exports. */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
		<link rel="alternate" hreflang={otherLang} href={otherLangHref} />
		<title>{title}</title>
		{MATOMO_SITE_ID > 0 && (
			// Cookie-free tracking: disableCookies before the first trackPageView.
			// IP anonymization / data retention are configured server-side in the
			// Matomo admin, not here -- this snippet alone doesn't complete the
			// project's cookie-free stance (DESIGN.md), only the client half of it.
			<script is:inline define:vars={{ matomoUrl: MATOMO_URL, siteId: MATOMO_SITE_ID }}>
				var _paq = (window._paq = window._paq || []);
				_paq.push(['disableCookies']);
				_paq.push(['trackPageView']);
				_paq.push(['enableLinkTracking']);
				(function () {
					_paq.push(['setTrackerUrl', matomoUrl + 'matomo.php']);
					_paq.push(['setSiteId', siteId]);
					var d = document,
						g = d.createElement('script'),
						s = d.getElementsByTagName('script')[0];
					g.async = true;
					g.src = matomoUrl + 'matomo.js';
					s.parentNode.insertBefore(g, s);
				})();
			</script>
		)}
	</head>
	<body>
		<a class="skip-link" href="#main">{skipLabel}</a>
		<Nav lang={lang} otherLangHref={otherLangHref} homeHref={homeHref} themenHref={themenHref} ctaHref={ctaHref} />
		<main id="main">
			<slot />
		</main>
		<Footer lang={lang} otherLangHref={otherLangHref} themenHref={themenHref} />
	</body>
</html>

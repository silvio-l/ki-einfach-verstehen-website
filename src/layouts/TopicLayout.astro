---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PageShell from './PageShell.astro';
import { getPublishedMap, readingMinutes } from '../data/published';
import { getPlannedBausteinHref, getThemenbereiche, getThemenbereichHref } from '../data/themenbereiche';
import { collectionGraph } from '../lib/structured-data';

interface Props {
	entry: CollectionEntry<'themenbereiche'>;
	lang: 'de' | 'en';
	Content: import('astro/runtime/server/index.js').AstroComponentFactory;
}

const { entry, lang, Content } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const allTopics = await getThemenbereiche(lang);
const topic = allTopics.find((candidate) => candidate.key === entry.data.translationKey);

if (!topic) throw new Error(`Topic metadata not found for ${entry.id}`);

const published = await getPublishedMap(lang);
const publishedHere = topic.bausteine
	.map((lesson) => published.get(`${topic.key}:${lesson.order}`))
	.filter((lesson) => lesson !== undefined);
const otherEntries = await getCollection('themenbereiche', (candidate) => candidate.id.startsWith(`${otherLang}/`));
const counterpart = otherEntries.find((candidate) => candidate.data.translationKey === entry.data.translationKey);
const otherLangHref = counterpart
	? `/${otherLang}/${otherLang === 'de' ? 'themenbereich' : 'topic'}/${counterpart.data.routeSlug}/`
	: `/${otherLang}/#themenbereiche`;

const glossarySegment = lang === 'de' ? 'glossar' : 'glossary';
const glossaryEntries = await getCollection('glossar', (candidate) => candidate.id.startsWith(`${lang}/`));
const glossarySlugs = new Set<string>();
for (const lesson of publishedHere) {
	const expression = new RegExp(`/${lang}/${glossarySegment}/([a-z0-9-]+)`, 'g');
	for (const match of lesson.body.matchAll(expression)) glossarySlugs.add(match[1]);
}
const relatedTerms = glossaryEntries
	.filter((term) => glossarySlugs.has(term.id.slice(lang.length + 1)))
	.sort((a, b) => a.data.title.localeCompare(b.data.title, lang));

const topicIndex = allTopics.findIndex((candidate) => candidate.key === topic.key);
const previousTopic = allTopics[topicIndex - 1];
const nextTopic = allTopics[topicIndex + 1];
const segments = topic.bausteine.map((lesson) => ({ tk: published.get(`${topic.key}:${lesson.order}`)?.tk }));
const firstReadable = publishedHere[0];
const homeHref = `/${lang}/`;
const topicsHref = `/${lang}/#themenbereiche`;

const copy = {
	de: {
		crumbLabel: 'Pfadnavigation',
		home: 'Startseite',
		topics: 'Themenbereiche',
		eyebrow: `Themenbereich ${topicIndex + 1} von ${allTopics.length}`,
		availability: `${publishedHere.length} von ${topic.bausteine.length} Bausteinen lesbar`,
		readProgress: (read: number) => `${read} von ${publishedHere.length} lesbaren Bausteinen gelesen`,
		readCaption: publishedHere.length === 1 ? 'lesbaren Baustein gelesen' : 'lesbare Bausteine gelesen',
		plannedCaption: 'Bausteine in Vorbereitung',
		readBadge: 'Gelesen',
		intro: 'Worum es hier geht',
		path: 'Die Bausteine in diesem Themenbereich',
		pathIntro: 'Jeder Baustein funktioniert für sich. In dieser Reihenfolge greifen die Begriffe besonders sauber ineinander.',
		ready: 'Jetzt lesbar',
		planned: 'In Vorbereitung',
		ctaStart: 'Loslegen',
		ctaResume: 'Weiterlesen',
		trackLabel: 'Fortschritt in diesem Themenbereich',
		minutes: (minutes: number) => `≈ ${minutes} Min.`,
		termsEyebrow: 'Zum Nachschlagen',
		terms: 'Begriffe aus diesem Themenbereich',
		termsIntro: 'Kurze Erklärungen zu den Fachbegriffen, die in den bereits lesbaren Bausteinen vorkommen.',
		previous: 'Vorheriger Themenbereich',
		next: 'Nächster Themenbereich',
		all: 'Alle Themenbereiche',
	},
	en: {
		crumbLabel: 'Breadcrumb',
		home: 'Home',
		topics: 'Topics',
		eyebrow: `Topic ${topicIndex + 1} of ${allTopics.length}`,
		availability: `${publishedHere.length} of ${topic.bausteine.length} lessons readable`,
		readProgress: (read: number) => `${read} of ${publishedHere.length} readable lessons completed`,
		readCaption: publishedHere.length === 1 ? 'readable lesson read' : 'readable lessons read',
		plannedCaption: 'lessons in preparation',
		readBadge: 'Read',
		intro: 'What this topic covers',
		path: 'Lessons in this topic',
		pathIntro: 'Every lesson stands on its own. In this order, the ideas connect especially clearly.',
		ready: 'Readable now',
		planned: 'In preparation',
		ctaStart: 'Start',
		ctaResume: 'Continue',
		trackLabel: 'Progress in this topic',
		minutes: (minutes: number) => `≈ ${minutes} min`,
		termsEyebrow: 'Look it up',
		terms: 'Terms from this topic',
		termsIntro: 'Short explanations of the technical terms used by the lessons already available.',
		previous: 'Previous topic',
		next: 'Next topic',
		all: 'All topics',
	},
}[lang];

const site = Astro.site!;
const jsonLd = collectionGraph({
	lang,
	url: new URL(Astro.url.pathname, site).href,
	name: topic.title,
	description: topic.description,
	items: publishedHere.map((lesson) => ({ name: lesson.title, url: new URL(lesson.href, site).href })),
		// The topics overview is only an anchor on the homepage, so it gets no crumb of its own.
	crumbs: [{ name: copy.home, url: new URL(homeHref, site).href }, { name: topic.title }],
});
---

<PageShell
	lang={lang}
	title={`${topic.title} — KI einfach verstehen`}
	description={topic.description}
	otherLangHref={otherLangHref}
	themenHref={topicsHref}
	jsonLd={jsonLd}
>
	<main class="topic-page" data-topic-page data-read-template={copy.readProgress(-1)}>
		<div class="wrap">
			<nav class="topic-crumbs" aria-label={copy.crumbLabel}>
				<ol>
					<li><a href={homeHref}>{copy.home}</a></li>
					<li><a href={topicsHref}>{copy.topics}</a></li>
					<li aria-current="page">{topic.title}</li>
				</ol>
			</nav>

			<header class="topic-hero">
				<div class="topic-heading">
					<p class="eyebrow">{copy.eyebrow}</p>
					<h1>{topic.title}</h1>
					<p class="topic-lede">{topic.description}</p>
				</div>
				<div class="topic-status">
					{publishedHere.length > 0 ? (
						<>
							<span class="topic-status-number" aria-hidden="true"><span data-topic-read-n>0</span>/{publishedHere.length}</span>
							<span class="topic-status-caption" aria-hidden="true">{copy.readCaption}</span>
							<span class="visually-hidden" data-topic-read>{copy.readProgress(0)}</span>
						</>
					) : (
						<>
							<span class="topic-status-number">{topic.bausteine.length}</span>
							<span class="topic-status-caption">{copy.plannedCaption}</span>
						</>
					)}
					<div class="topic-track" role="img" aria-label={copy.trackLabel}>
						{segments.map((seg) => (
							<span class:list={['seg', { 'is-ready': seg.tk }]} data-seg-tk={seg.tk} />
						))}
					</div>
					<span class="topic-availability">{copy.availability}</span>
					{firstReadable && (
						<a class="btn btn-primary topic-cta" data-topic-cta data-resume={copy.ctaResume} href={firstReadable.href}>{copy.ctaStart}</a>
					)}
				</div>
			</header>

			<section class="topic-intro" aria-labelledby="topic-intro-heading">
				<p class="eyebrow" id="topic-intro-heading">{copy.intro}</p>
				<div class="topic-prose"><Content /></div>
			</section>

			<section class="topic-path" aria-labelledby="topic-path-heading">
				<div class="section-heading">
					<div>
						<p class="eyebrow">{copy.eyebrow}</p>
						<h2 id="topic-path-heading">{copy.path}</h2>
					</div>
					<p>{copy.pathIntro}</p>
				</div>
				<ol class="lesson-list">
					{topic.bausteine.map((lesson) => {
						const available = published.get(`${topic.key}:${lesson.order}`);
						// Planned Bausteine with a reserved slug link to their
						// noindex "in Vorbereitung" stub page; without one (should
						// not happen) the row stays plain text as before.
						const plannedHref = available ? undefined : getPlannedBausteinHref(lesson, lang);
						const href = available?.href ?? plannedHref;
						return (
							<li class:list={['lesson-row', { 'is-planned': !available }]} data-tk={available?.tk}>
								<span class="lesson-number" aria-hidden="true">{String(lesson.order).padStart(2, '0')}</span>
								<div class="lesson-main">
									{href ? <h3><a href={href}>{lesson.title}</a></h3> : <h3>{lesson.title}</h3>}
									{available && <p>{available.description}</p>}
								</div>
								<div class="lesson-state">
									{available ? (
										<>
											<span class="state-read">{copy.readBadge}</span>
											<span class="lesson-minutes">{copy.minutes(readingMinutes(available.body, available.quiz))}</span>
										</>
									) : (
										<span class="state-label">{copy.planned}</span>
									)}
								</div>
							</li>
						);
					})}
				</ol>
			</section>

			{relatedTerms.length > 0 && (
				<section class="topic-terms" aria-labelledby="topic-terms-heading">
					<div>
						<p class="eyebrow">{copy.termsEyebrow}</p>
						<h2 id="topic-terms-heading">{copy.terms}</h2>
						<p>{copy.termsIntro}</p>
					</div>
					<ul>
						{relatedTerms.map((term) => (
							<li><a href={`/${lang}/${glossarySegment}/${term.id.slice(lang.length + 1)}/`}>{term.data.title}</a></li>
						))}
					</ul>
				</section>
			)}

			<nav class="topic-neighbors" aria-label={copy.topics}>
				{previousTopic ? (
					<a href={getThemenbereichHref(previousTopic, lang)}><span>{copy.previous}</span><strong>← {previousTopic.title}</strong></a>
				) : <span />}
				<a class="all-topics" href={topicsHref}>{copy.all}</a>
				{nextTopic ? (
					<a class="next-topic" href={getThemenbereichHref(nextTopic, lang)}><span>{copy.next}</span><strong>{nextTopic.title} →</strong></a>
				) : <span />}
			</nav>
		</div>
	</main>
</PageShell>

<script>
	import { getReadSet } from '../scripts/progress.js';

	try {
		const root = document.querySelector('[data-topic-page]');
		if (root) {
			const read = getReadSet();
			let count = 0;
			root.querySelectorAll('.lesson-row[data-tk]').forEach((row) => {
				const key = row.getAttribute('data-tk');
				if (key && read.has(key)) {
					row.classList.add('is-read');
					count += 1;
				}
			});
			const output = root.querySelector('[data-topic-read]');
			const template = root.getAttribute('data-read-template');
			if (output && template) output.textContent = template.replace('-1', String(count));
			const n = root.querySelector('[data-topic-read-n]');
			if (n) n.textContent = String(count);
			root.querySelectorAll('[data-seg-tk]').forEach((seg) => {
				const key = seg.getAttribute('data-seg-tk');
				if (key && read.has(key)) seg.classList.add('is-read');
			});
			const cta = root.querySelector<HTMLAnchorElement>('[data-topic-cta]');
			if (cta && count > 0) {
				const next = [...root.querySelectorAll('.lesson-row[data-tk]')].find((row) => !row.classList.contains('is-read'));
				const link = next?.querySelector('h3 a');
				if (link instanceof HTMLAnchorElement) {
					cta.href = link.href;
					cta.textContent = cta.dataset.resume ?? cta.textContent;
				} else {
					cta.hidden = true;
				}
			}
		}
	} catch {
		/* progressive enhancement only */
	}
</script>

<style>
	.topic-page { padding: var(--sp-sm) 0 var(--sp-2xl); }
	/* Breadcrumb — same treatment as the article shell (ContentEntryLayout):
	   1rem petrol links, '/' separators. One crumb vocabulary site-wide. */
	.topic-crumbs { margin: var(--sp-md) 0 var(--sp-xl); font-size: 1rem; color: var(--ink-muted); }
	.topic-crumbs ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-xs); padding: 0; }
	.topic-crumbs li { display: flex; align-items: center; gap: var(--sp-xs); }
	.topic-crumbs li + li::before { content: '/'; color: var(--line-deep); }
	.topic-crumbs a { text-decoration: none; font-weight: 500; }
	.topic-crumbs a:hover { text-decoration: underline; text-underline-offset: 4px; }
	/* Phones: collapse the trail to one back-link (same rule as ContentEntryLayout). */
	@media (max-width: 640px) {
		.topic-crumbs li:not(:nth-last-child(2)) { display: none; }
		.topic-crumbs li + li:nth-last-child(2)::before,
		.topic-crumbs li:first-child:nth-last-child(2)::before { content: '←'; color: inherit; }
	}
	.topic-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(210px, 280px); gap: var(--sp-xl); align-items: end; padding-bottom: var(--sp-xl); border-bottom: 1px solid var(--line); }
	.topic-heading { max-width: 780px; }
	/* Display tier from the documented ramp (DESIGN.md typography.display) —
	   the topic page opens a section, so it earns the display size, but on the
	   ramp, not past it. */
	.topic-heading h1 { margin-top: var(--sp-xs); font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.05; letter-spacing: -0.01em; }
	.topic-lede { margin-top: var(--sp-md); max-width: 65ch; color: var(--ink-muted); font-size: 1.25rem; line-height: 1.6; }
	.topic-status { display: grid; gap: 5px; color: var(--ink-muted); font-size: 1rem; }
	.topic-status-number { font-family: var(--font-serif); font-weight: 700; font-size: 2.75rem; line-height: 1; color: var(--ink); }
	.topic-status-caption { color: var(--ink); font-weight: 500; }
	.topic-availability { font-size: 0.9rem; }
	/* One segment per Baustein: outline = planned, petrol = readable, amber = read (amber = progress only). */
	.topic-track { list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; margin: var(--sp-xs) 0; padding: 0; }
	.seg { height: 8px; border-radius: var(--r-pill); border: 1.5px solid var(--line-deep); }
	.seg.is-ready { background: var(--petrol-viv); border-color: var(--petrol-viv); }
	.seg.is-read { background: var(--amber-viv); border-color: var(--amber-viv); }
	.topic-cta { justify-self: start; margin-top: var(--sp-xs); }
	.topic-cta[hidden] { display: none; }
	.topic-intro { display: grid; grid-template-columns: minmax(160px, 0.35fr) minmax(0, 1fr); gap: var(--sp-xl); padding: var(--sp-xl) 0; }
	.topic-prose { max-width: 53rem; color: var(--ink-muted); font-size: 1.125rem; line-height: 1.75; }
	.topic-prose :global(p + p) { margin-top: var(--sp-sm); }
	.topic-path { padding: var(--sp-xl) 0; }
	.section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr); gap: var(--sp-xl); align-items: end; margin-bottom: var(--sp-lg); }
	.section-heading h2, .topic-terms h2 { margin-top: var(--sp-xs); }
	.section-heading > p, .topic-terms > div > p:last-child { color: var(--ink-muted); line-height: 1.65; }
	.lesson-list { list-style: none; padding: 0; border-top: 1px solid var(--petrol-deep); }
	.lesson-row { display: grid; grid-template-columns: 70px minmax(0, 1fr) minmax(125px, auto); gap: var(--sp-md); align-items: start; padding: var(--sp-md) 0; border-bottom: 1px solid var(--line); }
	.lesson-number { font-family: var(--font-serif); font-weight: 700; font-size: 1.75rem; color: var(--petrol-deep); }
	.lesson-main h3 { font-size: 1.25rem; line-height: 1.35; }
	.lesson-main h3 a { color: var(--ink); text-decoration: none; }
	.lesson-main h3 a:hover { color: var(--petrol-deep); text-decoration: underline; text-underline-offset: 4px; }
	.lesson-main p { margin-top: 7px; max-width: 53rem; color: var(--ink-muted); line-height: 1.55; }
	.lesson-state { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; text-align: right; }
	/* Tracked-uppercase state chip = the eyebrow tier (DESIGN.md scale "12"). */
	.state-label { color: var(--ink-muted); text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.16em; font-weight: 500; }
	.lesson-minutes { color: var(--ink-muted); font-size: 1rem; }
	/* Muted colour, not opacity: faded text would fall below 4.5:1 (WCAG 1.4.3). */
	.lesson-row.is-planned :is(h3, .lesson-number) { color: var(--ink-muted); }
	.state-read { display: none; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--amber-deep); background: var(--amber-soft); padding: 3px 10px; border-radius: var(--r-pill); }
	.lesson-row.is-read .state-read { display: inline-block; }
	.lesson-row.is-read .lesson-number { color: var(--amber-deep); }
	.topic-terms { margin: var(--sp-xl) 0; padding: var(--sp-lg); display: grid; grid-template-columns: minmax(240px, 0.65fr) minmax(0, 1fr); gap: var(--sp-xl); background: var(--ground-zone); border: 1px solid var(--petrol-deep); border-radius: var(--r-xl); }
	.topic-terms ul { list-style: none; display: flex; flex-wrap: wrap; align-content: start; gap: 10px; padding: 0; }
	.topic-terms li a { display: block; padding: 7px 12px; color: var(--petrol-deep); background: var(--ground-page); border: 1px solid var(--line); border-radius: var(--r-pill); text-decoration: none; font-weight: 500; }
	.topic-terms li a:hover { border-color: var(--petrol-deep); }
	.topic-neighbors { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--sp-md); align-items: center; padding-top: var(--sp-lg); border-top: 1px solid var(--line); }
	.topic-neighbors > a:not(.all-topics) { display: grid; gap: 5px; color: var(--ink); text-decoration: none; }
	.topic-neighbors span { color: var(--ink-muted); font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; }
	.topic-neighbors strong { color: var(--petrol-deep); }
	.topic-neighbors .next-topic { text-align: right; }
	.topic-neighbors > a:not(.all-topics):hover strong { text-decoration: underline; text-underline-offset: 4px; }
	.all-topics { color: var(--ink-muted); font-weight: 600; }

	/* Entrance in reading order — the same motion language as the article and
	   stub shells (ContentEntryLayout/StubLessonLayout). */
	@media (prefers-reduced-motion: no-preference) {
		.topic-crumbs,
		.topic-hero {
			animation: topic-rise 0.55s cubic-bezier(0.2, 0.6, 0.2, 1) both;
		}
		.topic-hero {
			animation-delay: 0.12s;
		}
		@keyframes topic-rise {
			from {
				transform: translateY(12px);
			}
		}
	}
	@media (max-width: 760px) {
		.topic-hero, .topic-intro, .section-heading, .topic-terms { grid-template-columns: 1fr; gap: var(--sp-md); }
		/* Neutral hairline pause between lede and status block — deliberately
		   NOT a colored accent bar (see DESIGN.md blockquote note: side-tab
		   accent borders are a rejected pattern). */
		.topic-status { border-top: 1px solid var(--line); padding-top: var(--sp-md); }
		.lesson-row { grid-template-columns: 44px minmax(0, 1fr); gap: var(--sp-sm); }
		.lesson-state { grid-column: 2; align-items: flex-start; text-align: left; }
		.topic-neighbors { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
		.all-topics { grid-column: 1 / -1; grid-row: 1; text-align: center; }
	}
	/* Narrow phones (and large reader text): stack previous / next instead of squeezing two columns. */
	@media (max-width: 520px) {
		.topic-neighbors { grid-template-columns: minmax(0, 1fr); }
		.topic-neighbors .next-topic { text-align: left; }
	}
</style>

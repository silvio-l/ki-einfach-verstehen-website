---
// Reading shell for both content collections, on the full Leuchtkern chrome
// (PageShell → Nav/Footer). Two registers, one system — and both use the
// full elastic --shell frame end to end (rail + prose columns span it, so the
// article's right edge meets the nav/footer edge); only the running text is
// capped at the local ~72ch reading measure:
//   – Bausteine: full article frame — breadcrumb on the shell edge, a wide
//     two-column body (sticky meta/TOC rail + measured prose), amber
//     reading-progress hairline, the sanctioned section-end phyllotaxis
//     mark, and an honest "what's next" outro that never links to unwritten
//     content.
//   – Glossar: a deliberately lighter frame — badge, term, a sticky "Kurz
//     gesagt" definition card beside a compact body. No progress chrome; a
//     glossary entry is a lookup, not a journey.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import PageShell from './PageShell.astro';
import RetrievalQuiz from '../components/RetrievalQuiz.astro';
import BausteinFeedback from '../components/BausteinFeedback.astro';
import BausteinActions from '../components/BausteinActions.astro';
import GithubStarCta from '../components/GithubStarCta.astro';
import LastChange from '../components/LastChange.astro';
import { getPublishedMap, readingMinutes } from '../data/published';
import { getThemenbereiche, getThemenbereichHref } from '../data/themenbereiche';
import { getFeedbackTallies } from '../lib/matomo-feedback';

const ROUTE_SEGMENTS = {
	bausteine: { de: 'bausteine', en: 'lessons' },
	glossar: { de: 'glossar', en: 'glossary' },
} as const;

interface Props {
	entry: CollectionEntry<'bausteine'> | CollectionEntry<'glossar'>;
	collection: keyof typeof ROUTE_SEGMENTS;
	lang: 'de' | 'en';
	/** Rendered markdown headings (Baustein routes) — feeds the rail TOC. */
	headings?: MarkdownHeading[];
}

const { entry, collection, lang, headings = [] } = Astro.props;
const themenbereiche = await getThemenbereiche(lang);
const otherLang = lang === 'de' ? 'en' : 'de';

const otherLangEntries = await getCollection(collection, (e) =>
	e.id.startsWith(`${otherLang}/`),
);
const counterpart = otherLangEntries.find(
	(e) => e.data.translationKey === entry.data.translationKey,
);
const counterpartHref = counterpart
	? `/${otherLang}/${ROUTE_SEGMENTS[collection][otherLang]}/${counterpart.id.slice(otherLang.length + 1)}/`
	: undefined;

const homeHref = `/${lang}/`;
const themenHref = `/${lang}/#themenbereiche`;
const glossIndexHref = `/${lang}/${ROUTE_SEGMENTS.glossar[lang]}/`;
// Language pill fallback when no counterpart exists: the equivalent overview,
// never a dead link.
const otherLangHref =
	counterpartHref ?? (collection === 'glossar' ? `/${otherLang}/${ROUTE_SEGMENTS.glossar[otherLang]}/` : `/${otherLang}/`);

const toc = headings.filter((h) => h.depth === 2);

// ——— Baustein metadata (roadmap position, honest next step) ———
const isBaustein = collection === 'bausteine';
const quizQuestions = entry.collection === 'bausteine' ? entry.data.quiz : [];
let baustein:
	| {
			tbTitle: string;
			tbCount: number;
			order: number;
			overall: number;
			totalAll: number;
			minutes: number;
			topicHref: string;
			nextTitle?: string;
			nextHref?: string;
			helpfulPercent?: number;
			helpfulVotes?: number;
			mdHref: string;
	  }
	| undefined;

if (entry.collection === 'bausteine') {
	const tbIndex = themenbereiche.findIndex((t) => t.key === entry.data.themenbereich);
	const tb = themenbereiche[tbIndex];
	const totalAll = themenbereiche.reduce((n, t) => n + t.bausteine.length, 0);
	const overall =
		themenbereiche.slice(0, Math.max(tbIndex, 0)).reduce((n, t) => n + t.bausteine.length, 0) + entry.data.order;

	// Roadmap-next: the following slot in this Themenbereich, else the first of
	// the next one. Only linked if that Baustein actually exists as content.
	let next: { slug: string; order: number; title: string } | undefined;
	const inTb = tb?.bausteine.find((b) => b.order === entry.data.order + 1);
	if (tb && inTb) {
		next = { slug: tb.key, order: inTb.order, title: inTb.title };
	} else {
		const nextTb = themenbereiche[tbIndex + 1];
		if (nextTb?.bausteine[0]) {
			next = { slug: nextTb.key, order: nextTb.bausteine[0].order, title: nextTb.bausteine[0].title };
		}
	}
	const nextPub = next ? (await getPublishedMap(lang)).get(`${next.slug}:${next.order}`) : undefined;
	const feedback = (await getFeedbackTallies()).get(entry.data.translationKey);
	// The `[slug].md` endpoint (src/pages/{de/bausteine,en/lessons}/[slug].md.ts)
	// sits next to this Baustein's own HTML route -- same segment, same slug.
	const bausteinSlug = entry.id.slice(lang.length + 1);

	baustein = {
		tbTitle: tb?.title ?? entry.data.themenbereich,
		tbCount: tb?.bausteine.length ?? 0,
		order: entry.data.order,
		overall,
		totalAll,
		minutes: readingMinutes(entry.body ?? ''),
		topicHref: tb ? getThemenbereichHref(tb, lang) : themenHref,
		nextTitle: next?.title,
		nextHref: nextPub?.href,
		helpfulPercent: feedback?.helpfulPercent,
		helpfulVotes: feedback?.total,
		mdHref: `/${lang}/${ROUTE_SEGMENTS.bausteine[lang]}/${bausteinSlug}.md`,
	};
}

const copy = {
	de: {
		crumbLabel: 'Pfadnavigation',
		home: 'Startseite',
		themen: 'Themenbereiche',
		glossar: 'Glossar',
		slot: (b: NonNullable<typeof baustein>) => `Baustein ${b.order} von ${b.tbCount} · ${b.tbTitle}`,
		readBadge: 'Gelesen',
		helpfulBadge: (percent: number, votes: number) => `${percent}% fanden das hilfreich (${votes} Stimmen)`,
		minutes: (m: number) => `≈ ${m} Min. Lesezeit`,
		langLink: 'Read this in English',
		tocTitle: 'Auf dieser Seite',
		backOverview: 'Zurück zur Übersicht',
		outroEyebrow: 'Wie geht es weiter?',
		outroDone: (b: NonNullable<typeof baustein>) => `Das war Baustein ${b.overall} von ${b.totalAll} auf dem Weg.`,
		outroNextReadyPre: 'Weiter geht es direkt mit dem nächsten Baustein: ',
		outroNextReadyPost: '.',
		outroNextPrepPre: 'Der nächste — ',
		outroNextPrepPost: ' — ist gerade in Vorbereitung und erscheint hier, sobald er fertig geschrieben ist.',
		outroEnd: 'Damit ist der Fahrplan komplett durchgelesen.',
		nextCta: 'Nächsten Baustein lesen',
		overviewCta: 'Alle Themenbereiche',
		defLabel: 'Kurz gesagt',
		backAll: 'Alle Begriffe im Glossar',
	},
	en: {
		crumbLabel: 'Breadcrumb',
		home: 'Home',
		themen: 'Topics',
		glossar: 'Glossary',
		slot: (b: NonNullable<typeof baustein>) => `Lesson ${b.order} of ${b.tbCount} · ${b.tbTitle}`,
		readBadge: 'Read',
		helpfulBadge: (percent: number, votes: number) => `${percent}% found this helpful (${votes} votes)`,
		minutes: (m: number) => `≈ ${m} min read`,
		langLink: 'Auf Deutsch lesen',
		tocTitle: 'On this page',
		backOverview: 'Back to the overview',
		outroEyebrow: 'What comes next?',
		outroDone: (b: NonNullable<typeof baustein>) => `That was lesson ${b.overall} of ${b.totalAll} on the path.`,
		outroNextReadyPre: 'The next lesson is ready for you: ',
		outroNextReadyPost: '.',
		outroNextPrepPre: 'The next one — ',
		outroNextPrepPost: " — is currently in preparation and will appear here as soon as it's written.",
		outroEnd: 'With that, you have read the complete roadmap.',
		nextCta: 'Read the next lesson',
		overviewCta: 'Browse all topics',
		defLabel: 'In short',
		backAll: 'All glossary terms',
	},
}[lang];

// Google truncates <title> around 65 chars/600px. " — KI einfach verstehen"
// is 23 chars, so only append it when the entry title leaves room --
// otherwise the brand suffix would push the real title itself out of the
// SERP snippet.
const BRAND_SUFFIX = ' — KI einfach verstehen';
const TITLE_SUFFIX_MAX_LENGTH = 42;
const pageTitle = entry.data.title.length <= TITLE_SUFFIX_MAX_LENGTH ? `${entry.data.title}${BRAND_SUFFIX}` : entry.data.title;
---

<PageShell
	lang={lang}
	title={pageTitle}
	description={entry.data.description}
	otherLangHref={otherLangHref}
	hasTranslation={!!counterpartHref}
	themenHref={themenHref}
	ogType="article"
>
	{
		isBaustein && baustein ? (
			<div class="wrap entry-scope">
				<div class="read-progress" aria-hidden="true" />
				<nav class="crumbs" aria-label={copy.crumbLabel}>
					<ol>
						<li>
							<a href={homeHref}>{copy.home}</a>
						</li>
						<li>
							<a href={themenHref}>{copy.themen}</a>
						</li>
						<li><a href={baustein.topicHref}>{baustein.tbTitle}</a></li>
						<li aria-current="page">{entry.data.title}</li>
					</ol>
				</nav>
				<article class="article">
					<header class="art-head">
						<p class="art-slot">
							<span class="eyebrow">{copy.slot(baustein)}</span>
							<span class="badge-progress" data-read-badge hidden>
								{copy.readBadge}
							</span>
						</p>
						<h1 class="art-title">{entry.data.title}</h1>
						{baustein.helpfulPercent !== undefined && baustein.helpfulVotes !== undefined && (
							<p class="badge-helpful">
								<svg class="badge-helpful-icon" viewBox="0 0 24 24" aria-hidden="true">
									<path
										d="M7 10v12M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"
									/>
								</svg>
								{copy.helpfulBadge(baustein.helpfulPercent, baustein.helpfulVotes)}
							</p>
						)}
						<p class="art-lede">{entry.data.description}</p>
						<BausteinActions lang={lang} mdHref={baustein.mdHref} entryId={entry.id} variant="header" />
					</header>
					<aside class="art-rail">
						<div class="rail-box">
							<p class="rail-meta">
								<span>{copy.minutes(baustein.minutes)}</span>
								{counterpartHref && (
									<a href={counterpartHref} hreflang={otherLang}>
										{copy.langLink}
									</a>
								)}
							</p>
							{toc.length > 1 && (
								<nav class="toc" aria-label={copy.tocTitle} data-toc>
									<p class="rail-label">{copy.tocTitle}</p>
									<ol>
										{toc.map((h) => (
											<li>
												<a href={`#${h.slug}`}>{h.text}</a>
											</li>
										))}
									</ol>
								</nav>
							)}
							<p class="rail-back">
								<a href={baustein.topicHref}>
									<span class="back-arrow" aria-hidden="true">←</span> {copy.backOverview}
								</a>
							</p>
						</div>
					</aside>
					<div class="prose">
						<slot />
					</div>
					{quizQuestions.length > 0 && (
						<RetrievalQuiz
							lang={lang}
							translationKey={entry.data.translationKey}
							questions={quizQuestions}
						/>
					)}
				</article>
				<div data-read-sentinel data-tk={entry.data.translationKey} />
				{/* Section-end phyllotaxis mark — the second sanctioned motif
				    placement (DESIGN.md §4: "closing a Baustein"). */}
				<div class="art-mark" aria-hidden="true">
					<svg id="artmark" viewBox="0 0 72 72" />
				</div>
				<aside class="outro" aria-label={copy.outroEyebrow}>
					<p class="eyebrow">{copy.outroEyebrow}</p>
					<p class="outro-text">
						{copy.outroDone(baustein)}{' '}
						{baustein.nextTitle ? (
							baustein.nextHref ? (
								<>{copy.outroNextReadyPre}<em>{baustein.nextTitle}</em>{copy.outroNextReadyPost}</>
							) : (
								<>{copy.outroNextPrepPre}<em>{baustein.nextTitle}</em>{copy.outroNextPrepPost}</>
							)
						) : (
							copy.outroEnd
						)}
					</p>
					<div class="outro-actions">
						{baustein.nextHref && (
							<a class="btn btn-primary" href={baustein.nextHref}>
								{copy.nextCta}
							</a>
						)}
						<a class="btn btn-secondary" href={themenHref}>
							{copy.overviewCta}
						</a>
					</div>
				</aside>
				<BausteinFeedback lang={lang} translationKey={entry.data.translationKey} />
				<BausteinActions lang={lang} mdHref={baustein.mdHref} entryId={entry.id} variant="footer" />
				<GithubStarCta lang={lang} />
				<LastChange filePath={entry.filePath} lang={lang} />
			</div>
		) : (
			<div class="wrap entry-scope">
				<nav class="crumbs" aria-label={copy.crumbLabel}>
					<ol>
						<li>
							<a href={homeHref}>{copy.home}</a>
						</li>
						<li>
							<a href={glossIndexHref}>{copy.glossar}</a>
						</li>
						<li aria-current="page">{entry.data.title}</li>
					</ol>
				</nav>
				<article class="gloss">
					<header class="gloss-head">
						<p class="gloss-badge">
							<span class="badge">{copy.glossar}</span>
						</p>
						<h1 class="gloss-title">{entry.data.title}</h1>
					</header>
					<aside class="gloss-rail">
						<div class="gloss-def">
							<p class="gloss-def-label">{copy.defLabel}</p>
							<p class="gloss-def-text">{entry.data.description}</p>
						</div>
						<p class="gloss-meta">
							{counterpartHref && (
								<a href={counterpartHref} hreflang={otherLang}>
									{copy.langLink}
								</a>
							)}
						</p>
						<p class="gloss-back">
							<a href={glossIndexHref}>
								<span class="back-arrow" aria-hidden="true">←</span> {copy.backAll}
							</a>
						</p>
					</aside>
					<div class="prose prose-gloss">
						<slot />
					</div>
				</article>
				<LastChange filePath={entry.filePath} lang={lang} />
			</div>
		)
	}
</PageShell>

<script>
	// Reading-progress source of truth: a Baustein counts as read once the
	// reader actually reaches its end (sentinel below the article), not on
	// page load. Keyed by translationKey — see progress.js. The header badge
	// is a progressive mirror of that state: visible on load for returning
	// readers, revealed live the moment the end is reached.
	import { markRead, getReadSet } from '../scripts/progress.js';

	const sentinel = document.querySelector('[data-read-sentinel]');
	const tk = sentinel?.getAttribute('data-tk');
	const badge = document.querySelector('[data-read-badge]');
	const showBadge = () => badge?.removeAttribute('hidden');

	try {
		if (tk && getReadSet().has(tk)) showBadge();
	} catch {
		/* progressive enhancement only */
	}

	if (sentinel && tk && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			if (entries.some((e) => e.isIntersecting)) {
				markRead(tk);
				showBadge();
				observer.disconnect();
			}
		});
		observer.observe(sentinel);
	}
</script>

<script>
	// Section-end mark: one small, low-density, static instance of the motif —
	// same parametric family as the Wegkarte goal mark, petrol on white.
	import { bloom } from '../scripts/bloom.js';

	bloom(document.getElementById('artmark'), {
		n: 48,
		r: 27,
		cx: 36,
		cy: 36,
		seed: 7,
		innerColor: '#0A5148',
		outerColor: '#12907F',
		edgeW: 0.6,
		nodeMin: 0.7,
		nodeMax: 1.9,
		glow: false,
		filaments: false,
		satellites: false,
	});
</script>

<script>
	// TOC scroll-spy: the amber "you are here" marker follows the section
	// currently at the top of the viewport. Progressive enhancement — without
	// it the TOC is a plain anchor list.
	const links = [...document.querySelectorAll('[data-toc] a')] as HTMLAnchorElement[];
	if (links.length && 'IntersectionObserver' in window) {
		const bySlug = new Map<Element, HTMLAnchorElement>();
		for (const a of links) {
			const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
			if (el) bySlug.set(el, a);
		}
		const setActive = (a: HTMLAnchorElement) => {
			links.forEach((l) => l.removeAttribute('aria-current'));
			a.setAttribute('aria-current', 'true');
		};
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						const a = bySlug.get(e.target);
						if (a) setActive(a);
					}
				}
			},
			// A heading becomes "current" while it sits in the top third.
			{ rootMargin: '0px 0px -66% 0px' },
		);
		bySlug.forEach((_, el) => io.observe(el));
	}
</script>

<style>
	/* The page frame is the shared elastic --shell (via .wrap), used end to
	   end; only the running text carries the local reading measure. */
	.entry-scope {
		/* ONE reading measure for everything — running text AND explanatory
		   media (code, tables, details, images, diagrams). A wider media
		   breakout was tried and rejected (2026-08-24): two right edges read
		   as an inconsistent page, and widening the text instead would push
		   body lines far past comfortable length (measured ~103 real chars
		   per line already at 53rem; 64rem would be ~124). The measure is set
		   in rem, not ch: ch recomputes per element font-size — h2/h3 were
		   getting a far wider cap than paragraphs, so headings and body text
		   never shared a left edge. One rem value = one shared column. */
		--measure: 53rem;
		padding-top: var(--sp-lg);
		padding-bottom: var(--sp-3xl);
		timeline-scope: --art;
	}

	/* ——— Breadcrumb: full shell width, flush with the nav brand edge ——— */
	.crumbs ol {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--sp-xs);
		font-size: 1rem;
		color: var(--ink-muted);
	}
	.crumbs li {
		display: flex;
		align-items: center;
		gap: var(--sp-xs);
		min-width: 0;
	}
	.crumbs li + li::before {
		content: '/';
		color: var(--line-deep);
	}
	.crumbs a {
		text-decoration: none;
		font-weight: 500;
	}
	.crumbs a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.crumbs [aria-current='page'] {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ——— Baustein article: header across, rail + prose beneath ——— */
	.article {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		margin-top: var(--sp-xl);
	}
	.art-head {
		padding-bottom: var(--sp-lg);
		margin-bottom: var(--sp-lg);
		border-bottom: 1px solid var(--line);
	}
	/* Header text sits on the SAME centered reading column as the prose below
	   it — eyebrow, title, lede, hairline and body paragraphs share one edge. */
	.art-slot {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--sp-sm);
		margin-bottom: var(--sp-sm);
	}
	.art-slot,
	.art-title,
	.badge-helpful,
	.art-lede {
		width: min(100%, var(--measure));
		margin-inline: auto;
	}
	.art-title {
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		margin-bottom: var(--sp-sm);
	}
	.art-lede {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	/* Meta/TOC rail */
	.rail-box {
		display: flex;
		flex-direction: column;
		gap: var(--sp-md);
	}
	.rail-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--sp-xs) var(--sp-md);
		font-size: 1rem;
		color: var(--ink-muted);
	}
	.rail-meta a {
		font-weight: 500;
	}
	.rail-label {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--ink-muted);
		margin-bottom: var(--sp-xs);
	}
	.toc ol {
		list-style: none;
		display: flex;
		flex-direction: column;
	}
	.toc a {
		display: block;
		padding: 6px 0 6px var(--sp-sm);
		border-left: 2px solid var(--line);
		font-size: 1rem;
		line-height: 1.4;
		color: var(--ink-muted);
		text-decoration: none;
		/* The scroll-spy marker glides between sections instead of snapping —
		   a position indicator, not a blink. */
		transition:
			color 0.18s ease,
			border-color 0.18s ease,
			padding-left 0.18s ease;
	}
	.toc a:hover {
		color: var(--petrol-deep);
		border-left-color: var(--petrol-deep);
	}
	.toc a[aria-current] {
		padding-left: calc(var(--sp-sm) + 4px);
	}
	/* Amber = reading-position marker (DESIGN.md amber scope). */
	.toc a[aria-current] {
		color: var(--amber-deep);
		border-left-color: var(--amber-viv);
		font-weight: 600;
	}
	.rail-back {
		font-size: 1rem;
	}
	.rail-back a,
	.gloss-back a {
		text-decoration: none;
		font-weight: 600;
	}
	.rail-back a:hover,
	.gloss-back a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.back-arrow {
		display: inline-block;
		transition: transform 0.18s ease;
	}
	.rail-back a:hover .back-arrow,
	.gloss-back a:hover .back-arrow {
		transform: translateX(-4px);
	}

	/* ——— Prose (rendered markdown) ———
	   The prose COLUMN fills its grid track out to the shell edge; the shared
	   reading measure is applied per element, so text, code blocks, excursion
	   cards, tables and figures all sit on the same centered column with one
	   left and one right edge. */
	.prose {
		min-width: 0;
		font-size: 1.125rem;
		line-height: 1.75;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(blockquote),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(pre),
	.prose :global(details),
	.prose :global(table) {
		width: min(100%, var(--measure));
		max-width: var(--measure);
		margin-inline: auto;
	}
	/* A small icon figure (see Figure.astro) floats beside the paragraph
	   that introduces it. Every other block clears it -- only running
	   paragraphs wrap alongside a floated icon. */
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(blockquote),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(pre),
	.prose :global(details),
	.prose :global(table) {
		clear: both;
	}
	/* Every explanatory image and inline diagram receives the same editorial
	   frame. This is the default for future Bausteine, not per-article polish. */
	.prose :global(img),
	.prose :global(svg) {
		display: block;
		max-width: 100%;
		height: auto;
		margin-block: clamp(2rem, 5vw, 4rem);
		margin-inline: auto;
		padding: clamp(12px, 2vw, 28px);
		background: linear-gradient(145deg, var(--ground-page), var(--ground-zone));
		border: 1px solid var(--line-deep);
		border-radius: var(--r-xl);
		box-shadow: 0 18px 48px rgba(3, 39, 35, 0.08);
	}
	/* Inline diagrams fill the shared reading measure. Raster/vector
	   illustrations with explicit dimensions keep their intentional scale
	   inside the frame. */
	.prose :global(svg) {
		width: min(100%, var(--measure));
	}
	.prose :global(p) {
		margin-bottom: 1.35em;
	}
	.prose :global(h2) {
		font-size: 1.75rem;
		line-height: 1.2;
		margin-block: 2.2em 0.8em;
	}
	/* TOC/anchor jumps land below the sticky nav and progress hairline. */
	.prose :global(h2),
	.prose :global(h3) {
		scroll-margin-top: calc(var(--nav-h) + var(--sp-md));
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.prose :global(a) {
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.prose :global(a:hover) {
		text-decoration-thickness: 2px;
	}
	.prose :global(strong) {
		font-weight: 600;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.4em;
		margin-bottom: 1.25em;
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
	.prose :global(li::marker) {
		color: var(--petrol-deep);
	}
	/* Editorial quote mark instead of the generic colored-rule treatment —
	   ties blockquotes to the serif brand voice rather than a stock UI tell. */
	.prose :global(blockquote) {
		position: relative;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15em;
		line-height: 1.5;
		color: var(--ink-muted);
		padding-left: 1.1em;
		margin-bottom: 1.25em;
	}
	.prose :global(blockquote::before) {
		content: '\201C';
		position: absolute;
		left: 0;
		top: -0.05em;
		font-style: normal;
		font-size: 1.7em;
		line-height: 1;
		color: var(--petrol-soft);
	}
	.prose :global(code) {
		font-family: ui-monospace, monospace;
		font-size: 0.95em;
		background: var(--ground-zone);
		border-radius: var(--r-sm);
		padding: 0.1em 0.35em;
	}
	/* Shiki code blocks arrive with their own inline theme background — the
	   frame (padding, radius, horizontal scroll) is our job. */
	.prose :global(pre) {
		padding: var(--sp-sm) var(--sp-md);
		border-radius: var(--r-lg);
		overflow-x: auto;
		margin-block: 1.6em;
		line-height: 1.6;
	}
	.prose :global(pre code) {
		font-size: 1rem;
		background: none;
		border-radius: 0;
		padding: 0;
	}
	/* Markdown tables — hairline frame from the token lines, zone header row,
	   spacing-token cell padding. tabular-nums keeps number columns (scores,
	   counts) vertically aligned. */
	.prose :global(table) {
		border-collapse: collapse;
		margin-block: 1.6em;
		line-height: 1.5;
		border: 1px solid var(--line-deep);
	}
	.prose :global(th),
	.prose :global(td) {
		border: 1px solid var(--line);
		padding: 10px var(--sp-sm);
		text-align: left;
		vertical-align: top;
	}
	.prose :global(thead th) {
		background: var(--ground-zone);
		font-family: var(--font-sans);
		font-weight: 600;
		color: var(--petrol-deep);
	}
	.prose :global(td) {
		font-variant-numeric: tabular-nums;
	}
	/* Thematic break: a quiet hairline pause, same measure as the text. */
	.prose :global(hr) {
		border: 0;
		border-top: 1px solid var(--line-deep);
		margin-block: 2.4em;
		margin-inline: auto;
		width: min(100%, var(--measure));
		max-width: var(--measure);
	}
	/* "Eine Ebene tiefer" excursions — an optional side room off the main
	   reading path, framed as a quiet card. */
	.prose :global(details) {
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		padding: var(--sp-sm) var(--sp-md);
		margin-block: 1.6em;
	}
	.prose :global(details[open]) {
		border-color: var(--petrol-deep);
	}
	.prose :global(summary) {
		cursor: pointer;
		font-weight: 600;
		color: var(--petrol-deep);
	}
	.prose :global(summary:hover) {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.prose :global(details[open] summary) {
		margin-bottom: 0.75em;
	}
	.prose :global(details p:last-child) {
		margin-bottom: 0;
	}

	/* ——— Section-end mark ——— */
	.art-mark {
		display: flex;
		justify-content: center;
		margin: var(--sp-xl) auto var(--sp-lg);
	}
	.art-mark svg {
		width: 64px;
		height: 64px;
	}

	/* ——— Honest outro ———
	   Full shell width: its framed edges meet the nav/footer edges, closing
	   the page on the same structural line the chrome established. */
	.outro {
		background: var(--ground-zone);
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-xl);
		padding: var(--sp-lg);
	}
	.outro-text {
		margin: var(--sp-sm) 0 var(--sp-md);
		font-size: 1.125rem;
		line-height: 1.6;
		max-width: var(--measure);
	}
	.outro-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-sm);
	}

	/* ——— Amber reading-progress hairline (scroll-driven, native only) ———
	   The single amber attention moment on an article page: a 3px position
	   marker under the sticky nav, driven by the article's own view timeline.
	   Hidden entirely without support or with reduced motion — it is an
	   enhancement, not chrome the page depends on. */
	.article {
		view-timeline: --art block;
	}
	.read-progress {
		display: none;
		position: fixed;
		top: var(--nav-h);
		left: 0;
		right: 0;
		height: 3px;
		background: var(--amber-viv);
		transform-origin: 0 50%;
		transform: scaleX(0);
		z-index: 40;
		pointer-events: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		@supports (timeline-scope: --art) and (animation-timeline: --art) {
			.read-progress {
				display: block;
				animation: rp-grow 1ms linear both;
				animation-timeline: --art;
				animation-range: contain 0% contain 100%;
			}
		}
	}
	@keyframes rp-grow {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* ——— Glossary entry: the lighter register ——— */
	.gloss {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		margin-top: var(--sp-xl);
	}
	.gloss-badge {
		margin-bottom: var(--sp-sm);
	}
	.gloss-title {
		font-size: 1.75rem;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	.gloss-head {
		padding-bottom: var(--sp-md);
		margin-bottom: var(--sp-md);
		border-bottom: 1px solid var(--line);
	}
	.gloss-rail {
		display: flex;
		flex-direction: column;
		gap: var(--sp-md);
		margin-bottom: var(--sp-lg);
	}
	.gloss-def {
		background: var(--ground-zone);
		border: 1px solid var(--petrol-deep);
		border-radius: var(--r-lg);
		padding: var(--sp-md);
	}
	.gloss-def-label {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		line-height: 1.4;
		text-transform: uppercase;
		color: var(--petrol-deep);
		margin-bottom: var(--sp-xs);
	}
	.gloss-def-text {
		font-size: 1.25rem;
		line-height: 1.55;
	}
	.gloss-meta,
	.gloss-back {
		font-size: 1rem;
	}
	.gloss-meta a {
		font-weight: 500;
	}

	/* ——— Wide layout: sticky rail + prose column together span the FULL
	   elastic shell, so the article's structural right edge lines up with the
	   nav/footer edge on every viewport. Only the running text inside the
	   prose column is capped at the local reading measure. ——— */
	@media (min-width: 1100px) {
		.article,
		.gloss {
			grid-template-columns: clamp(220px, 17vw, 310px) minmax(0, 1fr);
			column-gap: clamp(40px, 4.5vw, 96px);
		}
		/* Everything except the rail (header, prose, quiz) lives in the content
		   track — explicit, so auto-placement can never drop the quiz into the
		   rail column. */
		.article > :global(*) {
			grid-column: 2;
		}
		.art-head {
			width: min(100%, var(--measure));
			justify-self: center;
		}
		.gloss-head {
			grid-column: 1 / -1;
		}
		/* The rail rises beside the header (row 1) instead of starting below
		   it — the meta/TOC answers the title immediately and the former
		   empty corner under the breadcrumb disappears. */
		.art-rail {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.prose {
			grid-column: 2;
			width: 100%;
		}
		.rail-box {
			position: sticky;
			top: calc(var(--nav-h) + var(--sp-lg));
			/* Optical alignment: the rail's first line sits on the header's
			   eyebrow line, not the border box edge. */
			padding-top: 6px;
		}
		.gloss-rail {
			margin-bottom: 0;
			align-self: start;
			position: sticky;
			top: calc(var(--nav-h) + var(--sp-lg));
		}
	}

	/* ——— Entrance: the header arrives in reading order (homepage motion
	   language); the prose itself never waits — final state is the base. ——— */
	@media (prefers-reduced-motion: no-preference) {
		.crumbs,
		.art-head,
		.art-rail,
		.gloss-head,
		.gloss-rail {
			animation: entry-rise 0.55s cubic-bezier(0.2, 0.6, 0.2, 1) both;
		}
		.art-head,
		.gloss-rail {
			animation-delay: 0.12s;
		}
		/* The rail follows the header it now sits beside — same rise, one
		   beat later, so the page assembles in reading order. */
		.art-rail {
			animation-delay: 0.2s;
		}
		@keyframes entry-rise {
			from {
				transform: translateY(12px);
			}
		}
		/* "Eine Ebene tiefer" excursions unfold instead of popping open —
		   supported browsers only; elsewhere details toggles as before. */
		@supports (interpolate-size: allow-keywords) {
			.prose :global(details) {
				interpolate-size: allow-keywords;
			}
			.prose :global(details::details-content) {
				block-size: 0;
				overflow-y: clip;
				transition:
					content-visibility 0.3s allow-discrete,
					block-size 0.3s cubic-bezier(0.2, 0.6, 0.2, 1);
			}
			.prose :global(details[open]::details-content) {
				block-size: auto;
			}
		}
	}

	@media (max-width: 720px) {
		.entry-scope {
			padding-top: var(--sp-md);
			padding-bottom: var(--sp-2xl);
		}
		.article,
		.gloss {
			margin-top: var(--sp-lg);
		}
		.outro {
			padding: var(--sp-md);
		}
		.prose :global(img),
		.prose :global(svg) {
			margin-block: var(--sp-xl);
			padding: 12px;
			border-radius: var(--r-lg);
		}
	}

	/* ——— Print: the lesson text only, none of the reading-app chrome.
	   Nav/Footer/quiz/feedback/star-CTA hide themselves (see their own
	   components); this layout drops its own navigational furniture --
	   breadcrumb, progress hairline, sticky rail, section-end mark and the
	   "what's next" outro. `.article` reverts to plain block flow rather
	   than staying a grid: the wide-layout rule places every child in
	   column 2 explicitly (`.article > :global(*) { grid-column: 2 }`,
	   above), so a single-track override alone still leaves that explicit
	   placement in effect, which forces the browser to fabricate an
	   implicit second column and squeezes the real one to 0 width. Block
	   flow sidesteps that entirely -- children just stack. ——— */
	@media print {
		.read-progress,
		.crumbs,
		.art-rail,
		.art-mark,
		.outro {
			display: none;
		}
		.article {
			display: block;
		}
	}
</style>

---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const ROUTE_SEGMENTS = {
	bausteine: { de: 'bausteine', en: 'lessons' },
	glossar: { de: 'glossar', en: 'glossary' },
} as const;

interface Props {
	entry: CollectionEntry<'bausteine'> | CollectionEntry<'glossar'>;
	collection: keyof typeof ROUTE_SEGMENTS;
	lang: 'de' | 'en';
}

const { entry, collection, lang } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';

const otherLangEntries = await getCollection(collection, (e) =>
	e.id.startsWith(`${otherLang}/`),
);
const counterpart = otherLangEntries.find(
	(e) => e.data.translationKey === entry.data.translationKey,
);
const counterpartHref = counterpart
	? `/${otherLang}/${ROUTE_SEGMENTS[collection][otherLang]}/${counterpart.id.slice(otherLang.length + 1)}`
	: undefined;

const counterpartLabel = otherLang === 'de' ? 'Auf Deutsch lesen' : 'Read in English';
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={entry.data.description} />
		{counterpartHref && <link rel="alternate" hreflang={otherLang} href={counterpartHref} />}
		<title>{entry.data.title} — KI einfach verstehen</title>
	</head>
	<body>
		<article>
			<h1>{entry.data.title}</h1>
			<slot />
		</article>
		{collection === 'bausteine' && <div data-read-sentinel data-tk={entry.data.translationKey}></div>}
		{counterpartHref && (
			<p><a href={counterpartHref}>{counterpartLabel}</a></p>
		)}
		<script>
			// Reading-progress source of truth: a Baustein counts as read once
			// the reader actually reaches its end (sentinel below the article),
			// not on page load. Keyed by translationKey — see progress.js.
			import { markRead } from '../scripts/progress.js';

			const sentinel = document.querySelector('[data-read-sentinel]');
			const tk = sentinel?.getAttribute('data-tk');
			if (sentinel && tk && 'IntersectionObserver' in window) {
				const observer = new IntersectionObserver((entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						markRead(tk);
						observer.disconnect();
					}
				});
				observer.observe(sentinel);
			}
		</script>
	</body>
</html>

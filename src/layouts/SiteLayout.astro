---
// Homepage shell: PageShell plus the homepage-specific nav wiring — the CTA
// points at the first actually readable Baustein (falls back to the overview
// anchor while nothing is published — never a dead link), and the
// "Themenbereiche" links stay local anchors.
import PageShell from './PageShell.astro';
import { getPublished } from '../data/published';
import { homeGraph } from '../lib/structured-data';

interface Props {
	lang: 'de' | 'en';
	title: string;
	description: string;
}

const { lang, title, description } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const otherLangHref = `/${otherLang}/`;

const published = await getPublished(lang);
const firstHref = published[0]?.href ?? '#themenbereiche';
---

<PageShell lang={lang} title={title} description={description} otherLangHref={otherLangHref} ctaHref={firstHref} jsonLd={homeGraph(Astro.site!, lang)} firstVisitHint={false}>
	<slot />
</PageShell>

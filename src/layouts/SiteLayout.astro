---
// Shared shell for the localized homepage(s): fonts, tokens, meta, skip
// link, Nav and Footer. Long-form content pages keep their own leaner
// layout (ContentEntryLayout) — this one carries the full brand chrome.
import '@fontsource/literata/700.css';
import '@fontsource/literata/800.css';
import '@fontsource/literata/600-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getPublished } from '../data/published';

interface Props {
	lang: 'de' | 'en';
	title: string;
	description: string;
}

const { lang, title, description } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const otherLangHref = `/${otherLang}/`;
const homeHref = `/${lang}/`;

// Nav CTA points at the first actually readable Baustein (falls back to the
// overview anchor while nothing is published — never a dead link).
const published = await getPublished(lang);
const firstHref = published[0]?.href ?? '#themenbereiche';

const skipLabel = lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content';
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		{/* Real Bildmarke (small cut) — SVG plus the official raster exports. */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
		<link rel="alternate" hreflang={otherLang} href={otherLangHref} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">{skipLabel}</a>
		<Nav lang={lang} otherLangHref={otherLangHref} homeHref={homeHref} ctaHref={firstHref} />
		<main id="main">
			<slot />
		</main>
		<Footer lang={lang} otherLangHref={otherLangHref} />
	</body>
</html>

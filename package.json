{
  "name": "@ki-einfach-verstehen/website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/sitemap-finalize.mjs dist",
    "lint": "node scripts/check-content-links.mjs && node scripts/check-web-only-content.mjs && node scripts/export-lessons.mjs --check && node --test scripts/*.test.mjs scripts/graphics/*.test.mjs src/scripts/*.test.mjs src/scripts/demos/*.test.mjs src/lib/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-content-links.mjs",
    "check:web-only": "node scripts/check-web-only-content.mjs",
    "gen:graphics": "node scripts/graphics/gen-graphics.mjs",
    "gen:lessons": "node scripts/export-lessons.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "astro": "7.2.1"
  },
  "devDependencies": {
    "satori": "^0.33.3",
    "yaml": "^2.9.1"
  }
}
